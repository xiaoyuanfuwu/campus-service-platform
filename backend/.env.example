# ============ 后端环境变量模板 ============
# 用法：cp .env.example .env  然后把下面的占位符换成你的真实值
# ⚠️ 变量名务必与代码一致：数据库相关必须用 MYSQL_*（代码 src/config/db.js 读取的就是这几个）

# 服务端口（与 Nginx 反代 / 微信 request 合法域名保持一致）
PORT=3000

# JWT 密钥（生产环境务必改成随机长串：openssl rand -hex 32）
JWT_SECRET=change_me_to_a_random_long_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 默认学校名称（显示在登录页、空状态等）
DEFAULT_SCHOOL=示例大学

# 初始信用分
INITIAL_CREDIT=100

# 信用分规则
JOIN_CREDIT_BONUS=2
PUBLISH_CREDIT_BONUS=5
POSITIVE_REVIEW_CREDIT=3
NEGATIVE_REVIEW_CREDIT=-5
NO_SHOW_CREDIT=-10

# 微信小程序配置（在微信公众平台 -> 开发管理 -> 开发设置 获取）
WECHAT_APPID=change_me_to_your_wechat_appid
WECHAT_SECRET=change_me_to_your_wechat_secret
# 微信 H5 网页授权 AppID（可选，不填则回退到上面的小程序 AppID）
# WECHAT_H5_APPID=

# ============ MySQL 配置 ============
# 数据库名必须与 install.sql 建出的库名一致（默认 campus_service）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me_to_a_database_password
MYSQL_DATABASE=campus_service

# 文件上传
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# 短信服务商：mock(不发真实短信，本地开发用) / aliyun / tencent
SMS_PROVIDER=mock

# 树洞管理后台密码（部署前请设置强密码）
TREEHOLE_ADMIN_PASSWORD=please_change_me_to_a_strong_password

# 运行环境：production（生产） / development（开发，会打印访问日志）
NODE_ENV=production
