/* custom-tab-bar/index.wxss — 极简 tab-bar（图片图标 + 冒泡泡动画） */

.tab-bar-wrap {
  position: fixed;
  bottom: 60rpx; left: 0; right: 0;
  z-index: 999;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.tab-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 73.6%;
  height: 110rpx;
  background: #FFFFFF;
  border-radius: 55rpx;
  margin: 0 auto;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,.10);
  border: 1rpx solid rgba(255,255,255,.7);
  pointer-events: auto;
}
/* Tab 项 */
.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 4rpx;
  height: 100%;
  position: relative;
}

/* 文字：默认灰色，选中变橙 */
.tab-label {
  font-size: 22rpx;
  color: #999;
  line-height: 1;
}
.tab-item.active .tab-label {
  color: #FF9500;
  font-weight: 700;
}

/* 图标图片 */
.tab-icon {
  width: 45rpx;
  height: 45rpx;
  flex-shrink: 0;
}

/* ========== 切换动画：图标弹跳 + 冒泡泡 ========== */

/* 图标弹跳放大 */
.icon-pop {
  animation: iconBounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes iconBounce {
  0%   { transform: scale(1); }
  30%  { transform: scale(1.35) translateY(-6rpx); }
  55%  { transform: scale(0.92) translateY(2rpx); }
  75%  { transform: scale(1.08) translateY(-2rpx); }
  100% { transform: scale(1); }
}

/* 气泡组 */
.bubble-group {
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 60rpx;
  pointer-events: none;
  z-index: 3;
}

/* 单个气泡 */
.bubble {
  position: absolute;
  bottom: 10rpx;
  border-radius: 50%;
  background: rgba(255, 149, 0, 0.5);
  border: 1.5rpx solid rgba(255, 149, 0, 0.8);
  opacity: 0;
}

/* 气泡1：偏左，大一点 */
.b1 {
  left: 8rpx;
  width: 12rpx; height: 12rpx;
  animation: bubbleUp 0.6s ease-out 0s forwards;
}
/* 气泡2：中间，小一点，晚出 */
.b2 {
  left: 24rpx;
  width: 8rpx; height: 8rpx;
  animation: bubbleUp 0.55s ease-out 0.08s forwards;
}
/* 气泡3：偏右，最小，最晚出 */
.b3 {
  left: 38rpx;
  width: 6rpx; height: 6rpx;
  animation: bubbleUp 0.5s ease-out 0.15s forwards;
}

@keyframes bubbleUp {
  0% {
    transform: translateY(0) scale(0.4);
    opacity: 0;
  }
  20% {
    opacity: 1;
    transform: translateY(-8rpx) scale(1);
  }
  100% {
    transform: translateY(-40rpx) scale(0.6);
    opacity: 0;
  }
}

/* 未读红点 */
.tab-badge {
  position: absolute;
  top: 4rpx; right: 20rpx;
  min-width: 30rpx; height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 18rpx;
  color: #fff;
  background: #FF3B30;
  border-radius: 999rpx;
  padding: 0 6rpx;
  z-index: 2;
}

/* ========== 发布按钮：圆形主题色 + 加号（tabbar 内垂直居中） ========== */
.tab-publish {
  position: relative;
}
.publish-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  border: 5rpx solid #fff;
  box-shadow: 0 8rpx 22rpx rgba(255,149,0,0.4), inset 0 -4rpx 8rpx rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
/* 白色加号（两条线交叉） */
.plus-h,
.plus-v {
  position: absolute;
  background: #fff;
  border-radius: 4rpx;
}
.plus-h {
  width: 36rpx;
  height: 7rpx;
}
.plus-v {
  width: 7rpx;
  height: 36rpx;
}
/* 点击弹跳（保持 translate 居中，动画里必须带） */
.publish-pop {
  animation: publishPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes publishPop {
  0%   { transform: translate(-50%, -50%) scale(1); }
  30%  { transform: translate(-50%, -50%) scale(1.18) translateY(-6rpx); }
  55%  { transform: translate(-50%, -50%) scale(0.94) translateY(2rpx); }
  75%  { transform: translate(-50%, -50%) scale(1.06) translateY(-2rpx); }
  100% { transform: translate(-50%, -50%) scale(1); }
}
/* 选中态：外发光光圈 */
.tab-publish.active .publish-btn {
  box-shadow: 0 8rpx 22rpx rgba(255,149,0,0.4), 0 0 0 10rpx rgba(255,149,0,0.15), inset 0 -4rpx 8rpx rgba(0,0,0,0.08);
}
