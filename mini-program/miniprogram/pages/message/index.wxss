/* pages/message/index.wxss */

/* ===== 顶部栏 ===== */
.msg-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}
.msg-top-bar {
  position: fixed;
  top: 0;
  z-index: 100;
  background: transparent;
  left: 0; right: 0;
}
.msg-top-bar-spacer {}
.msg-top-bar .top-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
}
.msg-top-bar .brand-logo {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.msg-top-bar .brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

/* 顶部小鸭图标（纯 CSS） */
.msg-top-bar .top-duck-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.msg-top-bar .td-head {
  position: absolute; top: 4rpx; left: 6rpx;
  width: 22rpx; height: 22rpx;
  background: #FFC54A;
  border-radius: 50%;
}
.msg-top-bar .td-eye {
  position: absolute; top: 12rpx; left: 18rpx;
  width: 4rpx; height: 4rpx;
  background: #333;
  border-radius: 50%;
}
.msg-top-bar .td-beak {
  position: absolute; top: 18rpx; left: 24rpx;
  width: 8rpx; height: 5rpx;
  background: #FF9500;
  border-radius: 0 4rpx 4rpx 0;
}
.msg-top-bar .td-body {
  position: absolute; bottom: 0; left: 4rpx;
  width: 28rpx; height: 18rpx;
  background: #FFFFFF;
  border-radius: 14rpx 14rpx 12rpx 12rpx;
  border: 2rpx solid #FFC54A;
  box-sizing: border-box;
}
.msg-top-bar .td-wing {
  position: absolute; bottom: 6rpx; left: 14rpx;
  width: 12rpx; height: 8rpx;
  background: #FFE0A0;
  border-radius: 6rpx;
}
.msg-top-bar .td-tail {
  position: absolute; bottom: 8rpx; left: 0;
  width: 6rpx; height: 6rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFC54A;
  border-radius: 50%;
  box-sizing: border-box;
}

/* ===== 新消息横幅 ===== */
.new-msg-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
  margin: 16rpx 0 0;
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  border: 1rpx solid #FFCC80;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #E65100;
  font-weight: 600;
  animation: bannerSlideIn .35s ease;
}
.new-msg-bell {
  font-size: 28rpx;
}
@keyframes bannerSlideIn {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.page-message {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page-scroll {
  position: fixed;
  top: 0;  /* overridden by inline style */
  left: 0; right: 0; bottom: 0;
}
.page-content { padding: 0 24rpx 24rpx; }

.refresh-hint {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-hint);
  padding: 16rpx 0 8rpx;
}

/* 分类入口 */
.msg-categories {
  margin-top: 30rpx;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,.04);
  position: relative;
  z-index: 1;
}
.msg-cat-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(0,0,0,.04);
}
.msg-cat-item:last-child { border-bottom: none; }
.cat-icon {
  width: 72rpx; height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.cat-icon-system { background: #FFF3E0; }
.cat-icon-chat { background: #FFF8E1; }

/* 图标 */
.ci-bell {
  width: 32rpx; height: 36rpx;
  border: 3rpx solid #FF9500;
  border-radius: 8rpx 8rpx 0 0;
  position: relative;
}
.ci-bell::after {
  content: '';
  width: 10rpx; height: 10rpx;
  background: #FF9500;
  border-radius: 50%;
  position: absolute; bottom: -6rpx; left: 50%;
  transform: translateX(-50%);
}
.ci-bubble {
  width: 34rpx; height: 28rpx;
  background: #FF9800;
  border-radius: 8rpx;
  position: relative;
}
.ci-bubble::after {
  content: '';
  width: 0; height: 0;
  border-top: 8rpx solid #FF9800;
  border-right: 8rpx solid transparent;
  position: absolute; bottom: -6rpx; left: 6rpx;
}
.cat-info { flex: 1; }
.cat-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); display: block; }
.cat-desc { font-size: 24rpx; color: var(--text-hint); margin-top: 4rpx; display: block; }
.cat-badge {
  background: #F44336;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  margin-right: 8rpx;
  min-width: 32rpx;
  text-align: center;
}
.cat-arrow { font-size: 36rpx; color: var(--text-hint); }

/* 最近消息 */
.recent-section { margin-top: 32rpx; }
.section-header { margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.recent-item {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,.04);
}
.recent-avatar {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: rgba(0,0,0,.06);
  flex-shrink: 0;
}
.recent-avatar-text {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: rgba(255,149,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.recent-avatar-char {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF9500;
}
.recent-info { flex: 1; min-width: 0; }
.recent-name { font-size: 28rpx; color: var(--text-primary); display: block; }
.recent-preview {
  font-size: 24rpx; color: var(--text-hint);
  display: block; margin-top: 4rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.recent-time { font-size: 22rpx; color: var(--text-hint); }

.recent-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}
.recent-badge {
  background: #F44336;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
  font-weight: 600;
}

.empty-state { text-align: center; padding: 120rpx 0; }
.empty-icon {
  width: 120rpx; height: 120rpx; margin: 0 auto 24rpx;
  display: flex; align-items: center; justify-content: center;
}
.ei-bubble {
  width: 88rpx; height: 62rpx;
  border-radius: 24rpx;
  border: 4rpx solid #D1D1D6;
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  position: relative;
}
.ei-bubble::after {
  content: '';
  position: absolute; bottom: -12rpx; left: 14rpx;
  width: 0; height: 0;
  border-top: 14rpx solid #D1D1D6;
  border-right: 14rpx solid transparent;
}
.ei-dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: #D1D1D6;
}
.empty-text { font-size: 28rpx; color: var(--text-hint); }
.tap-shrink:active { transform: scale(.96); }

/* ===== 折叠/展开按钮 ===== */
.msg-toggle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  margin-top: 4rpx;
  border-radius: 20rpx;
  background: rgba(255,149,0,0.08);
  border: 1rpx solid rgba(255,149,0,0.15);
}
.msg-toggle-text {
  font-size: 26rpx;
  color: #FF9500;
  font-weight: 500;
}
.msg-toggle-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  transition: transform .25s ease;
}
.arrow-down {
  border-top: 10rpx solid #FF9500;
}
.arrow-up {
  border-bottom: 10rpx solid #FF9500;
}

/* 长按提示 */
.recent-item:active {
  background: rgba(255,255,255,0.7);
}

.msg-bottom-safe { height: 200rpx; }

.empty-login-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 16rpx 56rpx;
  background: linear-gradient(135deg, #FF9500, #FF7A00);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,149,0,0.3);
}

.empty-login-btn:active {
  transform: scale(0.97);
}
