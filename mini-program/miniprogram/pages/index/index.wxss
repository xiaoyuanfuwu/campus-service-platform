}
.hc-bowl-meat-2 {
  top: 16rpx;
  right: 52rpx;
  background: #B91C1C;
}
.hc-bowl-egg {
  position: absolute;
  top: 6rpx;
  right: 42rpx;
  width: 20rpx;
  height: 20rpx;
  background: radial-gradient(circle, #FEF3C7 40%, #FBBF24 40%);
  border-radius: 50%;
