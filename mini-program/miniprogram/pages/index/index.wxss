  transform: rotate(30deg);
}

/* ===== 底部安全区 ===== */
.bottom-safe {
  height: calc(140rpx + constant(safe-area-inset-bottom));
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* ===== 搜索弹窗 ===== */
.search-overlay {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0,0,0,.45);
  display: flex;
  flex-direction: column;
}
.search-modal {
  background: #FFFFFF;
  border-radius: 0 0 32rpx 32rpx;
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}
.search-modal-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 20rpx;
}
.search-modal-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F2F2F7;
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  gap: 12rpx;
}
.smi-icon {
  width: 32rpx; height: 32rpx;
  position: relative;
  flex-shrink: 0;
}
.search-modal-input {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1E;
}
.sm-placeholder {
  color: #C7C7CC;
}
.search-modal-cancel {
  font-size: 28rpx;
  color: #FF9500;
  font-weight: 500;
  padding: 12rpx;
  flex-shrink: 0;
}

.search-modal-body {
  flex: 1;
  padding: 0 24rpx 40rpx;
  min-height: 200rpx;
}
.search-modal-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #8E8E93;
  font-size: 28rpx;
}

.sr-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}
.sr-item-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.sr-tag-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
}
.sr-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.sr-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sr-item-desc {
  font-size: 22rpx;
  color: #8E8E93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sr-item-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
  flex-shrink: 0;
}
.search-modal-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  color: #8E8E93;
  font-size: 28rpx;
}

/* ===== 骨架屏 ===== */
.skeleton-pulse { animation: skPulse 1.5s ease-in-out infinite; }
@keyframes skPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.skeleton-bar {
  background: var(--card-inner-bg);
  border-radius: 8rpx;
}
.skeleton-item { pointer-events: none; }

/* ===== 页面切换防抖 ===== */
.page-index {
  opacity: 0;
  animation: pageFadeIn .35s ease forwards;
  will-change: opacity;
}
@keyframes pageFadeIn { to { opacity: 1; } }

/* swiper 硬件加速防抖动 */
.hot-rec-swiper, .pb-swiper {
  will-change: transform;
  transform: translateZ(0);
}

/* ===== 大厅任务模块标签配色（大板块复用） ===== */
.hc-task-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 18rpx;
  color: #FF9500;
  background: #FFFFFF;
  border: 1rpx solid rgba(255,149,0,0.35);
  line-height: 1.4;
}
.hc-task-tag.express { color: #FF9500; border-color: rgba(255,149,0,0.35); }
.hc-task-tag.carpool { color: #FF7A00; border-color: rgba(255,122,0,0.35); }
.hc-task-tag.help { color: #FF3B30; border-color: rgba(255,59,48,0.35); }
.hc-task-tag.task { color: #5856D6; border-color: rgba(88,86,214,0.35); }
.hc-task-tag.lost { color: #34C759; border-color: rgba(52,199,89,0.35); }
.hc-task-tag.secondhand { color: #FF2D55; border-color: rgba(255,45,85,0.35); }
.hc-task-tag.rental { color: #007AFF; border-color: rgba(0,122,255,0.35); }
.hc-task-tag.substitute { color: #AF52DE; border-color: rgba(175,82,222,0.35); }
.hc-task-tag.print { color: #5AC8FA; border-color: rgba(90,200,250,0.5); }
.hc-task-tag.yellowpage { color: #B8860B; border-color: rgba(255,204,0,0.5); }
.hc-task-tag.bulletin { color: #8E8E93; border-color: rgba(142,142,147,0.35); }
.hc-task-tag.charity { color: #FF3B30; border-color: rgba(255,59,48,0.35); }

/* ===== 互助墙标签栏（sticky 吸顶，贴顶时只显示标签） ===== */
.tb-tabs {
  position: sticky;
  top: 0;   /* 相对 scroll-view 视口：贴其顶部 = top-bar 底部，无缝 */
  z-index: 90;
  margin-top: 18rpx;
  white-space: nowrap;
}
/* 贴顶状态：默认白底遮住滚动内容 */
.tb-tabs-stuck {
  background: #FFFFFF;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.06);
  padding: 10rpx 0;
}
/* 吸顶标签背景直接引用对应主题的背景渐变，与顶部无缝衔接 */
.theme-lavender .tb-tabs-stuck { background: linear-gradient(90deg, #B9A7D9 0%, #E8C8D8 100%); }
.theme-peach .tb-tabs-stuck    { background: linear-gradient(90deg, #F2C9AD 0%, #F8C6D0 100%); }
.theme-sage .tb-tabs-stuck     { background: linear-gradient(90deg, #99BBC8 0%, #B2D4C8 100%); }
.theme-mist .tb-tabs-stuck     { background: linear-gradient(90deg, #9FAFD8 0%, #C2B2D8 100%); }

/* 触底加载提示 */
.tb-load-more {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9A9AA0;
  padding: 16rpx 0 32rpx;
}

/* 一键回顶按钮 */
.back-top {
  position: fixed;
  right: 24rpx;
  bottom: 180rpx;
  z-index: 95;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--theme-strong, #FF9500); /* 最终颜色由 wxml 内联 style 覆盖 */
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.18);
  opacity: 0;
  transform: scale(0.6);
  transition: opacity .28s cubic-bezier(.4,0,.2,1), transform .28s cubic-bezier(.4,0,.2,1);
  pointer-events: none;
}
.back-top-show {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}
.back-top-arrow {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 700;
}
.back-top-text {
  font-size: 18rpx;
  line-height: 1.4;
  margin-top: 4rpx;
}


/* ===== 新生大厅引导弹窗 ===== */
.intro-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 999;
  background: rgba(17, 17, 17, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: intro-mask-in 0.25s ease-out both;
}
@keyframes intro-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
.intro-card {
  width: 600rpx;
  background: #fff;
  border-radius: 36rpx;
  overflow: hidden;
  position: relative;
  animation: intro-card-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
@keyframes intro-card-in {
  from { opacity: 0; transform: scale(0.82) translateY(40rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

/* 左上角关闭按钮 */
.intro-close {
  position: absolute;
  top: 20rpx; left: 20rpx;
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.intro-close-x {
  font-size: 30rpx;
  color: #fff;
  line-height: 1;
}

/* 头部渐变横幅 */
.intro-head {
  position: relative;
  height: 280rpx;
  background: linear-gradient(135deg, #FF9500 0%, #FFB347 60%, #FFC97A 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.intro-head-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}
.deco-1 { width: 200rpx; height: 200rpx; top: -70rpx; right: -50rpx; }
.deco-2 { width: 120rpx; height: 120rpx; bottom: -40rpx; left: -30rpx; }
.deco-3 { width: 56rpx; height: 56rpx; top: 40rpx; left: 120rpx; background: rgba(255, 255, 255, 0.2); }
.intro-head-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 90, 0, 0.28);
  margin-bottom: 18rpx;
}
.intro-head-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(180, 90, 0, 0.3);
}
.intro-head-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 1rpx;
}

/* 介绍内容 */
.intro-body {
  padding: 32rpx 40rpx 8rpx;
}
.intro-desc {
  display: block;
  font-size: 27rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 26rpx;
}
.intro-feature {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.intro-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9500, #FFB347);
  flex-shrink: 0;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(255, 149, 0, 0.4);
}
.intro-feature-text {
  font-size: 26rpx;
  color: #444;
}

/* 去看看按钮 */
.intro-btn {
  margin: 20rpx 60rpx 44rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF9500, #FFB347);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 10rpx 28rpx rgba(255, 149, 0, 0.4);
}
.intro-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}
.intro-btn-arrow {
  font-size: 40rpx;
  color: #fff;
  line-height: 1;
  margin-top: -4rpx;
}

/* ===== 互助墙等级徽标（LV 小方块，白底彩字） ===== */
.tb-post-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.tb-post-lv {
  flex-shrink: 0;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #fff;
  border: 1rpx solid rgba(255, 149, 0, 0.45);
  color: #FF9500;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 28rpx;
  letter-spacing: 1rpx;
}
.tb-post-lv-red {
  border-color: rgba(255, 59, 48, 0.5);
  color: #FF3B30;
}

/* ===== 校园互助墙灰阶视觉 =====
 * LV 等级徽标保留原有彩色，其余文字、标签与互动状态统一使用黑白灰。
 */
.task-board .tb-more { color: #636366; }
.task-board .tb-tab-active {
  color: #1C1C1E;
  background: #EDEDEF;
  border-color: #D1D1D6;
}
.task-board .tb-post { box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06); }
.task-board .tb-post-depart,
.task-board .tb-post-status,
.task-board .tb-status-done,
.task-board .tb-status-full,
.task-board .tb-status-open {
  color: #515154;
  background: #EFEFF1;
}
.task-board .tb-post-code-label,
.task-board .tb-post-size {
  color: #636366;
  background: #F0F0F2;
}
.task-board .tb-post-code { color: #3A3A3C; }
.task-board .tb-post-content { color: #1C1C1E; }
