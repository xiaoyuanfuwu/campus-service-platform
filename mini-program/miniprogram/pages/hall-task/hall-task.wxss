/* pages/hall-task/hall-task.wxss */
page {
  background: #F5F5F7;
}
.page-module {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page, #F5F5F7);
  position: relative;
}
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}
/* 右侧帖子图标：圆角便签 + 两行内容 + 彩色圆点 */
.post-brand-icon {
  width: 44rpx;
  height: 44rpx;
}
.post-brand-sheet {
  position: absolute;
  left: 4rpx;
  top: 2rpx;
  width: 34rpx;
  height: 38rpx;
  border-radius: 9rpx;
  background: linear-gradient(145deg, #FFB347, #FF7A00);
  box-shadow: 0 4rpx 8rpx rgba(255, 122, 0, .22);
  transform: rotate(-6deg);
}
.post-brand-line {
  position: absolute;
  left: 13rpx;
  width: 17rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #FFFFFF;
  z-index: 2;
}
.post-brand-line-1 { top: 15rpx; }
.post-brand-line-2 { top: 24rpx; width: 12rpx; }
.post-brand-dot {
  position: absolute;
  right: 1rpx;
  bottom: 1rpx;
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  background: #34C759;
  border: 3rpx solid #FFFFFF;
  z-index: 3;
}
.shared-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: transparent;
}
.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 24rpx;
}
.nav-back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #1C1C1E;
  border-bottom: 4rpx solid #1C1C1E;
  transform: rotate(45deg);
  margin-left: 6rpx;
}
.nav-brand {
  position: relative;
  display: flex;
  align-items: center;
}
.brand-logo {
  position: absolute;
  right: calc(100% + 12rpx);
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  line-height: 1;
}
.brand-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #FF9500;
  letter-spacing: 2rpx;
}
.bell-icon { width: 40rpx; height: 40rpx; position: relative; }
.bell-top {
  position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: 28rpx; height: 28rpx;
  border: 4rpx solid #1C1C1E;
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
}
.bell-bottom {
  position: absolute; bottom: 4rpx; left: 50%; transform: translateX(-50%);
  width: 36rpx; height: 4rpx;
  background: #1C1C1E;
  border-radius: 2rpx;
}
.bell-red-dot {
  position: absolute; top: 0; right: 0;
  width: 16rpx; height: 16rpx;
  background: #FF3B30;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

/* 分类筛选：始终单行展示，六个标签均分宽度，间距随屏幕自适应 */
.hall-filter {
  position: relative;
  z-index: 10;
  box-sizing: border-box;
  width: 100%;
  padding: 16rpx 30rpx;
  background: transparent;
  white-space: nowrap;
}
.hall-filter-inner {
  box-sizing: border-box;
  width: 100%;
  display: flex;
  flex-wrap: nowrap;
  justify-content: flex-start;
  align-items: center;
  gap: 0;
}
.hall-chip {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  padding: 10rpx 14rpx;
  margin: 0 15rpx 0 0;
  border-radius: 32rpx;
  font-size: 22rpx;
  background: rgba(255,255,255,0.7);
  color: #1C1C1E;
  border: 2rpx solid transparent;
  white-space: nowrap;
}
.hall-chip.active {
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  color: #fff;
  border-color: rgba(255,149,0,0.3);
  box-shadow: 0 4rpx 12rpx rgba(255,149,0,0.25);
}

/* 搜索 */
.hall-search {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx 16rpx;
  background: transparent;
}
.hall-search-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
}
.hall-search-btn {
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  color: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 700;
}

/* 列表 */
.hall-scroll {
  flex: 1;
  height: 0;
  position: relative;
  z-index: 1;
}

/* 瀑布流（多列） */
.hall-grid {
  column-count: 2;
  column-gap: 16rpx;
  padding: 16rpx 20rpx;
}

.hall-card {
  position: relative;
  break-inside: avoid;
  background: #fff;
  border: 2rpx solid rgba(255, 149, 0, .18);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.05);
  margin-bottom: 16rpx;
}

/* 帖子状态角标：统一放在卡片右上角 */
.hall-card-status {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 5;
  box-sizing: border-box;
  max-width: calc(100% - 20rpx);
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #fff;
  box-shadow: 0 3rpx 10rpx rgba(0,0,0,.12);
}
.hall-card-status.active { background: #34C759; }
.hall-card-status.ended { background: #8E8E93; }

/* 封面图（有图时显示，16:9） */
.hall-card-cover {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
}
.hall-card-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}
.hall-card-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: #FF9500;
}
.hall-card-tag.express { background: #FF9500; }
.hall-card-tag.task { background: #5856D6; }
.hall-card-tag.lost { background: #34C759; }
.hall-card-tag.secondhand { background: #FF2D55; }
.hall-card-tag.rental { background: #007AFF; }
.hall-card-tag.bulletin { background: #8E8E93; }

/* 统一卡片：外框自适应，内嵌 4:3 封面图（顶部）+ 下方内容区 */
.hall-card--has-img {
  display: flex;
  flex-direction: column;
  position: relative;
}
.hall-card-imgbox {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: #fff;
  flex-shrink: 0;
}
.hall-card-imgbox .hall-card-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}
.hall-card-imgbox .hall-card-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
}
/* 时间+尺寸标签：左侧并排 */
.hall-card-band .express-footer-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.hall-card-band .express-cover-size {
  font-size: 20rpx;
  color: #FF9500;
  background: rgba(255,149,0,.12);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

/* 二手标签行：分类+类型横向排列，垂直居中 */
.hall-card-tags-row {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.hall-card-tags-row .hall-card-tag {
  position: static !important;
  top: auto !important;
  left: auto !important;
}
.hall-card-tags-row .secondhand-type-tag {
  position: static;
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.hall-card-tags-row .secondhand-type-tag.sell { background: #FF9500; color: #fff; }
.hall-card-tags-row .secondhand-type-tag.buy  { background: #34C759; color: #fff; }

/* 渐变内容带 */
.hall-card-band {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  padding: 16rpx 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 8rpx;
  color: #fff;
  overflow: hidden;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), inset 0 -2rpx 6rpx rgba(0,0,0,0.05);
}
/* 卡片底色统一白色（去花哨渐变） */
.hall-card-band.express,
.hall-card-band.lost,
.hall-card-band.secondhand,
.hall-card-band.rental,
.hall-card-band.task,
.hall-card-band.bulletin,
.hall-card-band.carpool { background: #fff; }

/* ===== 拼车卡片 ===== */
.hall-card-cover.carpool { background: #fff; }
.hall-card-tag.carpool { background: #007AFF; }

.carpool-route-col {
  position: absolute;
  top: 50%;
  left: 14rpx;
  transform: translateY(-50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.carpool-from, .carpool-to {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.carpool-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.carpool-dot-from { background: #007AFF; }
.carpool-dot-to { background: #34C759; }
.carpool-dash-line {
  width: 2rpx;
  height: 22rpx;
  margin-left: 5rpx;
  border-left: 2rpx dashed #90CAF9;
}
.carpool-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #1C1C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 240rpx;
}
.carpool-seats-badge {
  padding: 4rpx 14rpx;
  background: rgba(0,122,255,.15);
  color: #007AFF;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.carpool-bottom-row {
  position: absolute;
  bottom: 12rpx;
  left: 14rpx;
  right: 14rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hall-card-band .hall-card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hall-card-band .hall-lost-where {
  font-size: 22rpx;
  color: #636366;
}
.hall-card-band .hall-card-meta .hall-card-loc {
  font-size: 22rpx;
  color: #636366;
}
.hall-card-band .hall-card-quality {
  display: inline-flex;
  align-self: flex-start;
  padding: 2rpx 12rpx;
  background: rgba(255,255,255,.9);
  color: #FF2D55;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.hall-card-band .hall-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.hall-card-band .hall-card-time {
  font-size: 20rpx;
  color: #8E8E93;
}
.hall-card-band .hall-card-price {
  display: inline-flex;
  align-items: baseline;
  gap: 2rpx;
  background: rgba(255,255,255,.92);
  color: #FF9500;
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
}
.hall-card-band .hall-card-price .hall-yen {
  font-size: 20rpx;
  font-weight: 800;
  color: #FF9500;
}
.hall-card-band .hall-card-price .hall-price {
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
  color: #FF9500;
}
.hall-card-band .hall-price-negotiable {
  background: rgba(255,255,255,.92);
  color: #007AFF;
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
}

/* 路由在 band 内：直接显示在彩色底层上 */
.hall-card-band .express-route-col {
  display: flex;
  flex-direction: column;
  gap: 0;
  align-self: flex-start;
  max-width: 100%;
}
.hall-card-band .express-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #333;
  text-shadow: none;
}
.hall-card-band .express-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.hall-card-band .express-dot-from { background: #FF9500; }
.hall-card-band .express-dot-to { background: #34C759; }
.hall-card-band .express-line {
  width: 2rpx;
  height: 22rpx;
  background: #FFCC80;
  margin-left: 5rpx;
  border-radius: 2rpx;
}
.hall-card-band .express-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 15rpx;
}
/* 无图卡片：整张 4:3 渐变 + 浮层 */
.hall-card-cover {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  background-color: #fff;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), inset 0 -2rpx 8rpx rgba(0,0,0,0.06);
}
.hall-card-cover.express,
.hall-card-cover.lost,
.hall-card-cover.secondhand,
.hall-card-cover.rental,
.hall-card-cover.task,
.hall-card-cover.bulletin { background: #fff; }
.hall-card-cover-mask {
  display: none;
}
.hall-card-cover .hall-card-tag {
  z-index: 2;
}
.hall-card-cover .hall-card-body {
  position: relative;
  z-index: 2;
  padding: 12rpx 14rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.hall-card-cover .hall-card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hall-card-cover .hall-lost-where {
  font-size: 22rpx;
  color: #636366;
}
.hall-card-cover .hall-card-meta .hall-card-loc {
  font-size: 22rpx;
  color: #636366;
}
.hall-card-cover .hall-card-quality {
  display: inline-flex;
  align-self: flex-start;
  padding: 2rpx 12rpx;
  background: rgba(255,255,255,.9);
  color: #FF2D55;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.hall-card-cover .hall-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.hall-card-cover .hall-card-time {
  font-size: 20rpx;
  color: #8E8E93;
}
.hall-card-cover .hall-card-price {
  display: inline-flex;
  align-items: baseline;
  gap: 2rpx;
  background: rgba(255,255,255,.92);
  color: #FF9500;
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
}
.hall-card-cover .hall-card-price .hall-yen {
  font-size: 20rpx;
  font-weight: 800;
  color: #FF9500;
}
.hall-card-cover .hall-card-price .hall-price {
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
  color: #FF9500;
}
.hall-card-cover .hall-price-negotiable {
  background: rgba(255,255,255,.92);
  color: #007AFF;
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
}

/* 价格角标（卡片底部右侧） */
.hall-card-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  flex-shrink: 0;
}
.hall-yen { font-size: 22rpx; font-weight: 800; color: #FF9500; }
.hall-price { font-size: 32rpx; font-weight: 900; color: #FF9500; line-height: 1; }
.hall-price-negotiable { font-size: 24rpx; color: #8E8E93; }

/* 统一价格文本 */
.hall-card-price-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #FF9500;
  white-space: nowrap;
}

/* 快递 4:3 封面撑满卡片（仅作历史样式保留，新结构用 hall-card-cover） */

/* 路线列：在 hall-card-cover 内（无图模式） */
.hall-card-cover .express-route-col {
  position: absolute;
  top: 75rpx;
  left: 14rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 10rpx 12rpx;
  background: rgba(255,255,255,.92);
  border-radius: 16rpx;
  width: auto;
  max-width: 75%;
}
.hall-card-cover .express-from,
.hall-card-cover .express-to {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.hall-card-cover .express-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow: none;
}
.hall-card-cover .express-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.hall-card-cover .express-dot-from { background: #FF9500; }
.hall-card-cover .express-dot-to { background: #34C759; }
.hall-card-cover .express-line {
  width: 2rpx;
  height: 22rpx;
  background: #FFCC80;
  margin-left: 5rpx;
  border-radius: 2rpx;
}

/* 大件小件：左下角浮层（无图 cover） */
.hall-card-cover .express-cover-size {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  padding: 4rpx 14rpx;
  background: rgba(255,255,255,.9);
  color: #FF9500;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  z-index: 2;
}

/* 底部栏：时间左、尺寸+价格右（无图 cover） */
.hall-card-cover .express-cover-footer {
  position: absolute;
  bottom: 12rpx;
  left: 14rpx;
  right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 2;
}
.hall-card-cover .express-cover-footer .express-footer-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.hall-card-cover .express-cover-footer .hall-card-time {
  font-size: 20rpx;
  color: #636366;
  text-shadow: none;
}
.hall-card-cover .express-cover-footer .express-cover-size {
  position: static;
  padding: 4rpx 14rpx;
  background: rgba(255,149,0,.15);
  color: #FF9500;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.hall-card-cover .express-cover-footer .express-cover-price {
  position: static;
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  color: #fff;
  border-radius: 16rpx;
  padding: 2rpx 12rpx;
}
.hall-card-cover .express-cover-footer .express-cover-price .hall-yen { font-size: 20rpx; font-weight: 800; color: #fff; }
.hall-card-cover .express-cover-footer .express-cover-price .hall-price { font-size: 26rpx; font-weight: 900; color: #fff; line-height: 1; }

/* express 封面价格文本 */
.express-price-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF9500;
  flex-shrink: 0;
}

/* 价格：右下角浮层（无图 cover） */
.hall-card-cover .express-cover-price {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  color: #fff;
  border-radius: 16rpx;
  padding: 2rpx 12rpx;
  z-index: 2;
}
.hall-card-cover .express-cover-price .hall-yen { font-size: 20rpx; font-weight: 800; color: #fff; }
.hall-card-cover .express-cover-price .hall-price { font-size: 26rpx; font-weight: 900; color: #fff; line-height: 1; }

/* 失物类型标签（寻物/拾到） */
.lost-type-tag {
  position: static;
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.lost-type-tag.find { background: #FF9500; color: #fff; }
.lost-type-tag.offer { background: #34C759; color: #fff; }

/* 短租类型标签（出租/求租） */
.rental-type-tag {
  position: static;
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.rental-type-tag.rent-out { background: #007AFF; color: #fff; }
.rental-type-tag.rent-in { background: #FF9500; color: #fff; }

/* 失物招领地点 */
.hall-lost-where {
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 6rpx;
}

/* 描述文本：超出截断 */
.hall-card-desc {
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.4;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 180rpx;
}
.hall-card-quality {
  display: inline-block;
  padding: 3rpx 12rpx;
  background: #F0F7FF;
  color: #007AFF;
  border-radius: 10rpx;
  font-size: 20rpx;
  margin-bottom: 8rpx;
}

/* 信息区 */
.hall-card-body {
  padding: 16rpx;
}
.hall-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
  line-height: 1.4;
  margin-bottom: 6rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hall-card-meta {
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 8rpx;
}
.hall-card-loc { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hall-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.hall-card-time { font-size: 20rpx; color: #C7C7CC; }

/* 加载/空 */
.loading-state { padding: 24rpx; }
.skeleton-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.sk-line {
  height: 24rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  animation: sk 1.4s ease infinite;
}
.sk-line.sk-long { width: 70%; }
.sk-line.sk-short { width: 40%; }
@keyframes sk {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.empty-state {
  padding: 80rpx 0;
  text-align: center;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #1C1C1E; display: block; margin-bottom: 8rpx; }
.empty-hint { font-size: 22rpx; color: #8E8E93; }
.loading-more {
  column-span: all;
  padding: 24rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #8E8E93;
}
.loading-more.end { color: #C7C7CC; }
.panel-bottom-space { height: 80rpx; }
