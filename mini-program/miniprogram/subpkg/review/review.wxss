/* pages/review/review.wxss */
.page-review { min-height: 100vh; background: transparent; }
.nav-bar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; background: var(--nav-bg); backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx); border-bottom: 1rpx solid var(--border-light); }
.nav-back { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.nav-back-icon { width: 24rpx; height: 24rpx; border-left: 4rpx solid var(--text-primary); border-bottom: 4rpx solid var(--text-primary); transform: rotate(45deg); margin-left: 8rpx; }
.nav-title { font-size: var(--font-lg); font-weight: 600; flex: 1; text-align: center; color: var(--text-primary); }
.nav-placeholder { width: 72rpx; flex-shrink: 0; }
.form-content { padding: 24rpx; }
.glass-card { background: var(--bg-card); border-radius: var(--radius-lg); padding: 32rpx; margin-bottom: 16rpx; border: 1rpx solid var(--border-light); }
.form-group { display: flex; flex-direction: column; gap: 16rpx; }
.form-label { font-size: var(--font-sm); color: var(--text-secondary); font-weight: 600; }
.star-row { display: flex; gap: 16rpx; }
.star { font-size: 56rpx; color: var(--border); }
.star.active { color: var(--warning); }
.star-line { width: 48rpx; height: 48rpx; position: relative; cursor: pointer; }
.star-line::before { content: ''; position: absolute; inset: 0; border: 3rpx solid var(--border); clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); transition: all 0.2s; }
.star-line.active::before { background: var(--warning); border-color: var(--warning); }
.picker { height: 80rpx; line-height: 80rpx; background: var(--bg-page); border-radius: var(--radius-md); padding: 0 24rpx; font-size: var(--font-md); color: var(--text-primary); }
.form-textarea { height: 200rpx; background: var(--bg-page); border-radius: var(--radius-md); padding: 20rpx 24rpx; font-size: var(--font-md); color: var(--text-primary); }
.tag-select { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tag-chip { padding: 12rpx 28rpx; border-radius: 999rpx; background: var(--bg-page); font-size: var(--font-sm); color: var(--text-secondary); border: 1rpx solid var(--border); }
.tag-chip.active { background: var(--primary-bg-strong); color: var(--primary); border-color: var(--primary); }
.btn-primary { text-align: center; padding: 28rpx; border-radius: 999rpx; background: var(--primary); color: #fff; font-size: var(--font-lg); font-weight: 600; margin: 32rpx 0; }
