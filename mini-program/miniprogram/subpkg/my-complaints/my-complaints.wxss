/* pages/my-complaints/my-complaints.wxss */
.page-my-complaints { min-height: 100vh; background: transparent; }
/* ===== 顶部栏（与"我的信息"一致的 profile-top-bar 风格） ===== */
.profile-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}
.profile-top-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: transparent;
}
.profile-top-bar .top-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
}
.profile-top-bar .nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.profile-top-bar .nav-back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #FF9500;
  border-bottom: 4rpx solid #FF9500;
  transform: rotate(45deg);
  margin-left: 8rpx;
}
.profile-top-bar .nav-placeholder {
  width: 72rpx;
  flex-shrink: 0;
}
.profile-top-bar .brand-logo {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.profile-top-bar .brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.profile-top-bar .top-duck-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.profile-top-bar .td-head {
  position: absolute; top: 4rpx; left: 6rpx;
  width: 22rpx; height: 22rpx;
  background: #FFC54A;
  border-radius: 50%;
}
.profile-top-bar .td-eye {
  position: absolute; top: 12rpx; left: 18rpx;
  width: 4rpx; height: 4rpx;
  background: #333;
  border-radius: 50%;
}
.profile-top-bar .td-beak {
  position: absolute; top: 18rpx; left: 24rpx;
  width: 8rpx; height: 5rpx;
  background: #FF9500;
  border-radius: 0 4rpx 4rpx 0;
}
.profile-top-bar .td-body {
  position: absolute; bottom: 0; left: 4rpx;
  width: 28rpx; height: 18rpx;
  background: #FFFFFF;
  border-radius: 14rpx 14rpx 12rpx 12rpx;
  border: 2rpx solid #FFC54A;
  box-sizing: border-box;
}
.profile-top-bar .td-wing {
  position: absolute; bottom: 6rpx; left: 14rpx;
  width: 12rpx; height: 8rpx;
  background: #FFE0A0;
  border-radius: 6rpx;
}
.profile-top-bar .td-tail {
  position: absolute; bottom: 8rpx; left: 0;
  width: 6rpx; height: 6rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFC54A;
  border-radius: 50%;
  box-sizing: border-box;
}


/* 内容区 */
.content { min-height: 100vh; padding: 24rpx 32rpx; box-sizing: border-box; }

/* 详情卡片 */
.info-title { font-size: var(--font-xl); font-weight: 700; display: block; margin-bottom: 16rpx; }
.info-meta { display: flex; align-items: center; gap: 16rpx; }
.status-tag { font-size: var(--font-xs); padding: 6rpx 20rpx; border-radius: 999rpx; }
.status-tag.pending { background: var(--warning-border); color: var(--warning); }
.status-tag.investigating { background: rgba(0,166,147,0.15); color: var(--primary); }
.status-tag.handling { background: rgba(0,166,147,0.15); color: var(--primary); }
.status-tag.verified { background: var(--success-bg); color: var(--success); }
.status-tag.resolved { background: var(--success-bg); color: var(--success); }
.status-tag.rejected { background: rgba(255,69,58,0.15); color: var(--danger); }
.info-time { font-size: var(--font-xs); color: var(--text-hint); }
.section-title { font-size: var(--font-md); font-weight: 600; margin-bottom: 16rpx; display: block; }
.info-row { font-size: var(--font-sm); color: var(--text-secondary); display: block; margin-bottom: 8rpx; }
.info-content { font-size: var(--font-md); color: var(--text-primary); line-height: 1.6; }

/* 操作按钮 */
.btn-outline { text-align: center; padding: 24rpx; border-radius: 999rpx; border: 2rpx solid var(--border); color: var(--text-primary); font-size: var(--font-md); margin: 24rpx 0; transition: all 0.2s; }
.btn-outline:active { background: var(--input-bg); }

/* 列表卡片 */
.complaint-list { display: flex; flex-direction: column; gap: 16rpx; }
.complaint-card { padding: 28rpx; }
.complaint-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.complaint-title { font-size: var(--font-lg); font-weight: 600; color: var(--text-primary); flex: 1; margin-right: 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.complaint-category { font-size: var(--font-xs); color: var(--text-hint); display: block; margin-bottom: 8rpx; }
.complaint-preview { font-size: var(--font-sm); color: var(--text-secondary); line-height: 1.5; display: block; margin-bottom: 12rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.complaint-time { font-size: var(--font-xs); color: var(--text-hint); }
.list-empty { text-align: center; padding: 120rpx 0; font-size: var(--font-sm); color: var(--text-hint); }
.info-card, .section { margin-bottom: 16rpx; padding: 28rpx; }

/* ========== 居中弹窗 ========== */
.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}
.detail-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity .25s ease;
}
.detail-modal.show {
  opacity: 1;
  pointer-events: auto;
}
.detail-card {
  width: 600rpx;
  max-height: 70vh;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 36rpx 36rpx;
  position: relative;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,.15);
  display: flex;
  flex-direction: column;
}
.detail-close {
  position: absolute;
  top: 20rpx; right: 20rpx;
  width: 56rpx; height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #999;
  border-radius: 50%;
  background: #f5f5f5;
  z-index: 2;
}
.detail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.detail-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.4;
}
.detail-rows {
  margin-bottom: 16rpx;
}
.detail-row {
  display: block;
  font-size: 24rpx;
  color: #888;
  line-height: 1.8;
}
.detail-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}
.detail-scroll {
  max-height: 240rpx;
}
.detail-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  white-space: pre-wrap;
}
.detail-actions {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.detail-actions .btn-outline {
  margin: 0;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
}
.popup-loading {
  text-align: center;
  padding: 48rpx 0;
  font-size: 26rpx;
  color: #aaa;
}
