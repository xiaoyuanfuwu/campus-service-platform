/* pages/charity/charity.wxss */
page { background: #F5F5F7 !important; }
.page-module { background: transparent !important; }

/* 全屏背景图（修复底部两侧黑色裸露） */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

.msg-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}
.msg-top-bar {
  position: fixed;
  top: 0;
  z-index: 100;
  background: transparent;
  left: 0; right: 0;
}
.msg-top-bar-spacer {}
.msg-top-bar .top-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.msg-top-bar .brand-logo {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.msg-top-bar .nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.msg-top-bar .back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 4rpx;
}
.msg-top-bar .brand-logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}
.msg-top-bar .brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.msg-top-bar .top-duck-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.msg-top-bar .td-head {
  position: absolute; top: 4rpx; left: 6rpx;
  width: 22rpx; height: 22rpx;
  background: #FFC54A;
  border-radius: 50%;
}
.msg-top-bar .td-eye {
  position: absolute; top: 12rpx; left: 18rpx;
  width: 4rpx; height: 4rpx;
  background: #333;
  border-radius: 50%;
}
.msg-top-bar .td-beak {
  position: absolute; top: 18rpx; left: 24rpx;
  width: 8rpx; height: 5rpx;
  background: #FF9500;
  border-radius: 0 4rpx 4rpx 0;
}
.msg-top-bar .td-body {
  position: absolute; bottom: 0; left: 4rpx;
  width: 28rpx; height: 18rpx;
  background: #FFFFFF;
  border-radius: 14rpx 14rpx 12rpx 12rpx;
  border: 2rpx solid #FFC54A;
  box-sizing: border-box;
}
.msg-top-bar .td-wing {
  position: absolute; bottom: 6rpx; left: 14rpx;
  width: 12rpx; height: 8rpx;
  background: #FFE0A0;
  border-radius: 6rpx;
}
.msg-top-bar .td-tail {
  position: absolute; bottom: 8rpx; left: 0;
  width: 6rpx; height: 6rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFC54A;
  border-radius: 50%;
  box-sizing: border-box;
}

/* ===== 底部 TabBar（与 food 一致的胶囊卡片样式） ===== */
.shared-tabbar {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: transparent;
  border-top: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}
.tabbar-card {
  width: 80%;
  background: #FFFFFF;
  border-radius: 60rpx;
  box-shadow: 0 10rpx 20rpx rgba(80, 117, 204, 0.08);
  overflow: hidden;
}
.tabbar-items {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10rpx 8rpx;
}
.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  transition: all .2s;
  position: relative;
  min-width: 100rpx;
}
.tabbar-item.active .tb-label { color: #FF9500; font-weight: 600; }
.tabbar-item .tb-label { font-size: 20rpx; color: #B3B3B3; transition: color .2s; }
.tb-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tb-icon-img {
  width: 44rpx;
  height: 44rpx;
}

/* ===== 右下角悬浮联系发布按钮 ===== */
.contact-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(180rpx + constant(safe-area-inset-bottom));
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  z-index: 200;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #FF9800 0%, #FFB347 100%);
  color: #FFF;
  padding: 20rpx 28rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 152, 0, 0.40);
}
.fab-icon {
  font-size: 36rpx;
  line-height: 1;
}
.fab-text {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ===== 联系发布弹窗 ===== */
.publish-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}
.publish-modal {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}
.publish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}
.publish-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1C1C1E;
}
.publish-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8E8E93;
}
.publish-form {
  padding: 24rpx 28rpx 28rpx;
  overflow-y: auto;
}
.pf-item {
  margin-bottom: 20rpx;
}
.pf-label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 10rpx;
}
.pf-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx 20rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #1C1C1E;
  box-sizing: border-box;
}
.pf-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #1C1C1E;
  box-sizing: border-box;
}
.pf-submit {
  margin-top: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF9800 0%, #FFB347 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(255,152,0,0.25);
}

/* ===== 我的参与 ===== */
.my-participate {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.mp-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.mp-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.mp-icon {
  font-size: 32rpx;
  line-height: 1;
}
.mp-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1C1C1E;
}
.mp-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}
.mp-refresh {
  font-size: 24rpx;
  color: #FF9500;
  padding: 4rpx 12rpx;
}

.mp-loading, .mp-empty {
  padding: 40rpx 0;
  text-align: center;
}
.mp-loading {
  font-size: 24rpx;
  color: #8E8E93;
}
.mp-empty-emoji {
  font-size: 64rpx;
  display: block;
  margin-bottom: 12rpx;
}
.mp-empty-text {
  display: block;
  font-size: 28rpx;
  color: #1C1C1E;
  margin-bottom: 6rpx;
}
.mp-empty-hint {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

.mp-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.mp-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #fff 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,149,0,0.15);
}
.mp-card-tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #fff;
  background: #FF9500;
  line-height: 1.3;
}
.mp-card-tag.approved { background: #34C759; }
.mp-card-tag.pending  { background: #FF9500; }
.mp-card-tag.rejected { background: #8E8E93; }
.mp-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.mp-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mp-card-meta {
  font-size: 22rpx;
  color: #8E8E93;
}
.mp-card-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
  flex-shrink: 0;
}
