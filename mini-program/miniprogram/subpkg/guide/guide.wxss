/* subpkg/guide/guide.wxss — 校园图鉴 · 4Tab */

page {
  background: #F5F5F7 !important;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.guide-app {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: transparent;
  display: flex;
  flex-direction: column;
}

/* 全屏背景图 */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

/* 状态栏 + 导航 */
.guide-status { width: 100%; flex-shrink: 0; z-index: 10; position: relative; }

.guide-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  flex-shrink: 0;
  z-index: 10;
  position: relative;
  background: transparent;
}
.nav-back {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.45);
  backdrop-filter: blur(16rpx);
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.5);
}
.back-arrow {
  width: 16rpx; height: 16rpx;
  border-left: 3rpx solid #1C1C1E;
  border-bottom: 3rpx solid #1C1C1E;
  transform: rotate(45deg);
  margin-left: 6rpx;
}
.nav-title {
  position: absolute;
  left: 0; right: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  letter-spacing: 2rpx;
  pointer-events: none;
}
.nav-bell {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.45);
  backdrop-filter: blur(16rpx);
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.5);
  position: relative;
}
.bell-icon { position: relative; width: 28rpx; height: 28rpx; }
.bell-top {
  width: 18rpx; height: 14rpx;
  border: 2.5rpx solid #1C1C1E;
  border-radius: 8rpx 8rpx 0 0;
  margin: 0 auto;
}
.bell-bottom {
  width: 22rpx; height: 3rpx;
  background: #1C1C1E;
  border-radius: 2rpx;
  margin: 1rpx auto 0;
}
.bell-dot {
  position: absolute;
  top: 10rpx; right: 10rpx;
  width: 14rpx; height: 14rpx;
  background: #FF3B30;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

/* ===== Tab 面板 ===== */
.tab-panel {
  flex: 1;
  min-height: 0;
  z-index: 5;
  position: relative;
}
.panel-bottom-space { height: 240rpx; }

/* ==================== 广场 - 瀑布流 ==================== */
.feed-filter {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  white-space: nowrap;
}
.filter-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
  background: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(0,0,0,0.06);
  flex-shrink: 0;
}
.filter-chip.active {
  font-weight: 600;
}

.waterfall {
  display: flex;
  gap: 14rpx;
  padding: 0 20rpx;
}
.waterfall-col {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.wf-card {
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(10rpx);
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255,255,255,0.5);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
}
.wf-img {
  width: 100%;
  display: block;
  border-radius: 0;
}
.wf-img.placeholder {
  background: rgba(255,255,255,0.6);
}
.wf-info {
  padding: 14rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.wf-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wf-desc {
  font-size: 22rpx;
  color: rgba(28,28,30,0.45);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ==================== 大全 ==================== */
.all-search {
  padding: 16rpx 24rpx 0;
}
.all-search-input {
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(0,0,0,0.06);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: #1C1C1E;
}

.all-cats {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  white-space: nowrap;
}
.all-cat-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
  background: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(0,0,0,0.06);
  flex-shrink: 0;
}
.all-cat-chip.active {
  color: #FF9500;
  background: rgba(255,149,0,0.1);
  border-color: rgba(255,149,0,0.3);
}

.all-list {
  column-count: 3;
  column-gap: 12rpx;
  padding: 16rpx 20rpx;
}

.all-item {
  break-inside: avoid;
  -webkit-column-break-inside: avoid;
  page-break-inside: avoid;
  background: rgba(255,255,255,0.92);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
}

.all-item-cover {
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(255,149,0,0.10), rgba(255,107,0,0.18));
}
.all-item-img {
  width: 100%;
  height: 100%;
  display: block;
}
.all-item-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}
.all-item-emoji { font-size: 64rpx; }

.all-item-info {
  padding: 12rpx 14rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.all-item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1C1E;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.all-item-desc {
  font-size: 22rpx;
  color: rgba(28,28,30,0.5);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ==================== 发布 ==================== */
.pub-section { padding: 0 24rpx; margin-bottom: 24rpx; }
.pub-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 16rpx;
}

.pub-img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.pub-img-item {
  width: 200rpx; height: 200rpx;
  border-radius: 14rpx;
  overflow: hidden;
  position: relative;
}
.pub-img-preview { width: 100%; height: 100%; }
.pub-img-del {
  position: absolute;
  top: 0; right: 0;
  width: 44rpx; height: 44rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 0 14rpx 0 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: #fff;
}
.pub-img-add {
  width: 200rpx; height: 200rpx;
  border-radius: 14rpx;
  border: 2rpx dashed rgba(255,149,0,0.4);
  background: rgba(255,149,0,0.04);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 10rpx;
}
.pub-add-icon { width: 48rpx; height: 48rpx; position: relative; }
.pub-add-h, .pub-add-v {
  position: absolute;
  background: #FF9500;
  border-radius: 3rpx;
}
.pub-add-h { width: 48rpx; height: 4rpx; top: 50%; left: 0; transform: translateY(-50%); }
.pub-add-v { width: 4rpx; height: 48rpx; left: 50%; top: 0; transform: translateX(-50%); }
.pub-add-text { font-size: 22rpx; color: #FF9500; }

.pub-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
}
.pub-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  gap: 16rpx;
}
.pub-label {
  font-size: 28rpx;
  color: #666;
  white-space: nowrap;
  min-width: 80rpx;
}
.pub-input {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1E;
  text-align: right;
}
.pub-divider { height: 1rpx; background: rgba(0,0,0,0.05); }

.pub-cat-select {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}
.pub-cat-placeholder { font-size: 28rpx; color: #bbb; }
.pub-cat-val { font-size: 28rpx; color: #1C1C1E; }
.pub-cat-arrow { font-size: 24rpx; color: #bbb; }

.pub-textarea {
  width: 100%;
  min-height: 100rpx;
  font-size: 28rpx;
  color: #1C1C1E;
  padding: 20rpx 0;
  box-sizing: border-box;
  line-height: 1.6;
}
.pub-counter {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  padding-bottom: 16rpx;
}

.pub-submit-area {
  padding: 16rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.pub-submit-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF9500, #FFB340);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255,149,0,0.25);
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}
.pub-submit-btn.disabled { opacity: 0.5; }
.pub-hint { font-size: 22rpx; color: #bbb; }

/* ==================== 我的 ==================== */
.my-stats {
  display: flex;
  gap: 14rpx;
  padding: 20rpx 24rpx;
}
.my-stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
}
.my-stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #FF9500;
}
.my-stat-label {
  font-size: 22rpx;
  color: #999;
}

.my-list { padding: 0 24rpx; display: flex; flex-direction: column; gap: 12rpx; }
.my-item {
  display: flex;
  gap: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
}
.my-item-img {
  width: 100rpx; height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}
.my-item-info {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; gap: 6rpx;
}
.my-item-name {
  font-size: 28rpx; font-weight: 600; color: #1C1C1E;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.my-item-desc {
  font-size: 24rpx; color: rgba(28,28,30,0.45);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.my-item-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  align-self: flex-start;
}
.status-approved { color: #30D158; background: rgba(48,209,88,0.1); }
.status-pending { color: #FF9500; background: rgba(255,149,0,0.1); }
.status-rejected { color: #FF3B30; background: rgba(255,59,48,0.1); }

/* ==================== 底部 Tab 栏 ==================== */
.guide-tabbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255,255,255,0.45);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(255,255,255,0.3);
  flex-shrink: 0;
  z-index: 20;
  position: relative;
}
.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 24rpx;
}
.tabbar-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tabbar-label {
  font-size: 20rpx;
  color: #999;
  transition: color 0.2s;
}
.tabbar-item.active .tabbar-label { color: #FF9500; font-weight: 600; }

/* 广场图标 - 四宫格 */
.icon-grid {
  width: 30rpx; height: 30rpx;
  display: flex; flex-wrap: wrap; gap: 3rpx;
}
.icon-grid-cell {
  width: 13rpx; height: 13rpx;
  border-radius: 3rpx;
  background: #999;
}
.tabbar-item.active .icon-grid-cell { background: #FF9500; }

/* 大全图标 - 书 */
.icon-book {
  width: 26rpx; height: 32rpx;
  border: 2.5rpx solid #999;
  border-radius: 3rpx 6rpx 6rpx 3rpx;
  display: flex; flex-direction: column; gap: 3rpx;
  padding: 5rpx 4rpx;
  box-sizing: border-box;
}
.icon-book-line { width: 100%; height: 2rpx; background: #999; border-radius: 1rpx; }
.tabbar-item.active .icon-book { border-color: #FF9500; }
.tabbar-item.active .icon-book-line { background: #FF9500; }

/* 发布图标 - 居中加号 */
.tabbar-center {
  position: relative;
  margin-top: -24rpx;
}
.tabbar-icon-center {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9500, #FFB340);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255,149,0,0.35);
  position: relative;
}
.icon-plus-h { width: 32rpx; height: 4rpx; background: #fff; border-radius: 2rpx; position: absolute; }
.icon-plus-v { width: 4rpx; height: 32rpx; background: #fff; border-radius: 2rpx; position: absolute; }
.tabbar-center .tabbar-label { margin-top: 6rpx; }

/* 我的图标 - 人像 */
.icon-head {
  width: 14rpx; height: 14rpx;
  border: 2.5rpx solid #999;
  border-radius: 50%;
  position: absolute;
  top: 2rpx;
}
.icon-body {
  width: 24rpx; height: 10rpx;
  border: 2.5rpx solid #999;
  border-radius: 12rpx 12rpx 0 0;
  border-bottom: none;
  position: absolute;
  bottom: 2rpx;
}
.tabbar-item.active .icon-head,
.tabbar-item.active .icon-body { border-color: #FF9500; }

/* ==================== 分类选择器弹窗 ==================== */
.picker-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.picker-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
  text-align: center;
  margin-bottom: 24rpx;
}
.picker-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  justify-content: center;
}
.picker-item {
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border: 1rpx solid transparent;
}
.picker-item.active {
  color: #FF9500;
  background: rgba(255,149,0,0.1);
  border-color: rgba(255,149,0,0.3);
}
.picker-cancel {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  padding: 16rpx;
}

/* ==================== 通用 ==================== */
.loading-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 80rpx 0; gap: 14rpx;
  font-size: 24rpx; color: #bbb;
}
.loading-spinner {
  width: 40rpx; height: 40rpx;
  border: 3rpx solid rgba(255,149,0,0.2);
  border-top-color: #FF9500;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 100rpx 0 60rpx; gap: 10rpx;
}
.empty-text { font-size: 28rpx; color: #999; }
.empty-sub { font-size: 24rpx; color: #ccc; }

.tap-shrink { transition: transform 0.1s ease; }
.tap-shrink:active { transform: scale(0.96); }

/* ===== 底部 TabBar（悬浮胶囊，与 express 同款） ===== */
.shared-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 60rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
}
.tabbar-card {
  width: 76%;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 56rpx;
}
.tabbar-items {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10rpx 8rpx;
}
.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 36rpx;
  min-width: 90rpx;
}
.tabbar-item.active {
  background: rgba(102, 126, 234, 0.18);
}
.tb-label {
  font-size: 20rpx;
  color: #B3B3B3;
}
.tabbar-item.active .tb-label {
  color: #667eea;
  font-weight: 600;
}
.tb-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.tb-icon-quan {
  width: 52rpx;
  height: 52rpx;
}


/* ====== 在哪拍到扩展表单 ====== */
.pub-row-block { flex-direction: column; align-items: stretch; padding: 24rpx 0; }
.pub-label-block { display: block; margin-bottom: 16rpx; }
.pub-chip-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.pub-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(0,0,0,0.04);
  color: #1C1C1E;
  font-size: 24rpx;
  border: 2rpx solid transparent;
  transition: all .2s;
}
.pub-chip.active {
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  color: #fff;
  border-color: rgba(255,149,0,0.4);
  box-shadow: 0 4rpx 12rpx rgba(255,149,0,0.25);
}

.tab-bottom-space { height: 180rpx; }


/* === Tab 1: 3D 同心球壳 === */
.sphere-panel {
  position: relative;
  overflow: hidden;
  background: transparent;
  width: 100%;
}
.sphere-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.sphere-search {
  position: relative;
  margin-bottom: 12rpx;
}
.sphere-search-input {
  width: 100%;
  height: 60rpx;
  background: #fff;
  border-radius: 30rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #3C3C43;
  border: 1rpx solid rgba(0,0,0,0.08);
  box-sizing: border-box;
}
.sphere-search-results {
  position: absolute;
  top: 68rpx;
  left: 0;
  right: 0;
  max-height: 400rpx;
  overflow-y: auto;
  background: rgba(255,255,255,0.95);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12);
  z-index: 20;
}
.sphere-result-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.sphere-result-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.sphere-result-name {
  font-size: 24rpx;
  color: #3C3C43;
  flex: 1;
}
.sphere-result-cat {
  font-size: 20rpx;
  color: #8E8E93;
}

.sphere-filter {
  position: absolute;
  top: 100rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  z-index: 10;
  pointer-events: auto;
}
.sphere-chip {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #3C3C43;
  font-size: 22rpx;
  border: 1rpx solid rgba(0,0,0,0.06);
  box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.06);
  transition: all 200ms;
}
.sphere-chip.active {
  font-weight: 600;
}
.sphere-hint {
  position: absolute;
  bottom: 30rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: #636366;
  font-size: 20rpx;
  pointer-events: none;
}

.sphere-search-wrap {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 15;
}
.sphere-search-input {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 1rpx solid rgba(0,0,0,0.08);
  font-size: 24rpx;
  color: #3C3C43;
  box-sizing: border-box;
  width: 100%;
}
.sphere-search-results {
  margin-top: 8rpx;
  max-height: 360rpx;
  overflow-y: auto;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid rgba(0,0,0,0.06);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}
.sphere-search-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.sphere-search-item:last-child { border-bottom: none; }
.ss-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.ss-title {
  font-size: 26rpx;
  color: #1C1C1E;
  flex: 1;
}
.ss-cat {
  font-size: 22rpx;
  color: #8E8E93;
  flex-shrink: 0;
}

/* ==================== 节点详情小弹窗（底部，非模态） ==================== */
.sphere-detail-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 200rpx; /* 让出底部悬浮 tabbar */
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.12);
  z-index: 30;
  box-sizing: border-box;
  /* 入场动效 */
  animation: sphere-detail-in 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes sphere-detail-in {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.sdc-dot {
  width: 12rpx;
  flex-shrink: 0;
  border-radius: 6rpx;
  align-self: stretch;
  box-shadow: 0 0 12rpx currentColor;
}

.sdc-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sdc-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 44rpx;
}

.sdc-emoji {
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
}

.sdc-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sdc-cat {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.sdc-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8E8E93;
  line-height: 1;
  margin: -8rpx -8rpx -8rpx 0;
  flex-shrink: 0;
}
.sdc-close:active { background: rgba(0, 0, 0, 0.12); }

.sdc-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(28, 28, 30, 0.6);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
