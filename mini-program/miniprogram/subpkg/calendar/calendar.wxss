/* pages/calendar/calendar.wxss */
page { background: #F5F5F7 !important; }
.page-calendar { min-height: 100vh; background: transparent !important; }

/* 渐变背景 */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

/* 状态栏填充 */
.page-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}

/* 导航栏覆盖 */
.cal-nav {
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  border-bottom: none !important;
}


/* 品牌区居中 */
.cal-brand-center {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  justify-content: center;
}
.cal-nav .top-duck-icon {
  width: 36rpx;
  height: 36rpx;
}
.cal-brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

/* 内容区 */
.content {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx 24rpx;
  box-sizing: border-box;
  z-index: 1;
}

/* ===== 品牌头 ===== */
.brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 24rpx 0 16rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}
.slogan {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 6rpx;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
}
.brand-logo-wrap {
  width: 80rpx;
  height: 80rpx;
  animation: bob 4s ease-in-out infinite;
}
.brand-logo {
  position: relative;
  width: 80rpx;
  height: 80rpx;
}
.logo-circle {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, #1F3A6B 0%, #0E1F45 100%);
  border-radius: 50%;
  border: 2rpx solid #1F3A6B;
  box-shadow: 0 6rpx 20rpx rgba(31, 58, 107, 0.3);
}
.logo-text {
  position: absolute;
  top: 18rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #FFF;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  opacity: 0.9;
}
.logo-year {
  position: absolute;
  bottom: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #FFF;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  opacity: 0.9;
}
.brand-logo::after {
  /* 中央小建筑 */
  content: '';
  position: absolute;
  top: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 2rpx 2rpx 0 0;
}
.brand-logo::before {
  content: '';
  position: absolute;
  top: 26rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 8rpx solid rgba(255, 255, 255, 0.85);
  z-index: 1;
}

.school-title {
  display: block;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.6);
  border: 2rpx solid rgba(255, 149, 0, 0.3);
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
  width: fit-content;
  margin: 0 auto 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 149, 0, 0.12);
  animation: fadeInUp 0.6s 0.1s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes bob {
  0%, 100% { transform: translateY(0) rotate(0); }
  50% { transform: translateY(-4rpx) rotate(2deg); }
}

/* ===== 状态条 ===== */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #FFC934 0%, #F5B400 50%, #D99A00 100%);
  border-radius: 32rpx;
  padding: 24rpx 16rpx;
  margin: 0 24rpx 24rpx;
  color: #1C1C1E;
  box-shadow: 0 16rpx 40rpx rgba(245, 180, 0, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
  position: relative;
  overflow: hidden;
  animation: fadeInUp 0.6s 0.2s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}
.status-bar::before {
  content: '';
  position: absolute;
  top: -60%;
  right: -20%;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.45), transparent 60%);
  border-radius: 50%;
  pointer-events: none;
  animation: pulse 3s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.25); opacity: 0.85; }
}
.status-item {
  flex: 0 0 auto;
  text-align: center;
  position: relative;
  z-index: 1;
  min-width: 140rpx;
}
.status-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(31, 27, 18, 0.65);
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
}
.status-num-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}
.status-num {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
  color: #1C1C1E;
  font-variant-numeric: tabular-nums;
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
}
.status-unit {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(31, 27, 18, 0.65);
}
.status-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(31, 27, 18, 0.18);
  margin: 0 4rpx;
}

/* ===== 学期卡 ===== */
.semester-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 32rpx;
  box-shadow: var(--shadow-md);
  overflow: hidden;
  margin-bottom: 24rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}
.semester-card:nth-of-type(1) { animation-delay: 0.3s; }
.semester-card:nth-of-type(2) { animation-delay: 0.45s; }

.sem-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  color: #FFF;
  position: relative;
  overflow: hidden;
}
.sem-header-1 { background: linear-gradient(135deg, #B89BCB 0%, #9C7BB8 100%); }
.sem-header-2 { background: linear-gradient(135deg, #B89BCB 0%, #9C7BB8 100%); }
.sem-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3), transparent 60%);
  border-radius: 50%;
  pointer-events: none;
}
.sem-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}
.sem-tag {
  font-size: 22rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  position: relative;
  z-index: 1;
}

/* ===== 表格 ===== */
.cal-scroll {
  width: 100%;
  padding: 6rpx 6rpx 12rpx;
  box-sizing: border-box;
}
.cal-table {
  display: inline-block;
  min-width: 100%;
}
.cal-row {
  display: flex;
  gap: 4rpx;
  margin-bottom: 4rpx;
  align-items: center;
}
.cal-row.cal-head { margin-bottom: 8rpx; }

/* ===== 月份块 ===== */
.month-block {
  display: flex;
  gap: 4rpx;
  margin-bottom: 4rpx;
  align-items: flex-start;
}
.month-label {
  display: flex !important;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.04) !important;
  color: var(--text-primary) !important;
  font-size: 22rpx !important;
  font-weight: 700 !important;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
  flex-direction: column;
  align-self: stretch;
  border-radius: 10rpx;
}
.month-text {
  writing-mode: vertical-rl;
  letter-spacing: 6rpx;
  text-orientation: upright;
}
.month-weeks {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.month-weeks .cal-row {
  margin-bottom: 0;
}
.cal-cell {
  width: 64rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 10rpx;
  color: var(--text-primary);
  flex-shrink: 0;
  position: relative;
}
.cal-cell-week {
  width: 56rpx;
  background: linear-gradient(180deg, #6A8CA8, #577795);
  color: #FFF;
  font-weight: 700;
  font-size: 22rpx;
}
.cal-cell-week.cur {
  background: linear-gradient(135deg, #FF9500 0%, #E08600 100%) !important;
  box-shadow: 0 0 16rpx rgba(255, 149, 0, 0.6);
  animation: pulse-week 2s ease-in-out infinite;
  position: relative;
  z-index: 1;
}
@keyframes pulse-week {
  0%, 100% { transform: scale(1); box-shadow: 0 0 12rpx rgba(255, 149, 0, 0.6); }
  50% { transform: scale(1.1); box-shadow: 0 0 24rpx rgba(255, 149, 0, 0.95); }
}
.cal-cell-month {
  width: 52rpx;
  font-size: 20rpx;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
}
.cal-cell-day {
  font-size: 24rpx;
  font-weight: 600;
}
.cur-day {
  background: linear-gradient(135deg, #FF9500 0%, #E08600 100%) !important;
  color: #FFF !important;
  font-weight: 800;
  box-shadow: 0 0 12rpx rgba(255, 149, 0, 0.6);
  animation: pulse-day 2s ease-in-out infinite;
  border-radius: 50% !important;
  width: 56rpx !important;
  height: 56rpx !important;
}
@keyframes pulse-day {
  0%, 100% { box-shadow: 0 0 8rpx rgba(255, 149, 0, 0.5); }
  50% { box-shadow: 0 0 20rpx rgba(255, 149, 0, 0.95); }
}
.today-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 20rpx;
  height: 20rpx;
  line-height: 20rpx;
  padding: 0 4rpx;
  border-radius: 999rpx;
  background: #FF453A;
  color: #FFF;
  font-size: 14rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(255, 69, 58, 0.4);
  animation: badge-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  z-index: 2;
}
@keyframes badge-pop {
  0% { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.cal-row-vac {
  opacity: 0.5;
}

/* 表头颜色 */
.cal-row.cal-head .cal-cell-week {
  background: rgba(229, 234, 242, 0.6);
  color: #2F4A7A;
  font-weight: 700;
}
.cal-row.cal-head .cal-cell-day {
  background: rgba(229, 234, 242, 0.4);
  color: #2F4A7A;
  font-size: 22rpx;
}

/* ===== 月份色块 ===== */
.m-aug { background: linear-gradient(135deg, #C8D2E8, #B5C0DB); }
.m-sep { background: linear-gradient(135deg, #D4C2E0, #BCA6CE); }
.m-oct { background: linear-gradient(135deg, #E6C9A8, #D6B392); }
.m-nov { background: linear-gradient(135deg, #B7D49B, #9FC683); }
.m-dec { background: linear-gradient(135deg, #FBE89A, #F4DD7A); }
.m-jan { background: linear-gradient(135deg, #B5DBEC, #95C8E0); }
.m-feb { background: linear-gradient(135deg, #E0A0AC, #CE8895); }
.m-mar { background: linear-gradient(135deg, #B5DBEC, #95C8E0); }
.m-apr { background: linear-gradient(135deg, #D4C2E0, #BCA6CE); }
.m-may { background: linear-gradient(135deg, #B7D49B, #9FC683); }
.m-jun { background: linear-gradient(135deg, #FBE89A, #F4DD7A); }
.m-jul { background: linear-gradient(135deg, #B5DBEC, #95C8E0); }

/* ===== 信息卡 ===== */
.info-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 60, 20, 0.06);
  animation: fadeInUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
}
.info-card:nth-of-type(1) { animation-delay: 0.6s; }
.info-card:nth-of-type(2) { animation-delay: 0.7s; }
.info-card-bottom { animation-delay: 0.8s; font-size: 24rpx; color: var(--text-secondary); line-height: 1.7; }

.info-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 14rpx;
}
.info-dot {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #FF9500, #E08600);
  border-radius: 999rpx;
}
.info-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.info-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}
.info-bullet {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--text-hint);
  margin-top: 16rpx;
  flex-shrink: 0;
}

/* ===== 页脚 ===== */
.page-footer {
  text-align: center;
  padding: 16rpx 0 8rpx;
}
.footer-text {
  font-size: 20rpx;
  color: rgba(28, 28, 30, 0.35);
  letter-spacing: 2rpx;
}
.safe-bottom {
  height: 40rpx;
}
/* ===== 表头日期单元格均匀撑满 ===== */
.cal-row.cal-head .cal-cell-day {
  flex: 1 1 0;
  width: auto !important;
  min-width: 0;
}
.cal-row.cal-head {
  gap: 4rpx;
}
.cal-row.cal-head .cal-cell-week,
.cal-row.cal-head .cal-cell-month {
  flex: 0 0 auto;
}

/* body 行的日期单元格与表头对齐撑满 */
.month-weeks .cal-row .cal-cell-day {
  flex: 1 1 0;
  width: auto !important;
  min-width: 0;
}

/* 校标下移 20rpx */
.brand-logo-wrap {
  margin-top: 20rpx;
}
