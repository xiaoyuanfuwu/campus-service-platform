/* pages/user-search/user-search.wxss */
.page-search { min-height: 100vh; background: transparent; }

/* 内容区 */
.content { padding: 24rpx 32rpx; box-sizing: border-box; }

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border: 1rpx solid var(--border-light);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  height: 80rpx;
  box-sizing: border-box;
}
.search-icon {
  width: 28rpx; height: 28rpx;
  border: 3rpx solid var(--text-hint);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.search-icon::after {
  content: '';
  position: absolute;
  bottom: -8rpx; right: -6rpx;
  width: 12rpx; height: 3rpx;
  background: var(--text-hint);
  border-radius: 2rpx;
  transform: rotate(45deg);
}
.search-input {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
}
.search-ph { color: var(--text-placeholder); }
.search-clear {
  width: 40rpx; height: 40rpx;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-hint);
  font-size: 36rpx;
  line-height: 1;
}
.search-btn {
  padding: 18rpx 32rpx;
  background: var(--primary);
  color: var(--text-on-primary);
  border-radius: 999rpx;
  font-size: var(--font-md);
  font-weight: 500;
  flex-shrink: 0;
  transition: all 0.2s;
}
.search-btn:active { opacity: 0.85; transform: scale(0.97); }

/* 加载状态 */
.state-box {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 80rpx 0;
  color: var(--text-hint);
}
.state-text { font-size: var(--font-sm); }

/* 用户卡片 */
.result-list { display: flex; flex-direction: column; gap: 16rpx; }
.user-card {
  display: flex;
  align-items: center;
  padding: 24rpx !important;
}
.avatar-box { margin-right: 20rpx; flex-shrink: 0; }
.avatar {
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: var(--primary-bg-mid);
}
.avatar-text {
  display: flex; align-items: center; justify-content: center;
  color: var(--primary);
  font-size: var(--font-lg);
  font-weight: 600;
}
.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}
.user-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
}
.user-desc {
  font-size: var(--font-xs);
  color: var(--text-hint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.arrow-right {
  width: 16rpx; height: 16rpx;
  border-top: 3rpx solid var(--text-hint);
  border-right: 3rpx solid var(--text-hint);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 12rpx;
}
