/* subpkg/freshman/freshman.wxss — 新生大厅（示例大学） */

.page-freshman {
  width: 100%;
  min-height: 100vh;
  position: relative;
  background: transparent;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

/* ===== 顶部栏（与其他页面统一：透明融入背景） ===== */
.msg-status-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 99;
  background: transparent;
}

.msg-top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
}

.top-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 4rpx;
}

.brand-logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.msg-top-bar .top-duck-icon { position: relative; width: 36rpx; height: 36rpx; }
.msg-top-bar .td-head { position: absolute; top: 4rpx; left: 6rpx; width: 22rpx; height: 22rpx; background: #FFC54A; border-radius: 50%; }
.msg-top-bar .td-eye { position: absolute; top: 12rpx; left: 18rpx; width: 4rpx; height: 4rpx; background: #333; border-radius: 50%; }
.msg-top-bar .td-beak { position: absolute; top: 18rpx; left: 24rpx; width: 8rpx; height: 5rpx; background: #FF9500; border-radius: 0 4rpx 4rpx 0; }
.msg-top-bar .td-body { position: absolute; bottom: 0; left: 4rpx; width: 28rpx; height: 18rpx; background: #FFFFFF; border-radius: 14rpx 14rpx 12rpx 12rpx; border: 2rpx solid #FFC54A; box-sizing: border-box; }
.msg-top-bar .td-wing { position: absolute; bottom: 6rpx; left: 14rpx; width: 12rpx; height: 8rpx; background: #FFE0A0; border-radius: 6rpx; }
.msg-top-bar .td-tail { position: absolute; bottom: 8rpx; left: 0; width: 6rpx; height: 6rpx; background: #FFFFFF; border: 2rpx solid #FFC54A; border-radius: 50%; box-sizing: border-box; }

.msg-top-bar-spacer {
  width: 100%;
}

/* ===== 滚动区 ===== */
.freshman-scroll {
  position: relative;
  z-index: 1;
  height: calc(100vh - 0px);
  box-sizing: border-box;
}

/* ===== 大横幅 ===== */
.hero-card {
  position: relative;
  margin: 24rpx 24rpx 0;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 48rpx;
  background: #F5F7FF;
  box-shadow: 0 16rpx 40rpx rgba(73, 88, 183, 0.18);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.hero-bg-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-tag {
  position: relative;
  z-index: 3;
  align-self: flex-start;
  font-size: 22rpx;
  color: #4B57BC;
  background: rgba(255, 255, 255, 0.82);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.hero-title {
  position: relative;
  z-index: 3;
  font-size: 56rpx;
  font-weight: 800;
  color: #202A55;
  letter-spacing: 4rpx;
  line-height: 1.2;
}

.hero-sub {
  position: relative;
  z-index: 3;
  font-size: 40rpx;
  font-weight: 700;
  color: #39436F;
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}

.hero-en {
  position: relative;
  z-index: 3;
  font-size: 24rpx;
  color: #687191;
  margin-top: 20rpx;
  letter-spacing: 2rpx;
  font-style: italic;
}

/* ===== 区块 ===== */
.section {
  margin: 36rpx 24rpx 0;
}

.section-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #2B2B2B;
}

.section-sub {
  font-size: 24rpx;
  color: #9A9A9A;
  margin-left: 16rpx;
}

/* ===== 5 宫格 ===== */
.grid-5 {
  display: flex;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 32rpx 8rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-icon-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
}

.grid-name {
  font-size: 22rpx;
  color: #3A3A3A;
  margin-top: 16rpx;
  font-weight: 500;
}

/* ===== 加入新生群按钮 ===== */
.group-btn {
  margin: 36rpx 24rpx 0;
  background: linear-gradient(135deg, #34C759, #28A745);
  border-radius: 28rpx;
  padding: 32rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(40, 167, 69, 0.25);
}

.group-btn-icon {
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
}

.group-btn-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.group-btn-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.group-btn-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.group-btn-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 12rpx;
}

/* ===== 搜索栏 ===== */
.search-bar {
  margin: 36rpx 24rpx 0;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #B0B0B0;
}

/* ===== 热门内容卡片 ===== */
.featured-list {
  display: flex;
  flex-direction: column;
}

.featured-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.featured-icon-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  margin-right: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.10);
}

.featured-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.featured-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2B2B2B;
}

.featured-desc {
  font-size: 23rpx;
  color: #9A9A9A;
  margin-top: 6rpx;
}

.featured-arrow {
  font-size: 40rpx;
  color: #C8C8C8;
  margin-left: 12rpx;
}

.bottom-space {
  height: 60rpx;
}

/* ===== 按压动效 ===== */
.tap-shrink {
  transition: transform 0.12s ease;
}

.tap-shrink:active {
  transform: scale(0.96);
}


/* ===== 新生群二维码弹窗 ===== */
.qr-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.55);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s;
}
.qr-mask.show {
  opacity: 1;
  visibility: visible;
}
.qr-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.qr-sheet.show {
  transform: translateY(0);
}
.qr-sheet-head {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 32rpx;
}
.qr-sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary, #2b2b2b);
}
.qr-sheet-close {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #999;
  background: #f4f4f4;
  border-radius: 50%;
}
.qr-sheet-body {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.qr-img {
  width: 420rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}
.qr-tip {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.qr-tip-main {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary, #2b2b2b);
}
.qr-tip-sub {
  font-size: 24rpx;
  color: #999;
}
