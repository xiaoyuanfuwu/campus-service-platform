/* subpkg/freshman/guide-detail.wxss — 新生攻略详情 */

.page-guide {
  width: 100%;
  min-height: 100vh;
  position: relative;
  background: #FDF6EF;
}

.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

/* ===== 顶部栏（与其他页面统一：透明融入背景） ===== */
.msg-status-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 99;
  background: transparent;
}

.msg-top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
}

.top-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 4rpx;
}

.brand-logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.msg-top-bar .top-duck-icon { position: relative; width: 36rpx; height: 36rpx; }
.msg-top-bar .td-head { position: absolute; top: 4rpx; left: 6rpx; width: 22rpx; height: 22rpx; background: #FFC54A; border-radius: 50%; }
.msg-top-bar .td-eye { position: absolute; top: 12rpx; left: 18rpx; width: 4rpx; height: 4rpx; background: #333; border-radius: 50%; }
.msg-top-bar .td-beak { position: absolute; top: 18rpx; left: 24rpx; width: 8rpx; height: 5rpx; background: #FF9500; border-radius: 0 4rpx 4rpx 0; }
.msg-top-bar .td-body { position: absolute; bottom: 0; left: 4rpx; width: 28rpx; height: 18rpx; background: #FFFFFF; border-radius: 14rpx 14rpx 12rpx 12rpx; border: 2rpx solid #FFC54A; box-sizing: border-box; }
.msg-top-bar .td-wing { position: absolute; bottom: 6rpx; left: 14rpx; width: 12rpx; height: 8rpx; background: #FFE0A0; border-radius: 6rpx; }
.msg-top-bar .td-tail { position: absolute; bottom: 8rpx; left: 0; width: 6rpx; height: 6rpx; background: #FFFFFF; border: 2rpx solid #FFC54A; border-radius: 50%; box-sizing: border-box; }

.msg-top-bar-spacer {
  width: 100%;
}

/* ===== 滚动区 ===== */
.guide-scroll {
  position: relative;
  z-index: 1;
  height: calc(100vh - 0px);
  box-sizing: border-box;
}

/* ===== 头部卡片 ===== */
.guide-head {
  margin: 24rpx 24rpx 0;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.12);
}

.guide-head-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.18);
}

.guide-head-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.guide-head-summary {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 16rpx;
  text-align: center;
  line-height: 1.6;
}

/* ===== 正文 ===== */
.guide-body {
  margin: 24rpx 24rpx 0;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.guide-section {
  margin-bottom: 32rpx;
}

.guide-h {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.guide-h-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.guide-h-text {
  font-size: 31rpx;
  font-weight: 700;
  color: #2B2B2B;
}

.guide-p {
  display: block;
  font-size: 27rpx;
  color: #555555;
  line-height: 1.8;
  padding-left: 26rpx;
  white-space: pre-line;
}

/* ===== 去提问 ===== */
.guide-ask {
  margin-top: 12rpx;
  background: linear-gradient(135deg, #FFF3E0, #FFE8CC);
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
}

.guide-ask-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.guide-ask-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.guide-ask-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #B25000;
}

.guide-ask-sub {
  font-size: 22rpx;
  color: #C47A3A;
  margin-top: 4rpx;
}

.guide-ask-arrow {
  font-size: 40rpx;
  color: #C47A3A;
}

.guide-disclaimer {
  display: block;
  margin-top: 28rpx;
  font-size: 21rpx;
  color: #B8B8B8;
  text-align: center;
}

.bottom-space {
  height: 60rpx;
}

/* ===== 按压动效 ===== */
.tap-shrink {
  transition: transform 0.12s ease;
}

.tap-shrink:active {
  transform: scale(0.96);
}
