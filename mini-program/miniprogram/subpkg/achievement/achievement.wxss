/* subpkg/achievement/achievement.wxss — 校园成就主页样式（参考 tools 页背景+topbar） */

@import "../_shared/base.wxss";

/* ===== 页面背景 ===== */
.page-achievement {
  height: 100vh;
  overflow: hidden;
  background: transparent !important;
}

/* 渐变背景 */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

/* 状态栏填充 */
.page-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}

/* ===== 自定义导航 ===== */
.achievement-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: transparent;
}
.achievement-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}
.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 4rpx;
}
.achievement-brand-center {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  justify-content: center;
}
.top-duck-icon {
  width: 36rpx;
  height: 36rpx;
}
.achievement-brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.nav-placeholder {
  width: 60rpx;
}

/* ===== 滚动容器 ===== */
.achievement-scroll {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 1;
}

/* 鸭子图标 */
.top-duck-icon {
  position: relative;
}
.td-head {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  background: #FFD60A;
  border-radius: 50%;
  top: 0; left: 6rpx;
}
.td-eye {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: #1C1C1E;
  border-radius: 50%;
  top: 8rpx; right: 8rpx;
}
.td-beak {
  position: absolute;
  width: 14rpx;
  height: 8rpx;
  background: #FF9500;
  border-radius: 50%;
  top: 14rpx; right: -2rpx;
}
.td-body {
  position: absolute;
  width: 32rpx;
  height: 20rpx;
  background: #FFD60A;
  border-radius: 50%;
  bottom: 0; left: 4rpx;
}
.td-wing {
  position: absolute;
  width: 16rpx;
  height: 14rpx;
  background: #FF9500;
  border-radius: 50%;
  top: 14rpx; left: 0;
}
.td-tail {
  position: absolute;
  width: 10rpx;
  height: 8rpx;
  background: #FF9500;
  border-radius: 0 50% 50% 0;
  top: 10rpx; left: -4rpx;
}

/* 顶部总览 */
.ach-header {
  margin: 20rpx 24rpx 0;
  padding: 45rpx 42rpx;
  background: rgba(255,255,255,.65);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,.5);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.04);
}
.ach-header-inner {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.ach-trophy-icon {
  font-size: 102rpx;
  width: 144rpx;
  height: 144rpx;
  background: linear-gradient(135deg, #FFF7E0, #FFE4A0);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(255,180,0,.25);
}
.ach-summary {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.ach-title {
  font-size: 45rpx;
  font-weight: 800;
  color: #1C1C1E;
}
.ach-sub {
  font-size: 33rpx;
  color: #8E8E93;
}
.ach-progress-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: conic-gradient(#FF9500 calc(var(--p,0) * 1%), #E5E5EA 0);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}
.ach-progress-ring::before {
  content: "";
  position: absolute;
  width: 93rpx; height: 93rpx;
  background: #FFF;
  border-radius: 50%;
}
.ach-progress-num {
  position: relative;
  z-index: 2;
  font-size: 30rpx;
  font-weight: 800;
  color: #FF9500;
}

/* 赛道卡片 */
.ach-tracks {
  padding: 20rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}
.ach-track-card {
  padding: 36rpx 31rpx 31rpx;
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.06);
}
.ach-track-leadership { background: linear-gradient(135deg, #FFF3E0, #FFE0B2); }
.ach-track-certificate { background: linear-gradient(135deg, #E8F5E9, #C8E6C9); }
.ach-track-academic { background: linear-gradient(135deg, #E3F2FD, #BBDEFB); }
.ach-track-competition { background: linear-gradient(135deg, #FCE4EC, #F8BBD0); }

.atc-bg-deco {
  position: absolute;
  right: -30rpx;
  bottom: -30rpx;
  width: 208rpx;
  height: 208rpx;
  border-radius: 50%;
  opacity: 0.15;
}
.atc-deco-leadership { background: #FF9800; }
.atc-deco-certificate { background: #4CAF50; }
.atc-deco-academic { background: #2196F3; }
.atc-deco-competition { background: #E91E63; }

.atc-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 2;
}
.atc-icon {
  width: 104rpx;
  height: 104rpx;
  background: rgba(255,255,255,.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.08);
}
.atc-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.atc-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #1C1C1E;
}
.atc-desc {
  font-size: 26rpx;
  color: #8E8E93;
}
.atc-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.atc-count {
  font-size: 31rpx;
  font-weight: 700;
  color: #3A3A3C;
}
.atc-arrow {
  font-size: 42rpx;
  color: #C7C7CC;
  font-weight: 600;
}

/* 进度条 */
.atc-progress-bar {
  margin-top: 21rpx;
  height: 10rpx;
  background: rgba(0,0,0,.06);
  border-radius: 999rpx;
  position: relative;
  z-index: 2;
  overflow: hidden;
}
.atc-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width .6s ease;
}
.atc-fill-leadership { background: linear-gradient(90deg, #FFB74D, #FF9800); }
.atc-fill-certificate { background: linear-gradient(90deg, #81C784, #4CAF50); }
.atc-fill-academic { background: linear-gradient(90deg, #64B5F6, #2196F3); }
.atc-fill-competition { background: linear-gradient(90deg, #F06292, #E91E63); }

/* 最近点亮预览 */
.atc-preview {
  margin-top: 14rpx;
  position: relative;
  z-index: 2;
}
.atc-preview-label {
  font-size: 18rpx;
  color: #8E8E93;
  display: block;
  margin-bottom: 8rpx;
}
.atc-preview-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.atc-badge {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  background: rgba(0,0,0,.06);
  border-radius: 999rpx;
  color: #3A3A3C;
  font-weight: 500;
}
.atc-empty {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #AEAEB2;
  position: relative;
  z-index: 2;
}

.bottom-safe {
  height: 60rpx;
}

.tap-shrink {
  transition: transform .12s ease;
}
.tap-shrink:active {
  transform: scale(.97);
}

.ach-trophy-img { width: 72rpx; height: 72rpx; }
.atc-icon-img { width: 52rpx; height: 52rpx; }

/* ===== page-module 布局覆盖 ===== */
.page-module {
  background: transparent !important;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}
.msg-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}
.msg-top-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: transparent;
}
.msg-top-bar-spacer { flex-shrink: 0; }
.msg-top-bar .top-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.msg-top-bar .brand-logo {
  display: flex;
  align-items: center;
  gap: 10rpx;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: auto;
  height: auto;
}
.msg-top-bar .brand-name {
  color: #FF9500;
  font-size: 34rpx;
  font-weight: 700;
}

/* Swiper */
.module-swiper {
  flex: 1;
  position: relative;
  z-index: 1;
}
.tab-scroll {
  height: 100%;
}

/* ===== 新版 TabBar（SVG 图标引用） ===== */
.shared-tabbar {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  border-top: none !important;
  padding: 0;
}
.tabbar-card {
  width: 80%;
  background: #FFFFFF;
  border-radius: 60rpx;
  box-shadow: 0 10rpx 20rpx rgba(80, 117, 204, 0.08);
  overflow: hidden;
}
.tabbar-items {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10rpx 8rpx;
}
.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  transition: all .2s;
  position: relative;
  min-width: 100rpx;
}
.tb-label {
  font-size: 20rpx;
  color: #B3B3B3;
  transition: color .2s;
}
.tabbar-item.active .tb-label {
  color: #FF9500;
  font-weight: 600;
}
.tb-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tb-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.task-tab-badge {
  position: absolute;
  top: -12rpx;
  right: -20rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 17rpx;
  background: #F44336;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  padding: 0 8rpx;
  z-index: 1;
}
.tab-bottom-space { height: 180rpx; }

/* ===== 我的成就档案 ===== */
.ach-mine-page {
  padding: 24rpx 24rpx 0;
}

/* 档案卡 */
.ach-profile-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #FFF7E0 0%, #FFE4A0 100%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 149, 0, 0.12);
  margin-bottom: 24rpx;
}
.apc-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}
.apc-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.1);
  flex-shrink: 0;
}
.apc-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.apc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.apc-sub {
  font-size: 22rpx;
  color: #8E6A20;
}
.apc-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding-left: 16rpx;
}
.apc-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #FF9500;
  line-height: 1;
}
.apc-num-label {
  font-size: 20rpx;
  color: #8E6A20;
  margin-top: 4rpx;
}

/* 通用 section */
.ach-section {
  margin-bottom: 24rpx;
}
.ach-section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx;
  margin-bottom: 16rpx;
}
.ash-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
}
.ash-sub {
  font-size: 22rpx;
  color: #8E8E93;
}
.ach-empty {
  background: rgba(255,255,255,.6);
  border-radius: 20rpx;
  padding: 48rpx 0;
  text-align: center;
  color: #8E8E93;
  font-size: 26rpx;
}

/* 勋章墙：2 列网格 */
.ach-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ach-badge {
  flex: 0 0 calc(50% - 8rpx);
  background: rgba(255,255,255,.75);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04);
  transition: transform .15s;
}
.ach-badge:active { transform: scale(.97); }
.ach-badge-ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F2F2F7, #E5E5EA);
  box-shadow: inset 0 2rpx 4rpx rgba(255,255,255,.6);
  position: relative;
}
.ach-badge-ring::after {
  content: "";
  position: absolute;
  inset: 6rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(0,0,0,.08);
}
.ach-badge-emoji {
  font-size: 48rpx;
  filter: grayscale(1) opacity(.45);
}
.ach-badge-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #8E8E93;
  text-align: center;
}
.ach-badge-tier {
  font-size: 20rpx;
  font-weight: 500;
}
.ach-badge-locked {
  color: #C7C7CC;
  font-size: 22rpx;
}
.ach-badge-percent {
  font-size: 18rpx;
  color: #8E8E93;
}

/* 金/银/铜 状态 */
.ach-badge-gold .ach-badge-ring {
  background: linear-gradient(135deg, #FFE9A8, #FFB300);
  box-shadow: 0 4rpx 12rpx rgba(255, 179, 0, .35);
}
.ach-badge-gold .ach-badge-emoji { filter: none; }
.ach-badge-gold .ach-badge-name { color: #B07000; }
.ach-badge-gold .ach-badge-tier { color: #FF9500; }
.ach-badge-gold .ach-badge-percent { color: #FF9500; font-weight: 600; }

.ach-badge-silver .ach-badge-ring {
  background: linear-gradient(135deg, #ECEFF1, #B0BEC5);
  box-shadow: 0 4rpx 12rpx rgba(176, 190, 197, .35);
}
.ach-badge-silver .ach-badge-emoji { filter: none; }
.ach-badge-silver .ach-badge-name { color: #455A64; }
.ach-badge-silver .ach-badge-tier { color: #607D8B; }
.ach-badge-silver .ach-badge-percent { color: #607D8B; }

.ach-badge-bronze .ach-badge-ring {
  background: linear-gradient(135deg, #FFE0B2, #BF8A4A);
  box-shadow: 0 4rpx 12rpx rgba(191, 138, 74, .3);
}
.ach-badge-bronze .ach-badge-emoji { filter: none; }
.ach-badge-bronze .ach-badge-name { color: #6D4C28; }
.ach-badge-bronze .ach-badge-tier { color: #A0662A; }
.ach-badge-bronze .ach-badge-percent { color: #A0662A; }

/* 达成日志时间线 */
.ach-timeline {
  position: relative;
  padding-left: 28rpx;
  background: rgba(255,255,255,.7);
  border-radius: 20rpx;
  padding: 24rpx 24rpx 24rpx 32rpx;
}
.ach-timeline::before {
  content: "";
  position: absolute;
  left: 20rpx;
  top: 36rpx;
  bottom: 36rpx;
  width: 2rpx;
  background: rgba(0,0,0,.08);
}
.ach-log {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
}
.ach-log:not(:last-child) {
  border-bottom: 1rpx solid rgba(0,0,0,.04);
}
.ach-log-dot {
  position: absolute;
  left: -22rpx;
  top: 28rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C7C7CC;
  box-shadow: 0 0 0 4rpx rgba(255,255,255,1);
  z-index: 1;
}
.ach-log-dot-leadership { background: #FF9800; }
.ach-log-dot-certificate { background: #4CAF50; }
.ach-log-dot-academic { background: #2196F3; }
.ach-log-dot-competition { background: #E91E63; }
.ach-log-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.ach-log-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.ach-log-emoji { font-size: 26rpx; }
.ach-log-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  flex-shrink: 0;
}
.ach-log-track {
  font-size: 20rpx;
  color: #8E8E93;
  padding: 2rpx 10rpx;
  background: rgba(0,0,0,.04);
  border-radius: 8rpx;
}
.ach-log-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 22rpx;
  color: #8E8E93;
}
.ach-log-time { font-weight: 500; color: #3A3A3C; }
.ach-log-date { font-family: monospace; }

/* ===== 发布页面样式 ===== */
.publish-tip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #FFF9E6 0%, #FFF3CC 100%);
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
}
.tip-icon { font-size: 40rpx; flex-shrink: 0; }
.tip-content { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.tip-title { font-size: 28rpx; font-weight: 600; color: #1C1C1E; }
.tip-desc { font-size: 22rpx; color: #8E6A20; line-height: 1.5; }

/* 赛道分类选择 */
.track-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.track-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,.04);
  transition: all .2s;
}
.track-chip.active {
  background: #FF9500;
  color: #fff;
}
.track-chip-icon { font-size: 32rpx; }
.track-chip-name { font-size: 26rpx; font-weight: 500; }
.track-chip-leadership.active { background: #FF9800; }
.track-chip-certificate.active { background: #4CAF50; }
.track-chip-academic.active { background: #2196F3; }
.track-chip-competition.active { background: #E91E63; }

/* 表单样式增强 */
.form-required { color: #F44336; margin-left: 4rpx; }
.form-hint { color: #8E8E93; font-size: 22rpx; margin-left: 12rpx; font-weight: normal; }
.form-item-inline { display: flex; align-items: center; gap: 16rpx; }
.form-label-inline { flex-shrink: 0; }

/* 图片上传 */
.image-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}
.img-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}
.img-preview {
  width: 100%;
  height: 100%;
}
.img-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,.5);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 16rpx;
}
.img-cover-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255,149,0,.85);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 6rpx 0;
}
.img-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #C7C7CC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: rgba(255,255,255,.5);
}
.img-add-icon { font-size: 56rpx; color: #C7C7CC; }
.img-add-text { font-size: 22rpx; color: #8E8E93; }

/* ===== 待审核列表 ===== */
.pending-list {
  background: rgba(255,255,255,.7);
  border-radius: 20rpx;
  overflow: hidden;
}
.pending-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(0,0,0,.04);
}
.pending-card:last-child { border-bottom: none; }
.pending-info { display: flex; flex-direction: column; gap: 4rpx; flex: 1; min-width: 0; }
.pending-title { font-size: 28rpx; font-weight: 600; color: #1C1C1E; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pending-track { font-size: 22rpx; color: #8E8E93; }
.pending-time { font-size: 22rpx; color: #8E8E93; flex-shrink: 0; margin-left: 16rpx; }

/* ===== 上传日志状态标签 ===== */
.ach-log-status { margin-top: 8rpx; }
.status-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
}
.status-pending { background: #FFF3E0; color: #FF9500; }
.status-approved { background: #E8F5E9; color: #4CAF50; }
.status-rejected { background: #FFEBEE; color: #F44336; }

/* ===== 勋章墙：2 列网格（每个 item 一格） ===== */
.medal-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 24rpx 8rpx;
}
.medal-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff 0%, #fafbff 100%);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  transition: transform .15s;
}
.medal-card.medal-on {
  background: linear-gradient(135deg, #FFF8E1 0%, #FFE0B2 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 149, 0, 0.18);
}
.medal-card.medal-off {
  opacity: 0.62;
  filter: grayscale(0.85);
  background: #F2F2F7;
  box-shadow: none;
}
.medal-card:active { transform: scale(0.97); }
.medal-ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  background: radial-gradient(circle, #fff 0%, #fff 60%, transparent 60%);
  position: relative;
}
.medal-card.medal-on .medal-ring {
  background: radial-gradient(circle, #FFD54F 0%, #FFB300 70%, #FF8F00 100%);
  box-shadow: 0 0 0 4rpx rgba(255,255,255,0.6), 0 4rpx 16rpx rgba(255,179,0,0.35);
}
.medal-card.medal-off .medal-ring {
  background: #E5E5EA;
}
.medal-emoji {
  font-size: 56rpx;
  line-height: 1;
  display: inline-block;
  text-align: center;
}
.medal-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1C1C1E;
  text-align: center;
  line-height: 1.3;
  margin-bottom: 4rpx;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.medal-track {
  font-size: 18rpx;
  color: #8E8E93;
  margin-bottom: 8rpx;
}
.medal-status {
  font-size: 20rpx;
  text-align: center;
  padding-top: 8rpx;
  border-top: 1rpx dashed rgba(0,0,0,0.08);
  width: 100%;
}
.medal-on-text {
  color: #FF9500;
  font-weight: 700;
}
.medal-off-text {
  color: #C7C7CC;
}

.medal-emoji-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}
.medal-emoji-wrap .svg-ico {
  width: 56rpx;
  height: 56rpx;
  display: block;
}

/* 未解锁：灰色滤镕 */
.medal-card.medal-off .medal-emoji-wrap .svg-ico {
  filter: grayscale(1) opacity(0.35);
}

/* 已解锁：保持原色（深色线条），在金色环上呈现黑色质感 */
.medal-card.medal-on .medal-emoji-wrap .svg-ico {
  filter: none;
}

.medal-on-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.medal-on-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  display: block;
}

/* 修复：把原来 <text> 嵌 <view> 的位置改成纯 <view>，需要 display: inline-flex 让它们和兄弟节点横排 */
.tip-icon,
.track-chip-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.tip-icon .svg-ico,
.track-chip-icon .svg-ico {
  width: 1em;
  height: 1em;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* 图标+文字 横排 */
.notify-label,
.ash-title {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.notify-label .svg-ico,
.ash-title .svg-ico {
  width: 32rpx;
  height: 32rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  flex-shrink: 0;
}

