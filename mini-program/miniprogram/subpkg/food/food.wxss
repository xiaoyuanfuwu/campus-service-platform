  height: 32rpx;
}
.exclude-sheet-rating-emoji .svg-ico {
  width: 100%;
  height: 100%;
}

/* —— 我的卡片图标放大到 44rpx，配彩色圆角底 —— */
.mine-card-icon .svg-ico {
  width: 44rpx;
  height: 44rpx;
}

/* —— 吃什么 tab 空状态 icon：72rpx —— */
.we-no-data-icon .svg-ico {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

/* —— 底部按钮行内 SVG 图标：与文字大小协调 —— */
.we-bottom-btn .svg-ico {
  width: 32rpx;
  height: 32rpx;
  display: inline-block;
  vertical-align: middle;
  margin-right: 6rpx;
}
.we-bottom-btn-primary .svg-ico {
  width: 40rpx;
  height: 40rpx;
}

/* —— 顶部空状态 icon：72rpx —— */
.empty-icon .svg-ico {
  width: 80rpx;
  height: 80rpx;
  display: block;
}

/* —— 弹窗空状态 icon：72rpx —— */
.exclude-sheet-empty-icon .svg-ico {
  width: 72rpx;
  height: 72rpx;
  display: block;
