/* ===== 加载更多按钮（显式分页） ===== */
.load-more-btn {
  display: flex;
  justify-content: center;
  margin: 24rpx 32rpx;
  padding: 20rpx 0;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FF9500, #FF7A00);
  box-shadow: 0 8rpx 24rpx rgba(255, 149, 0, 0.28);
}

.load-more-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.load-more-text {
  color: #fff;
  font-size: var(--font-sm);
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ===== 一键回顶（与主页互助墙一致） ===== */
.back-top {
  position: fixed;
  right: 24rpx;
  bottom: 180rpx;
  z-index: 95;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,149,0,0.94);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255,149,0,0.35);
  opacity: 0;
  transform: scale(0.6);
  transition: opacity .28s cubic-bezier(.4,0,.2,1), transform .28s cubic-bezier(.4,0,.2,1);
  pointer-events: none;
}
.back-top-show {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}
.back-top-arrow {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 700;
}
.back-top-text {
  font-size: 18rpx;
  line-height: 1.4;
  margin-top: 4rpx;
}
