/* === 各数量拼图布局（CSS Grid） === */

/* 1张：铺满 */
.detail-img-collage.grid-1 {
  aspect-ratio: 1;
}
.detail-img-collage.grid-1 .detail-collage-item {
  width: 100%;
  height: 100%;
}

/* 2张：左右各半 */
.detail-img-collage.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  aspect-ratio: 2 / 1;
}
.detail-img-collage.grid-2 .detail-collage-item {
  width: 100%;
  height: 100%;
}

/* 3张：1大2小（右侧2个上下叠放） */
.detail-img-collage.grid-3 {
  display: grid;
  grid-template-columns: 2fr 1fr;
  grid-template-rows: 1fr 1fr;
  aspect-ratio: 1;
}
.detail-img-collage.grid-3 .detail-collage-item:first-child {
  grid-row: 1 / 3;
  width: 100%;
  height: 100%;
}
.detail-img-collage.grid-3 .detail-collage-item:not(:first-child) {
  width: 100%;
  height: 100%;
}

/* 4张：2×2，第一张占左侧2行 */
.detail-img-collage.grid-4 {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  grid-template-rows: 1fr 1fr;
  aspect-ratio: 1.1;
}
.detail-img-collage.grid-4 .detail-collage-item:first-child {
  grid-row: 1 / 3;
  width: 100%;
  height: 100%;
}
.detail-img-collage.grid-4 .detail-collage-item:not(:first-child) {
  width: 100%;
  height: 100%;
}

/* 5张：1大 + 2小右侧 + 2个底行 */
.detail-img-collage.grid-5 {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  grid-template-rows: 1fr 1fr 1fr;
  aspect-ratio: 1;
}
.detail-img-collage.grid-5 .detail-collage-item:first-child {
  grid-row: 1 / 3;
  grid-column: 1 / 3;
  width: 100%;
  height: 100%;
}
.detail-img-collage.grid-5 .detail-collage-item:not(:first-child) {
  width: 100%;
  height: 100%;
}

/* 6张：1大2小 + 3个底行 */
.detail-img-collage.grid-6 {
  display: grid;
  grid-template-columns: 2fr 1fr;
  grid-template-rows: 1fr 1fr 1fr;
  aspect-ratio: 1;
}
.detail-img-collage.grid-6 .detail-collage-item:first-child {
  grid-row: 1 / 3;
  width: 100%;
  height: 100%;
}
.detail-img-collage.grid-6 .detail-collage-item:not(:first-child) {
  width: 100%;
  height: 100%;
}

/* 7张：1大2小 + 底行4个 */
.detail-img-collage.grid-7 {
  display: grid;
  grid-template-columns: 2fr 1fr;
  grid-template-rows: 1fr 1fr 1fr 1fr;
  aspect-ratio: 1;
}
.detail-img-collage.grid-7 .detail-collage-item:first-child {
  grid-row: 1 / 3;
  width: 100%;
  height: 100%;
}
.detail-img-collage.grid-7 .detail-collage-item:not(:first-child) {
  width: 100%;
  height: 100%;
}

/* 8张：1大2小 + 底行5个 */
.detail-img-collage.grid-8 {
  display: grid;
  grid-template-columns: 2fr 1fr;
  grid-template-rows: 1fr 1fr 1fr 1fr 1fr;
  aspect-ratio: 1;
}
.detail-img-collage.grid-8 .detail-collage-item:first-child {
  grid-row: 1 / 3;
  width: 100%;
  height: 100%;
}
.detail-img-collage.grid-8 .detail-collage-item:not(:first-child) {
  width: 100%;
  height: 100%;
}

/* 9张：3×3 网格 */
.detail-img-collage.grid-9 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 1fr 1fr 1fr;
  aspect-ratio: 1;
}
.detail-img-collage.grid-9 .detail-collage-item {
  width: 100%;
  height: 100%;
}

