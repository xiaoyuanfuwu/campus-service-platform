/* pages/food/food.wxss — 食堂推荐 (tab版) */
@import "../../pages/_shared/base.wxss";

page { background: #F5F5F7 !important; }
.page-module { background: transparent !important; height: 100vh; overflow: hidden; display: flex; flex-direction: column; }

/* ===== 顶部鸭鸭导航栏样式（从 base.wxss 补充鸭鸭图标） ===== */
.msg-status-bg {
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 99; background: transparent;
}
.msg-top-bar {
  position: fixed; top: 0; z-index: 100;
  background: transparent; left: 0; right: 0;
}
.msg-top-bar-spacer {}
.msg-top-bar .top-bar-inner {
  height: 88rpx; display: flex; align-items: center;
  justify-content: space-between; padding: 0 24rpx;
}
.msg-top-bar .nav-back {
  width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.msg-top-bar .back-arrow {
  width: 18rpx; height: 18rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg); margin-left: 4rpx;
}
.msg-top-bar .brand-logo {
  position: absolute; left: 50%; transform: translateX(-50%);
  display: flex; align-items: center; gap: 10rpx;
}
.msg-top-bar .brand-name {
  font-size: 34rpx; font-weight: 700; color: #FF9500;
  letter-spacing: 2rpx; white-space: nowrap;
}
.msg-top-bar .top-duck-icon { position: relative; width: 36rpx; height: 36rpx; }
.msg-top-bar .td-head { position: absolute; top: 4rpx; left: 6rpx; width: 22rpx; height: 22rpx; background: #FFC54A; border-radius: 50%; }
.msg-top-bar .td-eye { position: absolute; top: 12rpx; left: 18rpx; width: 4rpx; height: 4rpx; background: #333; border-radius: 50%; }
.msg-top-bar .td-beak { position: absolute; top: 18rpx; left: 24rpx; width: 8rpx; height: 5rpx; background: #FF9500; border-radius: 0 4rpx 4rpx 0; }
.msg-top-bar .td-body { position: absolute; bottom: 0; left: 4rpx; width: 28rpx; height: 18rpx; background: #FFFFFF; border-radius: 14rpx 14rpx 12rpx 12rpx; border: 2rpx solid #FFC54A; box-sizing: border-box; }
.msg-top-bar .td-wing { position: absolute; bottom: 6rpx; left: 14rpx; width: 12rpx; height: 8rpx; background: #FFE0A0; border-radius: 6rpx; }
.msg-top-bar .td-tail { position: absolute; bottom: 8rpx; left: 0; width: 6rpx; height: 6rpx; background: #FFFFFF; border: 2rpx solid #FFC54A; border-radius: 50%; box-sizing: border-box; }

/* ===== 底部 TabBar（与 rental 同款 CSS 图标版） ===== */
.shared-tabbar {
  position: absolute; bottom: 60rpx; left: 0; right: 0; z-index: 2;
  display: flex; flex-direction: column; align-items: center;
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  border-top: none !important;
  padding: 0;
}
.tabbar-card {
  width: 80%; background: #FFFFFF; border-radius: 60rpx;
  box-shadow: 0 10rpx 20rpx rgba(80, 117, 204, 0.08); overflow: hidden;
}
.tabbar-items {
  display: flex; align-items: center; justify-content: space-around;
  padding: 10rpx 8rpx;
}
.tabbar-item {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  padding: 8rpx 20rpx; border-radius: 30rpx; transition: all .2s;
  position: relative; min-width: 100rpx;
}
.tb-label { font-size: 20rpx; color: #B3B3B3; transition: color .2s; }
.tabbar-item.active .tb-label { color: #FF9500; font-weight: 600; }
.tb-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.tb-icon-wrap {
  width: 56rpx; height: 56rpx; position: relative;
  display: flex; align-items: center; justify-content: center;
}
.tb-icon { position: relative; }

/* Tab图标 - 大厅（房子） */

/* Tab图标 - 发布（加号） */

/* Tab图标 - 我的（用户） */

/* ===== 筛选区 ===== */
.filter-section { padding: 0 0 16rpx 32rpx; }
.filter-row-wrap { margin-bottom: 12rpx; }
.filter-row-wrap:last-child { margin-bottom: 0; }
.filter-label {
  font-size: 24rpx; color: var(--text-hint); font-weight: 500;
  display: block; margin-bottom: 12rpx; padding-right: 32rpx;
}
.filter-scroll { white-space: nowrap; width: 100%; }
.filter-row { display: flex; gap: 12rpx; padding-right: 32rpx; box-sizing: border-box; }
.filter-chip {
  display: inline-block; padding: 10rpx 24rpx; border-radius: 999rpx;
  font-size: 24rpx; color: var(--text-secondary);
  background: var(--bg-card); border: 1rpx solid var(--border);
  transition: all .2s; white-space: nowrap;
}
.filter-chip.active {
  background: var(--primary-bg-strong); color: #FF9500;
  border-color: #FF9500; font-weight: 600;
}

/* ===== 筛选区 ===== */
.filter-section { padding: 0 0 16rpx 32rpx; }
.filter-row-wrap { margin-bottom: 12rpx; }
.filter-row-wrap:last-child { margin-bottom: 0; }
.filter-label {
  font-size: 24rpx; color: var(--text-hint); font-weight: 500;
  display: block; margin-bottom: 12rpx; padding-right: 32rpx;
}
.filter-scroll { white-space: nowrap; width: 100%; }
.filter-row { display: flex; gap: 12rpx; padding-right: 32rpx; box-sizing: border-box; }
.filter-chip {
  display: inline-block; padding: 10rpx 24rpx; border-radius: 999rpx;
  font-size: 24rpx; color: var(--text-secondary);
  background: var(--bg-card); border: 1rpx solid var(--border);
  transition: all .2s; white-space: nowrap;
}
.filter-chip.active {
  background: var(--primary-bg-strong); color: #FF9500;
  border-color: #FF9500; font-weight: 600;
}

/* ===== 菜品列表 (一行两列) ===== */
.food-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
  overflow-anchor: none;
}
.food-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06);
  border: 1rpx solid rgba(0,0,0,.04);
  box-sizing: border-box;
  overflow-anchor: none;
  width: 48%;
  margin-bottom: 16rpx;
}
.food-cover-box {
  position: relative;
  width: 100%;
  height: 220rpx;
  overflow: hidden;
}
.food-cover {
  width: 100%;
  height: 220rpx;
  display: block;
  background: linear-gradient(135deg, #f5f5f5, #e8e8e8);
}
.food-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0F0F0;
}
.food-cover-placeholder-img {
  width: 100rpx;
  height: 100rpx;
}
.food-info {
  padding: 16rpx 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.food-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.food-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.food-canteen {
  font-size: 24rpx;
  color: #999;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.food-price {
  font-size: 24rpx;
  color: #FF6B00;
  font-weight: 600;
  white-space: nowrap;
}
.food-rating-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 8rpx;
}
.food-rating-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.food-rating-level {
  padding: 4rpx 12rpx;
  background: #FFF3E0;
  color: #FF9500;
  font-size: 20rpx;
  border-radius: 6rpx;
  font-weight: 600;
}
.food-rating-count {
  font-size: 20rpx;
  color: #999;
}
.food-rate-btn {
  padding: 6rpx 18rpx;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  color: #fff;
  font-size: 24rpx;
  border-radius: 999rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.food-rate-btn:active { transform: scale(.95); }

/* ===== 吃什么页 ===== */
.what-eat-page {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* 标题 */
.we-header {
  padding: 28rpx 32rpx 16rpx;
  text-align: center;
}
.we-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

/* 紧凑筛选行 */
.we-filter-row {
  padding: 0 24rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 0;
}
.we-filter-scroll {
  flex: 1;
  white-space: nowrap;
}
.we-filter-chips {
  display: flex;
  gap: 10rpx;
  padding-right: 8rpx;
}
.we-filter-divider {
  width: 1rpx;
  height: 32rpx;
  background: var(--border);
  margin: 0 16rpx;
  flex-shrink: 0;
}

/* 中间内容区（撑满剩余空间，垂直居中） */
.we-center-area {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
}

/* 结果卡片 */
.we-result-card {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,.09);
  transform: translateY(-80rpx);
}
.we-result-cover-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
}
.we-result-cover {
  width: 100%;
  height: 100%;
  display: block;
}
.we-result-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 20rpx;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
}
.we-result-body {
  padding: 24rpx;
}
.we-result-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}
.we-result-tags {
  display: flex;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.we-tag {
  padding: 5rpx 16rpx;
  background: #FFF3E0;
  color: #FF9500;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.we-tag-purple {
  background: #F3E5F5;
  color: #9C27B0;
}
.we-result-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.we-result-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #FF3B30;
}
.we-result-price-hint {
  font-size: 24rpx;
  color: var(--text-hint);
}
.we-result-stars {
  font-size: 24rpx;
  color: #FFB300;
  letter-spacing: 2rpx;
}
.we-result-comment {
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 无数据 / 空状态（统一上移） */
.we-no-data-wrap {
  transform: translateY(-80rpx);
}
.we-no-data {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 40rpx 0;
}
.we-no-data-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}
.we-no-data-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.we-no-data-hint {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 底部固定操作栏 */
.we-bottom-bar {
  position: fixed;
  bottom: 160rpx;
  left: 0;
  right: 0;
  padding: 0 32rpx env(safe-area-inset-bottom, 20rpx);
  z-index: 10;
}
.we-bottom-actions {
  display: flex;
  gap: 16rpx;
}
.we-bottom-btn-primary {
  height: 88rpx;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  border-radius: 44rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255,149,0,.30);
  transition: all .15s;
}
.we-bottom-btn-primary.we-bottom-btn-lg {
  flex: 1.6;
  height: 96rpx;
  font-size: 32rpx;
}
.we-bottom-btn-primary.drawing {
  animation: shake .12s infinite;
}
.we-bottom-btn-primary:active {
  transform: scale(.96);
  opacity: .9;
}
.we-bottom-btn-secondary {
  flex: 0.8;
  height: 80rpx;
  background: var(--bg-card);
  border-radius: 44rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border);
}
.we-bottom-btn-secondary:active {
  background: var(--primary-bg);
}

/* 不吃按钮（中间小按钮） */
.we-bottom-btn-exclude {
  width: 96rpx;
  height: 88rpx;
  background: var(--bg-card);
  border-radius: 44rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  border: 2rpx solid var(--border);
  position: relative;
  flex-shrink: 0;
  overflow: hidden;
}
.we-bottom-btn-exclude:active {
  background: var(--primary-bg);
}
.we-bottom-btn-exclude .we-exclude-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  background: #FF3B30;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* ===== 不吃清单弹窗 ===== */
.exclude-sheet {
  position: fixed;
  inset: 0;
  z-index: 9100;
  pointer-events: none;
}
.exclude-sheet-bg {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.5);
  pointer-events: auto;
}
.exclude-sheet-modal {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 0 env(safe-area-inset-bottom, 0);
  pointer-events: auto;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}
.exclude-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
  box-sizing: border-box;
  width: 100%;
  flex-shrink: 0;
}
.exclude-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.exclude-sheet-clear {
  font-size: 26rpx;
  color: #FF3B30;
  font-weight: 600;
}
.exclude-sheet-list {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  width: 100%;
}
.exclude-sheet-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}
.exclude-sheet-item:last-child {
  border-bottom: none;
}
.exclude-sheet-item-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  object-fit: cover;
}
.exclude-sheet-item-info {
  flex: 1;
  min-width: 0;
}
.exclude-sheet-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.exclude-sheet-item-canteen {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}
.exclude-sheet-item-del {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFF0F0;
  color: #FF3B30;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.exclude-sheet-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  gap: 12rpx;
}
.exclude-sheet-empty-icon {
  font-size: 72rpx;
}
.exclude-sheet-empty-text {
  font-size: 28rpx;
  color: var(--text-hint);
}
.exclude-sheet-footer {
  padding: 20rpx 32rpx 32rpx;
  box-sizing: border-box;
  width: 100%;
  flex-shrink: 0;
}
.exclude-sheet-close-btn {
  height: 88rpx;
  background: var(--bg-card);
  border-radius: 44rpx;
  color: var(--text-secondary);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border);
}

@keyframes shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-5deg); }
  75% { transform: rotate(5deg); }
}

/* ===== 我的 ===== */
.mine-page { padding: 24rpx 32rpx; }
.mine-header {
  display: flex; align-items: center; gap: 24rpx;
  padding: 32rpx; margin-bottom: 24rpx;
  background: linear-gradient(135deg, #FFB347 0%, #FF9500 55%, #E08600 100%);
  border-radius: 32rpx;
}
.mine-avatar {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.8); flex-shrink: 0;
}
.mine-info { flex: 1; color: #fff; }
.mine-name { font-size: 34rpx; font-weight: 700; display: block; margin-bottom: 6rpx; }
.mine-school { font-size: 24rpx; opacity: .85; }

.mine-stats {
  display: flex; justify-content: space-around; padding: 24rpx 0;
  background: var(--bg-card); border-radius: 24rpx; margin-bottom: 24rpx;
}
.mine-stat { display: flex; flex-direction: column; align-items: center; }
.ms-num { font-size: 36rpx; font-weight: 700; color: #FF9500; }
.ms-label { font-size: 24rpx; color: var(--text-hint); margin-top: 4rpx; }

/* 加载/空/错误状态（复用 base.wxss 的 loading-state/empty-state 等，补充搜索栏 margin） */
.page-footer { margin-top: 60rpx; }

/* 补充 hover feedback */
.tap-shrink { transition: transform .1s; }
.tap-shrink:active { transform: scale(.95); }


/* ===== 评分弹窗 ===== */
.rate-overlay {
  position: fixed;
  inset: 0;
  z-index: 9000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: none;
}
.rate-bg {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.5);
  pointer-events: auto;
}
.rate-modal {
  position: relative;
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 0 env(safe-area-inset-bottom, 0);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  pointer-events: auto;
}
.rate-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 32rpx 24rpx;
  position: relative;
  border-bottom: 1rpx solid #F0F0F0;
}
.rate-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
}
.rate-close {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8E8E93;
}

/* 5 等级选择 */
.rate-levels {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  padding: 28rpx 32rpx 24rpx;
}
.rate-level-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 8rpx 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E5E5EA;
  background: #FAFAFA;
  transition: all .2s;
}
.rate-level-item .rate-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 6rpx;
}
.rate-level-item .rate-emoji .svg-ico {
  width: 100%;
  height: 100%;
}
.rate-level-item .rate-label {
  font-size: 24rpx;
  font-weight: 600;
  display: block;
  color: #8E8E93;
}
