/* —— 删除按钮 X：略缩到 28rpx —— */
.rate-img-del .svg-ico,
.exclude-sheet-item-del .svg-ico {
  width: 28rpx;
  height: 28rpx;
}

/* —— 关闭按钮 X：稍大 —— */
.rate-close .svg-ico {
  width: 32rpx;
  height: 32rpx;
}

