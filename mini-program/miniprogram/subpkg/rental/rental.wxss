/* pages/rental/rental.wxss */
@import "../_shared/mine-tab.wxss";
page { background: #F5F5F7 !important; }
.page-module { background: transparent !important; }
.empty-icon-img { width:100rpx; height:100rpx; margin-bottom:24rpx; }

.msg-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}
.msg-top-bar {
  position: fixed;
  top: 0;
  z-index: 100;
  background: transparent;
  left: 0; right: 0;
}
.msg-top-bar-spacer {}
.msg-top-bar .top-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.msg-top-bar .brand-logo {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.msg-top-bar .nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.msg-top-bar .back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 4rpx;
}
.msg-top-bar .brand-logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}
.msg-top-bar .brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.msg-top-bar .top-duck-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.msg-top-bar .td-head { position: absolute; top: 4rpx; left: 6rpx; width: 22rpx; height: 22rpx; background: #FFC54A; border-radius: 50%; }
.msg-top-bar .td-eye { position: absolute; top: 12rpx; left: 18rpx; width: 4rpx; height: 4rpx; background: #333; border-radius: 50%; }
.msg-top-bar .td-beak { position: absolute; top: 18rpx; left: 24rpx; width: 8rpx; height: 5rpx; background: #FF9500; border-radius: 0 4rpx 4rpx 0; }
.msg-top-bar .td-body { position: absolute; bottom: 0; left: 4rpx; width: 28rpx; height: 18rpx; background: #FFFFFF; border-radius: 14rpx 14rpx 12rpx 12rpx; border: 2rpx solid #FFC54A; box-sizing: border-box; }
.msg-top-bar .td-wing { position: absolute; bottom: 6rpx; left: 14rpx; width: 12rpx; height: 8rpx; background: #FFE0A0; border-radius: 6rpx; }
.msg-top-bar .td-tail { position: absolute; bottom: 8rpx; left: 0; width: 6rpx; height: 6rpx; background: #FFFFFF; border: 2rpx solid #FFC54A; border-radius: 50%; box-sizing: border-box; }


.tab-bottom-space { height:60rpx; }
/* ===== 新版 TabBar（SVG 图标引用） ===== */
.shared-tabbar {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  border-top: none !important;
  padding: 0;
}
.tabbar-card {
  width: 80%;
  background: #FFFFFF;
  border-radius: 60rpx;
  box-shadow: none;
  overflow: visible;
  box-shadow: 0 10rpx 20rpx rgba(80, 117, 204, 0.08);
  overflow: hidden;
}
.tabbar-items {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10rpx 8rpx;
}
.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  transition: all .2s;
  position: relative;
  min-width: 100rpx;
}
.tb-label {
  font-size: 20rpx;
  color: #B3B3B3;
  transition: color .2s;
}
.tabbar-item.active .tb-label {
  color: #FF9500;
  font-weight: 600;
}
.tb-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tb-icon-img {
  width: 44rpx;
  height: 44rpx;
}
/* 角标 */
.task-tab-badge {
  position: absolute;
  top: -12rpx;
  right: -20rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 17rpx;
  background: #F44336;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
  padding: 0 8rpx;
  z-index: 1;
}

/* 页脚下移 60rpx */
.page-footer {
  margin-top: 60rpx;
}

/* ===== 图片上传 ===== */
.image-upload-area {
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  margin-top: 16rpx; flex-wrap: wrap;
}
.image-preview-grid {
  display: flex; flex-wrap: wrap; gap: 16rpx; flex: 1;
}
.image-preview-item {
  position: relative; width: 156rpx; height: 156rpx;
  border-radius: 16rpx; overflow: hidden; background: var(--card-inner-bg-2);
}
.preview-thumb { width: 100%; height: 100%; }
.preview-delete {
  position: absolute; top: -2rpx; right: -2rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(0,0,0,.55); backdrop-filter: blur(8rpx);
  display: flex; align-items: center; justify-content: center; z-index: 1;
}
.preview-delete .delete-x { position: relative; width: 18rpx; height: 18rpx; }
.preview-delete .delete-x::before,
.preview-delete .delete-x::after {
  content: ''; position: absolute; top: 50%; left: 50%;
  width: 18rpx; height: 3rpx; background: #fff; border-radius: 2rpx;
}
.preview-delete .delete-x::before { transform: translate(-50%, -50%) rotate(45deg); }
.preview-delete .delete-x::after { transform: translate(-50%, -50%) rotate(-45deg); }
.image-add-btn {
  width: 156rpx; height: 156rpx; border-radius: 16rpx;
  border: 3rpx dashed var(--border); display: flex;
  flex-direction: column; align-items: center; justify-content: center;
  gap: 8rpx; background: var(--card-inner-bg-1); transition: all .2s;
}
.image-add-btn:active { border-color: var(--primary); background: var(--primary-bg); }
.image-add-btn .add-icon { position: relative; width: 36rpx; height: 36rpx; }
.image-add-btn .add-icon::before,
.image-add-btn .add-icon::after {
  content: ''; position: absolute; background: var(--text-hint); border-radius: 3rpx;
}
.image-add-btn .add-icon::before {
  top: 50%; left: 0; width: 100%; height: 4rpx; transform: translateY(-50%);
}
.image-add-btn .add-icon::after {
  left: 50%; top: 0; width: 4rpx; height: 100%; transform: translateX(-50%);
}
.add-text { font-size: 22rpx; color: var(--text-hint); }
.label-hint {
  font-size: 22rpx; color: var(--text-placeholder);
  margin-left: 8rpx; font-weight: 400;
}

/* ===== 标签（成色 / 分类 / 取件） ===== */
.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #555;
  background: #F3F4F6;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  line-height: 1.2;
  user-select: none;
}
.tag-chip.active {
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.10);
}
/* 6 种主题色 */
.tag-chip.hot-c0.active { background: #00A693; border-color: #00A693; }
.tag-chip.hot-c1.active { background: #FF6B8A; border-color: #FF6B8A; }
.tag-chip.hot-c2.active { background: #D97706; border-color: #D97706; }
.tag-chip.hot-c3.active { background: #5E8BFF; border-color: #5E8BFF; }
.tag-chip.hot-c4.active { background: #8B5CF6; border-color: #8B5CF6; }
.tag-chip.hot-c5.active { background: #EA580C; border-color: #EA580C; }

/* ===== 表单 section（需求） ===== */
.form-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 8rpx 0;
}

/* ===== 预算 + 押金联排块 ===== */
.rental-price-card {
  padding: 28rpx 24rpx 24rpx !important;
  background: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 40%, #FFF1D6 100%) !important;
  border: 1.5rpx solid rgba(234, 88, 12, 0.12);
}

.rental-inline-row {
  display: flex;
  align-items: stretch;
  gap: 0;
}

.ri-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ri-sep {
  width: 1px;
  margin: 0 18rpx;
  background: linear-gradient(180deg, transparent, #EA580C 15%, #EA580C 85%, transparent);
}

.ri-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #444;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.ri-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #999;
}

.ri-input-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFAF0 100%);
  border-radius: 20rpx;
  padding: 14rpx 20rpx;
  box-shadow:
    0 2rpx 8rpx rgba(234, 88, 12, 0.06),
    inset 0 0 0 1.5rpx rgba(234, 88, 12, 0.15);
  transition: box-shadow 0.2s;
}

.price-wrap:focus-within {
  box-shadow:
    0 4rpx 16rpx rgba(234, 88, 12, 0.16),
    inset 0 0 0 1.5rpx rgba(234, 88, 12, 0.35);
}

.price-prefix {
  font-size: 30rpx;
  font-weight: 700;
  color: #E8620C;
  line-height: 1;
}

.form-input-price {
  flex: 1;
  border: none !important;
  background: transparent !important;
  font-size: 32rpx;
  font-weight: 700;
  color: #E8620C;
  padding: 0 !important;
  box-shadow: none !important;
  min-width: 0;
  letter-spacing: 0.5rpx;
}

.form-input-price::placeholder {
  font-weight: 400;
  color: #D4A07A;
  letter-spacing: 0;
}

/* ===== 租期 ===== */
.rental-period {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed rgba(234, 88, 12, 0.20);
}

.rp-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}
.rp-date-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.rp-date-label {
  font-size: 28rpx;
  color: #555;
  font-weight: 600;
  white-space: nowrap;
}
.rp-section-title {
  font-size: 28rpx;
  color: #EA580C;
  font-weight: 600;
  margin: 50rpx 0 2rpx;
  display: block;
}

.rp-controls {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
}
.rp-date-block { flex-shrink: 0; align-self: flex-start; }
.rp-quick-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}
.rp-quick-label {
  font-size: 24rpx;
  color: #9A6B47;
  font-weight: 600;
  flex-shrink: 0;
}
.rp-quick-chips {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  flex: 1;
}
.rp-quick-chip {
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1.5rpx solid rgba(234, 88, 12, 0.20);
  font-size: 24rpx;
  font-weight: 600;
  color: #7C2D12;
  transition: all 0.2s;
}
.rp-quick-chip:active { transform: scale(0.94); }
.rp-quick-chip.rp-qc-0.active { background: linear-gradient(135deg, #00A693, #34D3C0); color: #FFFFFF; border-color: transparent; }
.rp-quick-chip.rp-qc-1.active { background: linear-gradient(135deg, #FF6B8A, #FF8DA8); color: #FFFFFF; border-color: transparent; }
.rp-quick-chip.rp-qc-2.active { background: linear-gradient(135deg, #D97706, #F59E0B); color: #FFFFFF; border-color: transparent; }
.rp-quick-chip.rp-qc-3.active { background: linear-gradient(135deg, #5E8BFF, #8DAEFF); color: #FFFFFF; border-color: transparent; }
.rp-quick-chip.active { color: #FFFFFF; border-color: transparent; }
.rp-custom-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 22rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  border: 1.5rpx solid rgba(234, 88, 12, 0.20);
}
.rp-custom-label { font-size: 24rpx; color: #7C2D12; font-weight: 500; flex-shrink: 0; }
.rp-custom-row-input {
  flex: 1;
  font-size: 26rpx;
  color: #C2410C;
  font-weight: 600;
  background: transparent;
  padding: 0;
}
.rp-custom-row-input::placeholder { color: #D4A07A; font-weight: 500; }
.rp-custom-unit { font-size: 26rpx; color: #7C2D12; font-weight: 600; flex-shrink: 0; }

.rp-date-picker { flex-shrink: 0; }

.rp-date-value {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  border: 1.5rpx solid rgba(234, 88, 12, 0.20);
  font-size: 26rpx;
  color: #C2410C;
  font-weight: 600;
  transition: all 0.2s;
}
.rp-date-value text { font-size: 26rpx; }
.rp-date-icon { font-size: 24rpx; }

.rp-days {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  flex: 1;
}

.rp-day {
  background: #FFFFFF;
  color: #7C2D12;
  border: 1.5rpx solid rgba(234, 88, 12, 0.20);
  transition: all 0.25s;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  min-width: 60rpx;
  text-align: center;
}

.rp-day.active {
  color: #FFFFFF;
  border-color: transparent;
  font-weight: 700;
  transform: translateY(-2rpx);
}
.rp-day.rp-c-0.active { background: linear-gradient(135deg, #00A693, #34D3C0); box-shadow: 0 4rpx 12rpx rgba(0, 166, 147, 0.30); }
.rp-day.rp-c-1.active { background: linear-gradient(135deg, #FF6B8A, #FF8DA8); box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.30); }
.rp-day.rp-c-2.active { background: linear-gradient(135deg, #D97706, #F59E0B); box-shadow: 0 4rpx 12rpx rgba(217, 119, 6, 0.30); }
.rp-day.rp-c-3.active { background: linear-gradient(135deg, #5E8BFF, #8DAEFF); box-shadow: 0 4rpx 12rpx rgba(94, 139, 255, 0.30); }
.rp-day.rp-c-4.active { background: linear-gradient(135deg, #8B5CF6, #A78BFA); box-shadow: 0 4rpx 12rpx rgba(139, 92, 246, 0.30); }

.rp-custom {
  padding: 0;
  background: #FFFFFF;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rp-custom.active {
  background: linear-gradient(135deg, #EA580C, #FB923C);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(234, 88, 12, 0.30);
}

.rp-custom-input {
  width: 100rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #C2410C;
  padding: 10rpx 0;
  background: transparent;
}
.rp-custom-input::placeholder {
  color: #D4A07A;
  font-weight: 500;
}
.rp-custom.active .rp-custom-input,
.rp-custom.active .rp-custom-input::placeholder {
  color: #FFFFFF;
}

.rp-return {
  margin-top: 14rpx;
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #F0FDF4, #DCFCE7);
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.rp-return-icon { font-size: 24rpx; }
.rp-return-text { font-size: 24rpx; color: #166534; }
.rp-return-date { font-weight: 700; color: #15803D; }

.dp-tags-wrap {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.dp-rental-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #EEF2FF;
  color: #5E8BFF;
  border: 1rpx solid rgba(94, 139, 255, 0.18);
}

/* ============================================================
   弹窗通用
   ============================================================ */
.overlay-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow-x: hidden;
}
.overlay-mask .detail-popup,
.overlay-mask .list-popup {
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  margin-top: auto;
  width: 100%;
  max-width: 100%;
  max-height: 92vh;
  min-height: 50vh;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.10);
  overflow-x: hidden;
  box-sizing: border-box;
  animation: rental-popup-slide-up 0.25s ease-out;
}
@keyframes rental-popup-slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
.popup-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}
.popup-nav-back {
  width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center;
}
.popup-nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.popup-nav-right { width: 60rpx; display: flex; justify-content: center; }
.popup-nav-placeholder { width: 60rpx; }
.btn-fav {
  width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  transition: background 0.2s;
}
.btn-fav.active { background: #FFF0F0; }
.fav-heart { font-size: 32rpx; line-height: 1; }
.popup-scroll {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 0 32rpx;
  width: 100%;
  box-sizing: border-box;
}
.dp-bottom-space { height: 60rpx; flex-shrink: 0; }
.popup-empty {
  text-align: center;
  padding: 80rpx 32rpx;
  color: #999;
  font-size: 28rpx;
}
.popup-loading,
.popup-no-more {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}

/* ============================================================
   详情弹窗
   ============================================================ */
.detail-popup { background: #F9FAFB; }
.dp-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}
.dp-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.dp-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}
.dp-status {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  white-space: nowrap;
}
.dp-status.active { color: #00A693; background: rgba(0, 166, 147, 0.10); }
.dp-status.closed  { color: #999; background: rgba(0, 0, 0, 0.05); }
.dp-type-row { display: flex; gap: 8rpx; flex-wrap: wrap; }
.dp-type-badge {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  background: #5E8BFF;
}
.dp-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}
.dp-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  white-space: pre-wrap;
}
/* 图片：单图 */
.dp-image-single { width: 100%; }
.dp-single-image {
  width: 100%;
  height: auto;
  border-radius: 16rpx;
  background: #f0f0f0;
}
/* 图片：多图 */
.dp-image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}
.dp-grid-cell {
  position: relative;
  width: 100%;
  padding-top: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f0f0f0;
}
.dp-grid-image {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
/* 信息行 */
.dp-info-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  gap: 16rpx;
}
.dp-info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}
.dp-info-value { flex: 1; font-size: 28rpx; color: #1a1a1a; }
.dp-price-value { color: #E8620C; font-weight: 600; font-size: 32rpx; }
/* 发布者 */
.dp-user-row { display: flex; align-items: center; gap: 16rpx; }
.dp-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #eee; }
.dp-user-info { flex: 1; }
.dp-user-name { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.dp-user-time { font-size: 22rpx; color: #999; margin-top: 4rpx; }
/* 底部操作栏 */
.dp-action-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}
.dp-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dp-btn-outline { background: #F5F5F5; color: #1a1a1a; }
.dp-btn-primary {
  background: linear-gradient(135deg, #00A693, #34D3C0);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 166, 147, 0.25);
}
.dp-btn-danger {
  background: #FEE2E2;
  color: #DC2626;
  border: 1rpx solid #FCA5A5;
}

/* ============================================================
   列表弹窗
   ============================================================ */
.list-popup { background: #F2F3F5; }
.list-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}
.lc-top { display: flex; align-items: flex-start; gap: 12rpx; }
.lc-badge {
  padding: 2rpx 14rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  background: #8B5CF6;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.lc-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}
.lc-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.lc-price { font-size: 28rpx; font-weight: 600; color: #E8620C; }
.lc-price-free { color: #888; }
.lc-status {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 12rpx;
}
.lc-status.active { color: #00A693; background: rgba(0, 166, 147, 0.10); }
.lc-status.closed { color: #999; background: rgba(0, 0, 0, 0.05); }
.lc-carpool-route { font-size: 26rpx; color: #555; }
.lc-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #777;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.lc-images { display: flex; gap: 8rpx; margin-top: 12rpx; }
.lc-img {
  width: 140rpx; height: 140rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}
.lc-img-more {
  width: 140rpx; height: 140rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.lc-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.lc-time { font-size: 22rpx; color: #999; }
.lc-actions { display: flex; gap: 8rpx; }
.lc-btn {
  padding: 4rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  background: rgba(0, 0, 0, 0.04);
  color: #555;
}
.lc-btn-danger { color: #E5484D; background: rgba(229, 72, 77, 0.08); }
.lc-btn-edit { color: #007AFF; background: rgba(0, 122, 255, 0.08); }

/* ===== 大厅卡片类型标签 + 操作按钮 ===== */
.mc-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}
.rental-type-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.5;
}
.rental-type-tag.tag-offer {
  background: rgba(48, 209, 88, 0.12);
  color: #30D158;
}
.rental-type-tag.tag-find {
  background: rgba(255, 159, 10, 0.12);
  color: #FF9F0A;
}
.mc-action-row {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--border-light);
}
.mc-action-btn {
  padding: 10rpx 32rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.mc-action-btn.btn-rent {
  background: linear-gradient(135deg, #FF9800 0%, #FFB347 100%);
  color: #FFF;
}
.mc-action-btn.btn-offer {
  background: linear-gradient(135deg, #30D158 0%, #34C759 100%);
  color: #FFF;
}

/* ===== 瀑布流两列 ===== */
.rental-falls {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx;
}
.rental-falls-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.rf-card {
  background: var(--bg-card);
  border-radius: 28rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-light);
}
.rf-cover {
  width: 100%;
  padding-bottom: 75%;
  background: var(--card-inner-bg-3);
  background-size: cover;
  background-position: center;
  position: relative;
  overflow: hidden;
}
.rf-cover-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}
.rf-body {
  padding: 20rpx 24rpx 24rpx;
}
.rf-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.rf-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.rf-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.rf-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-top: 40rpx;
  opacity: 0.8;
}
.rf-footer-user {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}
.rf-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--card-inner-bg-3);
  flex-shrink: 0;
}
.rf-footer-user-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.rf-nick-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.rf-nick {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rf-footer-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 2rpx;
  white-space: nowrap;
  overflow: hidden;
}
.rf-meta-item {
  font-size: 16rpx;
  color: var(--text-hint);
}
.rf-meta-item.ec-credit-level {
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: #fff !important;
  font-size: 14rpx;
  font-weight: 500;
  line-height: 1.4;
  transform: scale(0.85);
  transform-origin: center;
  white-space: nowrap;
}
.rf-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF6B35;
}
.rf-price-free {
  font-size: 24rpx;
  color: var(--text-hint);
}
.rf-time {
  font-size: 20rpx;
  color: var(--text-hint);
}

.publish-btn {
  margin-bottom: 200rpx;
}

/* 联系方式快捷填入按钮 */
.contact-quick-fill {
  display: flex;
  justify-content: flex-end;
  padding-top: 10rpx;
  width: 100%;
  flex-basis: 100%;
  margin-top: 8rpx;
}
.contact-quick-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #C2410C;
  background: rgba(234, 88, 12, 0.08);
  border: 1rpx solid rgba(234, 88, 12, 0.22);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.contact-quick-btn:active { transform: scale(0.96); background: rgba(234, 88, 12, 0.14); }
.contact-quick-icon {
  font-size: 22rpx;
  line-height: 1;
  color: #EA580C;
}

/* 联系方式输入框彩色圆角边框 */
.form-card .contact-form-item {
  flex-wrap: wrap;
}
.form-card .contact-form-item .form-label {
  margin-bottom: 10rpx;
}
.form-card .contact-form-item input.form-input {
  border: 2rpx solid #FF9F0A;
  border-radius: 16rpx;
  text-align: left;
  padding: 16rpx 20rpx;
  background: rgba(255, 159, 10, 0.04);
  flex: 1;
  width: 100%;
  flex-basis: 100%;
  margin-bottom: 8rpx;
}

.required { color: #E5484D; font-size: 28rpx; margin-left: 4rpx; }
