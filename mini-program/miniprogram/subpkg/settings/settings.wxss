/* 设置页 */
.page-settings {
  min-height: 100vh;
  background: transparent;
  position: relative;
}

/* ===== 顶部栏（与"我的信息"一致的 profile-top-bar 风格） ===== */
.profile-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}
.profile-top-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: transparent;
}
.profile-top-bar .top-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
}
.profile-top-bar .nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.profile-top-bar .nav-back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #FF9500;
  border-bottom: 4rpx solid #FF9500;
  transform: rotate(45deg);
  margin-left: 8rpx;
}
.profile-top-bar .nav-placeholder {
  width: 72rpx;
  flex-shrink: 0;
}
.profile-top-bar .brand-logo {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.profile-top-bar .brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.profile-top-bar .top-duck-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.profile-top-bar .td-head {
  position: absolute; top: 4rpx; left: 6rpx;
  width: 22rpx; height: 22rpx;
  background: #FFC54A;
  border-radius: 50%;
}
.profile-top-bar .td-eye {
  position: absolute; top: 12rpx; left: 18rpx;
  width: 4rpx; height: 4rpx;
  background: #333;
  border-radius: 50%;
}
.profile-top-bar .td-beak {
  position: absolute; top: 18rpx; left: 24rpx;
  width: 8rpx; height: 5rpx;
  background: #FF9500;
  border-radius: 0 4rpx 4rpx 0;
}
.profile-top-bar .td-body {
  position: absolute; bottom: 0; left: 4rpx;
  width: 28rpx; height: 18rpx;
  background: #FFFFFF;
  border-radius: 14rpx 14rpx 12rpx 12rpx;
  border: 2rpx solid #FFC54A;
  box-sizing: border-box;
}
.profile-top-bar .td-wing {
  position: absolute; bottom: 6rpx; left: 14rpx;
  width: 12rpx; height: 8rpx;
  background: #FFE0A0;
  border-radius: 6rpx;
}
.profile-top-bar .td-tail {
  position: absolute; bottom: 8rpx; left: 0;
  width: 6rpx; height: 6rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFC54A;
  border-radius: 50%;
  box-sizing: border-box;
}

/* 内容区 */
.content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx;
}

/* 设置卡片 */
.set-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.set-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.set-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 20rpx;
}

/* 颜色选择：固定两列，等宽等高，选中对号绝对定位不占位，布局不跳动 */
.color-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.color-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: calc(50% - 10rpx);
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 12rpx 18rpx;
  background: rgba(255,255,255,0.6);
  border: 2rpx solid rgba(0,0,0,0.06);
  border-radius: 16rpx;
}
.color-item .color-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0,0,0,0.08);
  flex-shrink: 0;
}
/* 蓝紫渐变选项：用渐变背景替代纯色 */
.color-item .color-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding-right: 40rpx; /* 为右侧对号固定预留空间，选中与否均不位移 */
}
.color-item .color-name.active {
  color: var(--text-primary);
  font-weight: 600;
}
.color-item .color-check {
  position: absolute;
  right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--primary, #FF9500);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 背景图选择 */
.bg-options {
  display: flex;
  gap: 24rpx;
}
.bg-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: rgba(255,255,255,0.6);
  border: 2rpx solid rgba(0,0,0,0.06);
  border-radius: 16rpx;
}
.bg-option.active {
  border-color: var(--primary, #FF9500);
  background: rgba(255,149,0,0.08);
}
.bg-thumb {
  width: 100%;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.bg-thumb-none {
  background: #ffffff;
  border: 2rpx solid rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.bg-thumb-txt {
  font-size: 24rpx;
  color: var(--text-hint);
}
.bg-option-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.bg-option.active .bg-option-name {
  color: var(--primary, #FF9500);
  font-weight: 600;
}

/* 提示 */
.set-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.6;
}

/* 保存按钮 */
.save-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0;
  background: var(--primary, #FF9500);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}
.save-btn::after {
  border: none;
}

.bottom-space {
  height: 60rpx;
}
