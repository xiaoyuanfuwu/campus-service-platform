/* pages/map/map.wxss */
.map-page {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: transparent;
  overflow: hidden;
}

/* 地图容器 */
.map-stage {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}

.map-img-wrapper {
  position: absolute;
  top: 0; left: 0;
  will-change: transform;
  -webkit-backface-visibility: hidden;
}

.map-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 边缘柔化遮罩（跟随图片移动/缩放） */
.map-fade-top {
  position: absolute;
  top: 0; left: 0; right: 0; height: 100rpx;
  background: linear-gradient(to bottom, #fff, transparent);
  z-index: 2;
  pointer-events: none;
}
.map-fade-bottom {
  position: absolute;
  bottom: 0; left: 0; right: 0; height: 100rpx;
  background: linear-gradient(to top, #fff, transparent);
  z-index: 2;
  pointer-events: none;
}
.map-fade-left {
  position: absolute;
  top: 0; bottom: 0; left: 0; width: 100rpx;
  background: linear-gradient(to right, #fff, transparent);
  z-index: 2;
  pointer-events: none;
}
.map-fade-right {
  position: absolute;
  top: 0; bottom: 0; right: 0; width: 100rpx;
  background: linear-gradient(to left, #fff, transparent);
  z-index: 2;
  pointer-events: none;
}

/* ===== GPS 定位标记 ===== */
.gps-dot {
  position: absolute;
  width: 28rpx; height: 28rpx;
  margin-left: -14rpx;
  margin-top: -14rpx;
  border-radius: 50%;
  background: #1a56db;
  border: 3rpx solid #fff;
  box-shadow: 0 0 0 6rpx rgba(26,86,219,0.25);
  pointer-events: none;
  z-index: 100;
}
/* 方向三角（圆心旋转） */
.gps-dir {
  position: absolute;
  top: -21rpx;
  left: 50%;
  margin-left: -11rpx;
  width: 0; height: 0;
  border-left: 11rpx solid transparent;
  border-right: 11rpx solid transparent;
  border-bottom: 19rpx solid #1a56db;
  transform-origin: 11rpx 35rpx;
}
/* ===== 地标标记 ===== */
.landmark-marker {
  position: absolute;
  transform: translate(-50%, -100%);
  font-size: 32rpx;
  pointer-events: none;
  z-index: 85;
}

/* ===== 顶部标题 + 指北针 ===== */
.map-back {
  position: fixed;
  top: 100rpx;
  left: 24rpx;
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.74);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  font-size: 28rpx;
  z-index: 90;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}
.map-back:active {
  background: #f0f0f0;
}
.map-title {
  position: fixed;
  top: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
  background: rgba(255,255,255,0.74);
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  white-space: nowrap;
  z-index: 90;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}
.map-compass {
  position: fixed;
  top: 200rpx;
  right: 24rpx;
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.74);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}
.compass-icon {
  color: #FF3B30;
  font-size: 36rpx;
}

/* ===== 菜单按钮（左上，与指北针对称） ===== */
.map-menu-btn {
  position: fixed;
  top: 200rpx;
  left: 24rpx;
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.74);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}
.map-menu-btn:active {
  background: #f0f0f0;
  transform: scale(0.93);
}
.menu-btn-icon {
  width: 36rpx; height: 36rpx;
}

/* ===== 菜单下拉面板 ===== */
.menu-panel {
  position: fixed;
  top: 280rpx;
  left: 24rpx;
  width: 340rpx;
  background: rgba(255,255,255,0.74);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12);
  z-index: 90;
  overflow: hidden;
}
.menu-item {
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
}
.menu-item:active {
  background: rgba(0,0,0,0.04);
}
.menu-badge {
  font-size: 20rpx;
  color: #999;
  background: rgba(0,0,0,0.06);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}
.menu-item-disabled {
  color: #999;
  font-size: 24rpx;
  border-bottom: none;
}

/* ===== 搜索框 ===== */
.search-bar {
  position: fixed;
  top: 203rpx;
  left: 108rpx;
  right: 108rpx;
  z-index: 90;
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.74);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-radius: 33rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  padding: 0;
  height: 66rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  height: 66rpx;
  line-height: 66rpx;
  background: transparent;
  padding: 0 32rpx 0 24rpx;
  -webkit-appearance: none;
}
.search-clear {
  flex-shrink: 0;
  margin-right: 55rpx;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
}
.search-clear text {
  font-size: 20rpx;
  color: #fff;
}
.search-clear:active {
  background: #999;
}
.search-btn {
  position: absolute;
  right: 14rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 44rpx; height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}
.search-btn-icon {
  width: 36rpx; height: 36rpx;
  background: transparent;
}
.search-results {
  position: fixed;
  top: 273rpx;
  left: 108rpx;
  right: 108rpx;
  width: auto;
  box-sizing: border-box;
  max-height: 400rpx;
  background: rgba(255,255,255,0.74);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-radius: 33rpx;
  z-index: 89;
  overflow: hidden;
  padding: 0;
}
.search-item {
  padding: 20rpx 28rpx;
  font-size: 26rpx;
  color: #333;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
  box-sizing: border-box;
}
.search-item:active {
  background: rgba(0,0,0,0.04);
}
.search-item--flash {
  animation: search-flash 0.4s ease;
}
@keyframes search-flash {
  0%   { background: rgba(255, 180, 80, 0.45); }
  50%  { background: rgba(255, 180, 80, 0.25); }
  100% { background: transparent; }
}

/* ===== 校园地标标签 ===== */
.poi-label {
  position: absolute;
  transform: translate(-50%, -50%);
  background: rgba(255,255,255,0.85);
  border: 1rpx solid rgba(0,0,0,0.1);
  border-radius: 100rpx;
  padding: 3rpx 8rpx;
  pointer-events: none;
  z-index: 80;
  white-space: nowrap;
  display: flex;
  align-items: center;
}
.poi-label text {
  color: #333;
  font-weight: 500;
  line-height: 1;
}

/* 搜索跳转闪烁 + 向外辐射 */
.poi-label--flash {
  animation: label-flash 1s ease;
}
@keyframes label-flash {
  0%   { background: rgba(255, 180, 80, 0.6); border-color: rgba(255, 150, 30, 0.5); transform: translate(-50%, -50%) scale(1.08); box-shadow: 0 0 0 0 rgba(255, 150, 30, 0.5); }
  20%  { background: rgba(255, 180, 80, 0.45); border-color: rgba(255, 150, 30, 0.4); transform: translate(-50%, -50%) scale(1.05); box-shadow: 0 0 0 12rpx rgba(255, 150, 30, 0.3); }
  50%  { box-shadow: 0 0 0 30rpx rgba(255, 150, 30, 0.08); }
  60%  { background: rgba(255, 180, 80, 0.2); border-color: rgba(255, 150, 30, 0.15); transform: translate(-50%, -50%) scale(1.02); box-shadow: 0 0 0 40rpx rgba(255, 150, 30, 0); }
  100% { background: rgba(255,255,255,0.85); border-color: rgba(0,0,0,0.1); transform: translate(-50%, -50%) scale(1); box-shadow: 0 0 0 0 rgba(255, 150, 30, 0); }
}

/* ===== 8K 加载指示 ===== */
.hires-loading {
  position: fixed;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 90;
  width: 64rpx; height: 64rpx;
  background: rgba(255,255,255,0.75);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hires-loading-dot {
  font-size: 28rpx;
  color: #34C759;
  animation: hires-pulse 1s ease-in-out infinite;
}
@keyframes hires-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.6); }
}
.hires-done {
  position: fixed;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 90;
  background: rgba(255,255,255,0.75);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-radius: 24rpx;
  padding: 8rpx 18rpx;
  opacity: 1;
  transition: opacity 0.6s ease;
}
.hires-done--hide {
  opacity: 0;
  pointer-events: none;
}
.hires-done-text {
  font-size: 20rpx;
  color: #34C759;
  font-weight: 500;
}
.hires-fail .hires-done-text {
  color: #FF3B30;
}

/* ===== 缩放比例 ===== */
.zoom-percent {
  position: fixed;
  right: 24rpx;
  bottom: 108rpx;
  z-index: 90;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
}

/* ===== 清除标记按钮 ===== */
.clear-marker-btn {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 90;
  background: rgba(255, 59, 48, 0.74);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-radius: 33rpx;
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}
.clear-marker-btn:active {
  background: rgba(255, 59, 48, 0.9);
  transform: translateX(-50%) scale(0.95);
}
.zoom-btns {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  z-index: 90;
}
.zb-btn {
  width: 72rpx; height: 72rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.8);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  font-size: 36rpx;
  font-weight: 400;
}
.zb-btn:active {
  background: #f0f0f0;
  transform: scale(0.93);
}
.zb-icon {
  width: 40rpx; height: 40rpx;
}

/* ===== 全景二维码弹窗 ===== */
.pano-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.pano-mask.show {
  opacity: 1;
  visibility: visible;
}
.pano-sheet {
  width: 100%;
  background: transparent;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.28s ease;
  box-sizing: border-box;
}
.pano-sheet.show {
  transform: translateY(0);
}
.pano-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.pano-sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}
.pano-sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pano-sheet-body {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pano-qr-img {
  width: 560rpx;
  border-radius: 16rpx;
  background: #fafafa;
  border: 1rpx solid #f0f0f0;
}
.card-qr-img {
  width: 460rpx;
  border-radius: 16rpx;
  background: #fafafa;
  border: 1rpx solid #f0f0f0;
}
.pano-tip {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.pano-tip-main {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}
.pano-tip-sub {
  font-size: 24rpx;
  color: #999;
}
