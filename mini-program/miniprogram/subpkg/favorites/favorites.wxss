/* pages/favorites/favorites.wxss */
.page-fav { position: relative; z-index: 1; min-height: 100vh; background: transparent; }
.content { position: relative; z-index: 1; min-height: 100vh; padding: 24rpx 32rpx; box-sizing: border-box; }
.carpool-card { position: relative; }
.card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.route { font-size: var(--font-lg); font-weight: 600; }
.type-badge { font-size: var(--font-xs); padding: 6rpx 20rpx; border-radius: 999rpx; }
.type-badge.offer { background: rgba(0,166,147,0.15); color: var(--primary); }
.type-badge.find { background: var(--warning-border); color: var(--warning); }
.card-meta { display: flex; gap: 24rpx; font-size: var(--font-sm); color: var(--text-secondary); margin-bottom: 12rpx; }
.card-note { font-size: var(--font-sm); color: var(--text-hint); }
.unfav-btn { margin-top: 16rpx; font-size: var(--font-sm); color: var(--danger); text-align: right; }

/* ========== 模块收藏卡片 ========== */
.module-card { position: relative; margin-bottom: 20rpx; }

.mod-fav-top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }

.mod-fav-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--primary-bg-strong);
  color: var(--primary);
  font-weight: 500;
}

.mod-fav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.mod-fav-meta { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; }

.mod-fav-price { font-size: 26rpx; font-weight: 700; color: var(--warning); }

.mod-fav-loc { font-size: 22rpx; color: var(--text-hint); }

.mod-fav-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.mod-fav-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
}

.mod-fav-time { font-size: var(--font-xs); color: var(--text-hint); }

/* ===== 统一顶部栏（透明背景 + 鸭鸭Logo + 橙色标题） ===== */
.profile-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}
.profile-top-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: transparent;
}
.profile-top-bar .top-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
}
.profile-top-bar .nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.profile-top-bar .nav-back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #FF9500;
  border-bottom: 4rpx solid #FF9500;
  transform: rotate(45deg);
  margin-left: 8rpx;
}
.profile-top-bar .nav-placeholder {
  width: 72rpx;
  flex-shrink: 0;
}
.profile-top-bar .brand-logo {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.profile-top-bar .brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.profile-top-bar .top-duck-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.profile-top-bar .td-head {
  position: absolute; top: 4rpx; left: 6rpx;
  width: 22rpx; height: 22rpx;
  background: #FFC54A;
  border-radius: 50%;
}
.profile-top-bar .td-eye {
  position: absolute; top: 12rpx; left: 18rpx;
  width: 4rpx; height: 4rpx;
  background: #333;
  border-radius: 50%;
}
.profile-top-bar .td-beak {
  position: absolute; top: 18rpx; left: 24rpx;
  width: 8rpx; height: 5rpx;
  background: #FF9500;
  border-radius: 0 4rpx 4rpx 0;
}
.profile-top-bar .td-body {
  position: absolute; bottom: 0; left: 4rpx;
  width: 28rpx; height: 18rpx;
  background: #FFFFFF;
  border-radius: 14rpx 14rpx 12rpx 12rpx;
  border: 2rpx solid #FFC54A;
  box-sizing: border-box;
}
.profile-top-bar .td-wing {
  position: absolute; bottom: 6rpx; left: 14rpx;
  width: 12rpx; height: 8rpx;
  background: #FFE0A0;
  border-radius: 6rpx;
}
.profile-top-bar .td-tail {
  position: absolute; bottom: 8rpx; left: 0;
  width: 6rpx; height: 6rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFC54A;
  border-radius: 50%;
  box-sizing: border-box;
}

/* ===== 卡片：半透明 + 毛玻璃（本页覆盖全局 .glass-card） ===== */
.glass-card {
  background: rgba(255, 255, 255, 0.8) !important;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}
