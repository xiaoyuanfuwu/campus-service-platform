/* pages/express/express.wxss */

/* === 背景图层 === */
page { background: #F5F5F7 !important; }
.page-module { background: transparent !important; }
.shared-nav { background: transparent !important; }

.msg-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}
.msg-top-bar {
  position: fixed;
  top: 0;
  z-index: 100;
  background: transparent;
  left: 0; right: 0;
}
.msg-top-bar-spacer {}
.msg-top-bar .top-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.msg-top-bar .brand-logo {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.msg-top-bar .nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.msg-top-bar .back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 4rpx;
}
.msg-top-bar .brand-logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}
.msg-top-bar .brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.msg-top-bar .top-duck-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.msg-top-bar .td-head { position: absolute; top: 4rpx; left: 6rpx; width: 22rpx; height: 22rpx; background: #FFC54A; border-radius: 50%; }
.msg-top-bar .td-eye { position: absolute; top: 12rpx; left: 18rpx; width: 4rpx; height: 4rpx; background: #333; border-radius: 50%; }
.msg-top-bar .td-beak { position: absolute; top: 18rpx; left: 24rpx; width: 8rpx; height: 5rpx; background: #FF9500; border-radius: 0 4rpx 4rpx 0; }
.msg-top-bar .td-body { position: absolute; bottom: 0; left: 4rpx; width: 28rpx; height: 18rpx; background: #FFFFFF; border-radius: 14rpx 14rpx 12rpx 12rpx; border: 2rpx solid #FFC54A; box-sizing: border-box; }
.msg-top-bar .td-wing { position: absolute; bottom: 6rpx; left: 14rpx; width: 12rpx; height: 8rpx; background: #FFE0A0; border-radius: 6rpx; }
.msg-top-bar .td-tail { position: absolute; bottom: 8rpx; left: 0; width: 6rpx; height: 6rpx; background: #FFFFFF; border: 2rpx solid #FFC54A; border-radius: 50%; box-sizing: border-box; }
.nav-placeholder { width: 60rpx; }
.nav-right { display:flex; align-items:center; gap:12rpx; }
.nav-task-chip { display:flex; align-items:center; gap:4rpx; padding:6rpx 16rpx; border-radius:999rpx; background:var(--danger); }
.nav-task-chip .ntc-num { font-size:22rpx; font-weight:700; color:#fff; line-height:1; }
.nav-task-chip .ntc-label { font-size:18rpx; color:rgba(255,255,255,.85); line-height:1; }
.module-swiper { position: relative; z-index: 1; }

/* 去掉 tab-scroll 顶部多余空隙，内容紧贴导航栏 */
.tab-scroll { padding-top: 0 !important; }

/* === 板块（统一透明度 -20%） === */
.express-card {
  background: rgba(255,255,255,0.80) !important;
}
.card {
  background: rgba(255,255,255,0.76) !important;
}
.search-input {
  background: rgba(255,255,255,0.76) !important;
}
.filter-tag {
  background: rgba(255,255,255,0.76) !important;
}
.task-stats-bar {
  background: rgba(255,255,255,0.80) !important;
}
.task-card {
  background: var(--bg-card, rgba(255,255,255,0.76)) !important;
}
/* ===== 新版 TabBar（SVG 图标引用） ===== */
.shared-tabbar {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  border-top: none !important;
  padding: 0;
}
.tabbar-card {
  width: 80%;
  background: #FFFFFF;
  border-radius: 60rpx;
  box-shadow: 0 10rpx 20rpx rgba(80, 117, 204, 0.08);
  overflow: hidden;
}
.tabbar-items {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10rpx 8rpx;
}
.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  transition: all .2s;
  position: relative;
  min-width: 100rpx;
}
.tb-label {
  font-size: 20rpx;
  color: #B3B3B3;
  transition: color .2s;
}
.tabbar-item.active .tb-label {
  color: #FF9500;
  font-weight: 600;
}
.tb-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tb-icon-img {
  width: 44rpx;
  height: 44rpx;
}
/* 角标 */
.task-tab-badge {
  position: absolute;
  top: -12rpx;
  right: -20rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 17rpx;
  background: #F44336;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  padding: 0 8rpx;
  z-index: 2;
  box-shadow: 0 2rpx 8rpx rgba(244, 67, 54, .4);
}
.skeleton-card {
  background: rgba(255,255,255,0.32) !important;
}


.nav-spacer {
  width: 100%;
  flex-shrink: 0;
}

/* ===== 🔔 安全提醒轮播 ===== */
/* 温馨提醒卡片（参考聊天页 chat-notice-card） */
.hall-notice-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  background: rgba(255, 149, 0, 0.06);
  border: 1rpx solid rgba(255, 149, 0, 0.12);
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  margin: 20rpx 24rpx 16rpx;
}
.hnc-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
  position: relative;
}
.hnc-shield {
  width: 28rpx;
  height: 32rpx;
  border: 3rpx solid #FF9500;
  border-radius: 6rpx 6rpx 14rpx 14rpx;
  position: absolute;
  top: 2rpx;
  left: 4rpx;
}
.hnc-shield::after {
  content: '';
  width: 3rpx;
  height: 14rpx;
  background: #FF9500;
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
}
.hnc-shield::before {
  content: '';
  width: 12rpx;
  height: 3rpx;
  background: #FF9500;
  position: absolute;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
}
.hnc-text {
  font-size: 22rpx;
  color: #8E7045;
  line-height: 1.65;
  flex: 1;
}

/* ===== 快递卡片增强：驿站+价格+帮取按钮 ===== */
.express-card-info {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.ec-info-chip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  font-size: var(--font-sm);
}

.ec-location {
  background: #eef6ff;
  color: #3b82f6;
}

.ec-size {
  background: #f5f3ff;
  color: #7c3aed;
  margin-left: 10rpx;
}
.ec-size .ec-chip-dot {
  margin-right: 20rpx;
}

/* 快递路线：黄点出发 → 绿点送达 */
.ec-route-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.ec-route-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.ec-dot-from { background: #FF9500; }
.ec-dot-to { background: #34C759; }
.ec-route-line {
  width: 2rpx;
  height: 22rpx;
  background: #FFCC80;
  margin-left: 5rpx;
  border-radius: 2rpx;
}
.ec-route-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #1C1C1E;
}

/* 取件码：右侧居中、更大、绿色 */
.ec-body-right {
  align-items: center;
}
.ec-code-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #34C759;
}

.ec-price {
  background: #fff7ed;
  color: #f97316;
}

.ec-chip-dot {
  font-size: 22rpx;
  line-height: 1;
}

.ec-chip-text {
  font-weight: 600;
}

.ec-price-free {
  color: var(--text-hint);
  font-weight: 400;
  font-size: var(--font-xs);
}

/* 取件码预览 */
.ec-code-preview {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
  padding: 12rpx 18rpx;
  background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
  border-radius: 10rpx;
  border-left: 6rpx solid #22c55e;
}

.ec-code-label {
  font-size: var(--font-xs);
  color: var(--text-hint);
  flex-shrink: 0;
}

.ec-code-value {
  font-size: var(--font-lg);
  font-weight: 800;
  color: #166534;
  letter-spacing: 2rpx;
  font-family: 'SF Mono', 'Menlo', monospace;
}

/* footer 右侧：时间 + 帮取按钮 */
.ec-footer-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ec-help-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: var(--font-xs);
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(99,102,241,.25);
  transition: all .2s;
}

.ec-help-btn:active {
  transform: scale(.94);
  opacity: .85;
}

.ec-price-row {
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx 0 0;
  gap: 16rpx;
}

.ec-size-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f3ff;
  color: #7c3aed;
  font-size: 24rpx;
  font-weight: 700;
  border: 1rpx solid rgba(124, 58, 237, .18);
  margin-left: 20rpx;
}

.ec-size-pill-icon {
  font-size: 22rpx;
  line-height: 1;
  margin-right: 10rpx;
}

.ec-price-block {
  margin-left: auto;
}

/* ===== 图片上传区域 ===== */
.image-upload-area {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

/* 已选图片网格 */
.image-preview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  flex: 1;
}

.image-preview-item {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--card-inner-bg-2);
}

.preview-thumb {
  width: 100%;
  height: 100%;
}

.preview-delete {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0,0,0,.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.preview-delete .delete-x {
  position: relative;
  width: 18rpx;
  height: 18rpx;
}

.preview-delete .delete-x::before,
.preview-delete .delete-x::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 3rpx;
  background: #fff;
  border-radius: 2rpx;
}

.preview-delete .delete-x::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.preview-delete .delete-x::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* 添加按钮 */
.image-add-btn {
  width: 156rpx;
  height: 156rpx;
  border-radius: 16rpx;
  border: 3rpx dashed var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--card-inner-bg-1);
  transition: all .2s;
}

.image-add-btn:active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.image-add-btn .add-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.image-add-btn .add-icon::before,
.image-add-btn .add-icon::after {
  content: '';
  position: absolute;
  background: var(--text-hint);
  border-radius: 3rpx;
}

.image-add-btn .add-icon::before {
  top: 50%;
  left: 0;
  width: 100%;
  height: 4rpx;
  transform: translateY(-50%);
}

.image-add-btn .add-icon::after {
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 100%;
  transform: translateX(-50%);
}

.add-text {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 标签提示文本 */
.label-hint {
  font-size: 22rpx;
  color: var(--text-placeholder);
  margin-left: 8rpx;
  font-weight: 400;
}

/* 表单标签行 */
.form-label-hint {
  font-size: 22rpx;
  color: var(--text-hint);
}

.size-option-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.size-chip {
  min-height: 116rpx;
  padding: 18rpx 12rpx;
  border-radius: 18rpx;
  background: var(--card-inner-bg-1);
  border: 2rpx solid var(--border-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  text-align: center;
  transition: all .2s;
}

.size-chip.active {
  background: #fff7ed;
  border-color: #f97316;
  box-shadow: 0 6rpx 18rpx rgba(249, 115, 22, .16);
}

.size-chip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 8rpx;
}

.size-chip.active .size-chip-title {
  color: #f97316;
}

/* 物件大小多选勾选图标 */
.size-check-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  background: var(--card-inner-bg-1);
  transition: all .2s;
  flex-shrink: 0;
  position: relative;
}

.size-check-icon::after {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 3rpx;
  width: 10rpx;
  height: 16rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
  opacity: 0;
  transition: opacity .2s;
}

.size-check-icon.show {
  border-color: #f97316;
  background: #f97316;
}

.size-check-icon.show::after {
  opacity: 1;
}

.size-chip-desc {
  font-size: 20rpx;
  color: var(--text-hint);
  line-height: 1.3;
}


.loc-check-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  background: var(--card-inner-bg-1);
  transition: all .2s;
  flex-shrink: 0;
  position: relative;
}

.loc-check-icon::after {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 3rpx;
  width: 10rpx;
  height: 16rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
  opacity: 0;
  transition: opacity .2s;
}

.loc-check-icon.show {
  border-color: var(--primary);
  background: var(--primary);
}

.loc-check-icon.show::after {
  opacity: 1;
}

/* ===== 表单标签行 ===== */
.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.form-label-text {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
}

.form-label-required {
  font-size: 20rpx;
  color: var(--danger);
  background: var(--danger-bg, #fff0f0);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

/* ===== 编辑模式横条 ===== */
.edit-mode-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  margin: 0 0 20rpx;
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  border-radius: 20rpx;
  border: 2rpx solid #FFCC80;
}
.edit-mode-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF9500;
  border-radius: 50%;
  flex-shrink: 0;
}
.edit-mode-icon::before {
  content: '';
  width: 22rpx;
  height: 22rpx;
  background: #fff;
  clip-path: polygon(60% 0%, 100% 40%, 35% 100%, 0% 100%, 0% 65%);
  /* 简化铅笔形状 */
}
.edit-mode-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #E65100;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.edit-mode-cancel {
  padding: 12rpx 28rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #888;
  flex-shrink: 0;
  white-space: nowrap;
}

/* ===== 驿站地址选择 ===== */
.pickup-location-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.pickup-loc-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  font-size: var(--font-md);
  color: var(--text-secondary);
  background: var(--card-inner-bg-1);
  transition: all .2s;
}

.pickup-loc-chip.active {
  border-color: var(--primary);
  background: var(--primary-bg);
  color: var(--primary);
  font-weight: 600;
}

.pickup-loc-chip:active {
  transform: scale(.96);
}

/* ===== 联系方式类型标签 ===== */
.contact-type-row {
  display: flex;
  gap: 14rpx;
}

.contact-type-chip {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 14rpx;
  border: 2rpx solid var(--border);
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--card-inner-bg-1);
  transition: all .2s;
}

.contact-type-chip.active {
  border-color: var(--primary);
  background: var(--primary-bg);
  color: var(--primary);
  font-weight: 600;
}

.contact-type-chip:active {
  transform: scale(.96);
}

/* ===== 报酬：自定义输入 + 价格私聊 ===== */
.price-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.price-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  background: var(--card-inner-bg-1);
  box-sizing: border-box;
}

.price-unit {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  margin-right: 8rpx;
  flex-shrink: 0;
}

.price-custom-input {
  flex: 1;
  font-size: var(--font-md);
  color: var(--text-primary);
}

.price-custom-input::placeholder {
  color: var(--text-placeholder);
  font-size: var(--font-sm);
}

.price-negotiable-chip {
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--card-inner-bg-1);
  white-space: nowrap;
  flex-shrink: 0;
  transition: all .2s;
}

.price-negotiable-chip.active {
  border-color: var(--primary);
  background: var(--primary-bg);
  color: var(--primary);
  font-weight: 600;
}

.price-negotiable-chip:active {
  transform: scale(.96);
}

/* ===== 卡片图片缩略图 ===== */
.card-image-grid {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
  align-items: center;
}

.card-image-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: var(--card-inner-bg-2);
  flex-shrink: 0;
}

.card-image-more {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: var(--card-inner-bg-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-hint);
  font-weight: 600;
  flex-shrink: 0;
}

/* ===== 剪贴板一键填入 ===== */
.clip-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.clip-input {
  flex: 1;
  min-height: 96rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  background: var(--card-inner-bg-1);
  font-size: var(--font-sm);
  color: var(--text-primary);
  box-sizing: border-box;
}

.clip-input::placeholder {
  color: var(--text-placeholder);
  font-size: var(--font-xs);
}

.clip-btn {
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  border: 3rpx solid var(--primary);
  background: var(--primary-bg);
  color: var(--primary);
  font-size: var(--font-md);
  font-weight: 700;
  flex-shrink: 0;
  line-height: 1;
  white-space: nowrap;
  margin-top: 10rpx;
}

.clip-btn:active {
  background: var(--primary);
  color: #fff;
  transform: scale(.95);
}

/* ===== 取件码多行 ===== */
.pickup-code-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.pickup-code-row:last-child {
  margin-bottom: 0;
}

.pickup-code-input {
  flex: 1;
  height: 68rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  background: var(--card-inner-bg-1);
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
}

.pickup-code-input::placeholder {
  color: var(--text-placeholder);
  font-size: var(--font-sm);
}

.code-add-btn,
.code-del-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.code-add-btn {
  background: var(--primary-bg);
}

.code-add-icon {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.code-add-icon::before,
.code-add-icon::after {
  content: '';
  position: absolute;
  background: var(--primary);
  border-radius: 3rpx;
}

.code-add-icon::before {
  left: 0;
  top: 50%;
  width: 100%;
  height: 4rpx;
  transform: translateY(-50%);
}

.code-add-icon::after {
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 100%;
  transform: translateX(-50%);
}

.code-del-btn {
  background: var(--danger-bg, #fff0f0);
}

.code-del-icon {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.code-del-icon::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  height: 4rpx;
  background: var(--danger, #ff4757);
  border-radius: 3rpx;
  transform: translateY(-50%);
}

/* ===== 一键填入联系方式 ===== */
.quick-fill-btn {
  margin-top: 16rpx;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: var(--primary, #576b95);
  text-align: right;
}

/* 联系方式胶囊输入框 */
.contact-input {
  width: 100%;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border);
  background: var(--card-inner-bg-1);
  font-size: var(--font-md);
  color: var(--text-primary);
  text-align: center;
  box-sizing: border-box;
}

.contact-input::placeholder {
  color: var(--text-placeholder);
  font-size: var(--font-sm);
}

/* 一键填充胶囊按钮 */
.quick-fill-capsule {
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-radius: 999rpx;
  border: 2rpx solid var(--primary);
  background: var(--primary-bg);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

/* 社区楼号胶囊输入框 */
.form-input-pill {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border);
  background: var(--card-inner-bg-1);
  font-size: var(--font-md);
  color: var(--text-primary);
  box-sizing: border-box;
  margin-left: 20rpx;
}

.form-input-pill::placeholder {
  color: var(--text-placeholder);
  font-size: var(--font-sm);
}

/* 补充说明输入框 - 加边框 */
.form-textarea {
  width: 100%;
  height: 140rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  background: var(--card-inner-bg-1);
  font-size: var(--font-md);
  color: var(--text-primary);
  margin-top: 12rpx;
  box-sizing: border-box;
}

.form-textarea::placeholder {
  color: var(--text-placeholder);
  font-size: var(--font-sm);
}

/* 微信消息通知 - 推荐标签 */
.notify-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.notify-recommend {
  font-size: 28rpx;
  font-weight: 600;
  color: #B8860B;
  background: #FFF8DC;
  border: 1rpx solid #FFD700;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  line-height: 1;
}

/* ===== 帮取弹窗 ===== */
.help-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity .25s;
}
.help-modal.show {
  opacity: 1;
  pointer-events: auto;
}
.help-modal-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.5);
}
.help-modal-card {
  position: relative;
  width: 640rpx;
  max-height: 82vh;
  overflow-y: auto;
  background: rgba(255,255,255,0.80);
  border-radius: 28rpx;
  padding: 48rpx 36rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
  transform: translateY(20rpx);
  transition: transform .25s;
}
.help-modal.show .help-modal-card {
  transform: translateY(0);
}
.hm-close {
  position: absolute;
  top: 20rpx; right: 20rpx;
  width: 48rpx; height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-hint);
  border-radius: 50%;
  background: var(--bg);
}
.hm-avatar {
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  background: var(--bg);
  margin-bottom: 14rpx;
}
.hm-nick {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}
.hm-title {
  font-size: var(--font-xs);
  color: var(--text-hint);
  margin-bottom: 20rpx;
}
.hm-detail-card {
  width: 100%;
  box-sizing: border-box;
  background: #f8fafc;
  border: 1rpx solid #eef2f7;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
}
.hm-detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}
.hm-detail-row:last-child {
  border-bottom: none;
}
.hm-detail-label {
  flex-shrink: 0;
  min-width: 160rpx;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 600;
}
.hm-detail-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #111827;
  font-weight: 600;
  word-break: break-all;
}
.hm-empty {
  color: #94a3b8;
  font-weight: 400;
}
.hm-note {
  color: #334155;
  font-weight: 500;
  line-height: 1.5;
}
.hm-detail-row-codes {
  align-items: flex-start;
}
.hm-code-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}
.hm-code-chip {
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #166534;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  font-family: 'SF Mono', 'Menlo', monospace;
}

.hm-divider {
  width: 100%;
  height: 1rpx;
  background: var(--border);
  margin: 20rpx 0;
}
.hm-contact-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 28rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  width: 100%;
  box-sizing: border-box;
}
.hm-contact-empty {
  background: #fef2f2;
}
.hm-contact-locked {
  background: rgba(255,149,0,.08);
  border: 1rpx dashed rgba(255,149,0,.3);
  border-radius: 12rpx;
}
.hm-contact-type {
  font-size: var(--font-xs);
  color: var(--text-hint);
}
.hm-contact-value {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
}
.hm-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}
.hm-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: var(--font-md);
  font-weight: 600;
  border: none;
  padding: 0;
}
.hm-btn::after {
  border: none;
}
.hm-btn-chat {
  background: var(--bg);
  color: var(--text-primary);
}
.hm-btn-take {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
}

/* ========================================
   ===== 我的任务 Tab 样式 =====
   ======================================== */

/* 统计栏 */
.task-stats-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 20rpx;
  padding: 8rpx;
  background: rgba(255,255,255,1.00) !important;
  border-radius: 40rpx;
  border: 1rpx solid var(--border-light);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.05);
  gap: 6rpx;
}

.task-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 16rpx 8rpx;
  border-radius: 34rpx;
  transition: all .25s ease;
  position: relative;
  cursor: pointer;
}

.task-stat-item.active {
  background: linear-gradient(135deg, #FF9500, #FF6B00);
}

.task-stat-item:active {
  transform: scale(.96);
}

.task-stat-item.active .ts-num {
  color: #fff;
}

.task-stat-item.active .ts-label {
  color: rgba(255,255,255,.85);
  font-weight: 600;
}

.ts-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary, #1a1a1a);
  line-height: 1.1;
}

.ts-label {
  font-size: 22rpx;
  color: var(--text-hint, #999);
  line-height: 1.1;
}

/* 底部指示条 — 大圆角胶囊 */
.task-stat-indicator {
  width: 48rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: transparent;
  transition: all .25s ease;
  margin-top: 2rpx;
}

.task-stat-item.active .task-stat-indicator {
  background: #fff;
}

/* 子标签切换栏 */
.task-sub-tabs {
  display: flex;
  padding: 0 32rpx;
  background: var(--card-bg, #fff);
  gap: 8rpx;
  border-bottom: 1rpx solid var(--border);
}

.task-sub-tab {
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-secondary, #666);
  position: relative;
  transition: all .2s;
  font-weight: 500;
}

.task-sub-tab.active {
  color: #6366f1;
  font-weight: 700;
}

.task-sub-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #6366f1;
}

/* 任务列表 */
.task-list {
  padding: 20rpx 24rpx;
}

/* 任务卡片 */
.task-card {
  background: var(--bg-card, rgba(255,255,255,0.70)) !important;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.task-card-done {}

.task-card-top {
  /* 可点击区域 */
}

.task-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.task-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #1a1a1a);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 任务状态标签 */
.task-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.badge-pending {
  background: #fef3c7;
  color: #d97706;
}

.badge-active {
  background: #dcfce7;
  color: #16a34a;
}

.badge-taken {
  background: #dbeafe;
  color: #2563eb;
}

.badge-done {
  background: #f3f4f6;
  color: #6b7280;
}

.badge-cancelled {
  background: #FEE2E2;
  color: #EF4444;
}

/* 倒计时 */
.task-countdown {
  font-size: 22rpx;
  color: #FF9500;
  font-weight: 600;
  margin-left: 12rpx;
}

/* 任务正文 */
.task-card-body {
  font-size: 28rpx;
  color: var(--text-secondary, #666);
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 发布者/时间行 */
.task-card-user-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--border, #f0f0f0);
  margin-top: 16rpx;
}

.task-card-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg, #f5f5f5);
  flex-shrink: 0;
}

.task-card-nick {
  font-size: 26rpx;
  color: var(--text-secondary, #666);
  font-weight: 500;
}

.task-card-time {
  font-size: 24rpx;
  color: var(--text-hint, #999);
  margin-left: auto;
}

/* 接单人信息 */
.task-taker-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 20rpx;
  background: #f0f4ff;
  border-radius: 14rpx;
  margin-bottom: 12rpx;
}

.task-taker-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e0e7ff;
  flex-shrink: 0;
}

.task-taker-detail {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.task-taker-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e40af;
}

.task-taker-status {
  font-size: 22rpx;
  color: #6366f1;
}

/* 操作按钮区 */
.task-card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.task-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all .2s;
}

.task-btn:active {
  transform: scale(.96);
  opacity: .85;
}

.task-btn-chat {
  background: var(--bg, #f5f5f5);
  color: var(--text-primary, #1a1a1a);
}

.task-btn-complete {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(34,197,94,.25);
}

.task-btn-close {
  background: #fef3c7;
  color: #d97706;
}

.task-btn-delete {
  background: #fee2e2;
  color: #ef4444;
}

.task-btn-edit {
  background: #e0e7ff;
  color: #6366f1;
}

/* 空状态 */
.task-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 0 120rpx;
  margin-top: 150px;
}

.task-empty-icon {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

/* CSS 剪贴板图标 */
.tei-clipboard {
  width: 80rpx;
  height: 96rpx;
  border: 4rpx solid #C7C7CC;
  border-radius: 12rpx;
  position: relative;
}
.tei-clip {
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 16rpx;
  border: 4rpx solid #C7C7CC;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
  background: var(--bg-page, #F5F5F7);
}
.tei-line {
  position: absolute;
  left: 14rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #D1D1D6;
}
.tei-l1 { top: 24rpx; width: 52rpx; }
.tei-l2 { top: 40rpx; width: 40rpx; }
.tei-l3 { top: 56rpx; width: 48rpx; }

.task-empty-text {
  font-size: 30rpx;
  color: var(--text-secondary, #666);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.task-empty-hint {
  font-size: 24rpx;
  color: var(--text-hint, #999);
}

/* 加载中 */
.task-loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: var(--text-hint, #999);
}

/* ===== 一键填入宿舍楼号 ===== */
.dorm-fill-row {
  padding: 12rpx 0 0;
}
.dorm-fill-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 149, 0, 0.08);
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 149, 0, 0.2);
}
.dorm-fill-icon {
  font-size: 28rpx;
}
.dorm-fill-label {
  font-size: 24rpx;
  color: #FF9500;
  font-weight: 500;
}
/* 资料未完善时的弱化提示态 */
.dorm-fill-btn-empty {
  background: rgba(150, 150, 150, 0.08);
  border-color: rgba(150, 150, 150, 0.18);
}
.dorm-fill-btn-empty .dorm-fill-label {
  color: #999;
}

/* ===== 报酬标签选择 ===== */
.price-tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0;
}
.price-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.48);
  border: 2rpx solid rgba(0,0,0,0.08);
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  transition: all 0.2s;
}
.price-tag.active {
  background: #FF9500;
  color: #fff;
  border-color: #FF9500;
  box-shadow: 0 4rpx 16rpx rgba(255,149,0,0.3);
}
.price-tag-custom {
  background: rgba(255,255,255,0.32);
  color: #666;
  font-size: 26rpx;
}
.price-tag-custom.active {
  background: #FF9500;
  color: #fff;
}
.price-custom-row {
  margin-top: 16rpx;
}
.price-custom-row .price-input-wrapper {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.64);
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  border: 2rpx solid rgba(0,0,0,0.06);
}
.price-custom-row .price-unit {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF9500;
  margin-right: 8rpx;
}
.price-custom-row .price-custom-input {
  flex: 1;
  font-size: 30rpx;
  height: 80rpx;
}
.price-negotiable-row {
  margin-top: 16rpx;
}

/* ===== 快递大厅卡片尺寸标签修复 ===== */
.ec-price-row {
  display: flex !important;
  flex-direction: row;
  flex-wrap: wrap;
}

/* 空状态上移 100rpx */
.empty-state {
  padding-top: 0 !important;
  margin-top: -100rpx;
}
.empty-icon-img { width:100rpx; height:100rpx; margin-bottom:24rpx; }

/* 页脚下移 20rpx */
.page-footer {
  margin-top: 40rpx;
}

/* express 页面专用：底部多空出 70rpx，让三个 Tab 滑到底部都有更多呼吸空间 */
.tab-bottom-space { height: 180rpx; }

/* ===== 我的任务详情弹窗（lost 同款） ===== */
.mtp-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: none;
  align-items: flex-end;
}
.mtp-mask.mtp-show {
  display: flex;
}
.mtp-popup {
  width: 100%;
  max-height: 88vh;
  background: #F5F5F7;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.mtp-nav {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  position: relative;
}
.mtp-nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mtp-nav-back .back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid #1C1C1E;
  border-bottom: 3rpx solid #1C1C1E;
  transform: rotate(45deg);
  margin-left: 4rpx;
}
.mtp-nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #1C1C1E);
}
.mtp-nav-badge {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.mtp-nav-placeholder {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}

.mtp-scroll {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}

.mtp-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}
.mtp-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #1C1C1E);
  display: block;
  margin-bottom: 16rpx;
  word-break: break-all;
}
.mtp-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.mtp-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #3A3A3C);
}

.mtp-section-title {
  font-size: 24rpx;
  color: var(--text-hint, #8E8E93);
  margin-bottom: 12rpx;
}
.mtp-desc {
  font-size: 28rpx;
  color: var(--text-primary, #1C1C1E);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.mtp-codes-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.mtp-code-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #FFF7E0, #FFE4A0);
  color: #B07A00;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  font-family: 'Courier New', monospace;
}

.mtp-user-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.mtp-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--card-inner-bg-3, #E5E5EA);
  flex-shrink: 0;
}
.mtp-user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.mtp-user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #1C1C1E);
}
.mtp-user-sub {
  font-size: 22rpx;
  color: var(--text-hint, #8E8E93);
}

.mtp-bottom-space {
  height: 32rpx;
}

.mtp-action-bar {
  display: flex;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}
.mtp-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.mtp-btn-primary { background: #00A693; color: #fff; }
.mtp-btn-primary:active { opacity: 0.7; }
.mtp-btn-success { background: #FF9500; color: #fff; }
.mtp-btn-success:active { opacity: 0.7; }
.mtp-btn-secondary { background: rgba(0, 0, 0, 0.06); color: var(--text-primary, #1C1C1E); }
.mtp-btn-secondary:active { background: rgba(0, 0, 0, 0.1); }
.mtp-btn-danger { background: rgba(255, 80, 80, 0.1); color: #FF5050; }
.mtp-btn-danger:active { opacity: 0.6; }

/* badge 颜色（与 task-badge 一致） */
.badge-active { background: rgba(255, 149, 0, 0.12); color: #FF9500; }
.badge-taken { background: rgba(0, 166, 147, 0.12); color: #00A693; }
.badge-done { background: rgba(150, 150, 150, 0.15); color: #999; }
.badge-pending { background: rgba(99, 102, 241, 0.12); color: #6366f1; }

/* 保存修改按钮（编辑模式） */
.publish-btn-edit {
  background: linear-gradient(135deg, #34C759, #22B14C) !important;
  box-shadow: 0 8rpx 24rpx rgba(52, 199, 89, 0.35) !important;
}
