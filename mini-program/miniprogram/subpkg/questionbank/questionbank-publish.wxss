/* 题库发布页 */
@import "../_shared/base.wxss";

page { background: #F5F5F7 !important; }
.page-module { background: transparent !important; height: 100vh; overflow: hidden; }

/* 背景 */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}
.page-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}

/* 导航栏 */
.shared-nav {
  position: fixed !important;
  top: 0; left: 0; right: 0;
  z-index: 100 !important;
  background: transparent !important;
  flex-shrink: 0 !important;
}
.nav-brand-center {
  flex: 1;
  justify-content: center;
}
.shared-nav .brand-name {
  color: #FF9500;
  font-weight: 600;
  font-size: 34rpx;
}
.nav-placeholder {
  width: 60rpx;
}

/* 表单滚动 */
.form-scroll {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1;
  padding: 20rpx 0 0;
  box-sizing: border-box;
}

/* ===== 表单区块 ===== */
.form-section {
  padding: 0 28rpx;
  margin-bottom: 28rpx;
}
.form-section:first-child {
  margin-top: 60rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.title-icon {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.title-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 400;
  margin-left: 4rpx;
}
.title-required {
  color: #FF3B30;
  font-size: 28rpx;
  font-weight: 700;
}

/* CSS 小图标 */
.camera-icon::before {
  content: '';
  display: block;
  width: 22rpx;
  height: 18rpx;
  border: 2rpx solid #FF9500;
  border-radius: 4rpx;
  position: relative;
}
.camera-icon::after {
  content: '';
  display: block;
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid #FF9500;
  border-radius: 50%;
  position: absolute;
  top: 10rpx;
  left: 12rpx;
}
.tag-icon::before {
  content: '';
  display: block;
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid #FF9500;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}
.info-icon::before {
  content: '';
  display: block;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #FF9500;
  border-radius: 4rpx;
}
.info-icon::after {
  content: '';
  display: block;
  width: 10rpx;
  height: 2rpx;
  background: #FF9500;
  position: absolute;
  top: 16rpx;
}
.label-icon::before {
  content: '';
  display: block;
  width: 16rpx;
  height: 10rpx;
  border: 2rpx solid #FF9500;
  border-radius: 3rpx;
}
.label-icon::after {
  content: '';
  display: block;
  width: 8rpx;
  height: 10rpx;
  border: 2rpx solid #FF9500;
  border-radius: 0 3rpx 3rpx 0;
  border-left: none;
  position: absolute;
  left: 26rpx;
}
.desc-icon::before {
  content: '';
  display: block;
  width: 18rpx;
  height: 16rpx;
  border: 2rpx solid #FF9500;
  border-radius: 3rpx;
}
.desc-icon::after {
  content: '';
  display: block;
  width: 10rpx;
  height: 2rpx;
  background: #FF9500;
  position: absolute;
  top: 12rpx;
  left: 10rpx;
}

/* ===== 图片上传 ===== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}
.img-preview {
  width: 100%;
  height: 100%;
}
.img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 0 16rpx 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.del-cross {
  width: 20rpx;
  height: 20rpx;
  position: relative;
}
.del-cross::before,
.del-cross::after {
  content: '';
  position: absolute;
  background: #fff;
  border-radius: 2rpx;
}
.del-cross::before {
  width: 20rpx;
  height: 3rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}
.del-cross::after {
  width: 3rpx;
  height: 20rpx;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

.img-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(255,149,0,0.4);
  background: rgba(255,149,0,0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.add-icon {
  width: 48rpx;
  height: 48rpx;
  position: relative;
}
.add-h,
.add-v {
  position: absolute;
  background: #FF9500;
  border-radius: 3rpx;
}
.add-h {
  width: 48rpx;
  height: 4rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}
.add-v {
  width: 4rpx;
  height: 48rpx;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}
.add-text {
  font-size: 22rpx;
  color: #FF9500;
}

/* ===== 分类选择 ===== */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.cat-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
  transition: all 0.2s;
  opacity: 0.85;
}
.cat-chip.active {
  background: rgba(255,149,0,0.12);
  border-color: #FF9500;
  opacity: 1;
}
.cat-emoji {
  font-size: 28rpx;
}
.cat-label {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}
.cat-chip.active .cat-label {
  color: #FF9500;
}

/* ===== 表单卡片 ===== */
.form-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--border-light);
  opacity: 0.85;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  gap: 16rpx;
}
.form-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  min-width: 120rpx;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  text-align: right;
}
.form-divider {
  height: 1rpx;
  background: var(--border-light);
}
.form-row-inline {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
}
.form-row-half {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* ===== 标签输入 ===== */
.tag-input-wrap {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
  min-height: 80rpx;
}
.tag-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  background: rgba(255,149,0,0.12);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #FF9500;
}
.tag-badge-del {
  font-size: 28rpx;
  color: #FF9500;
  opacity: 0.6;
  margin-left: 4rpx;
}
.tag-input {
  flex: 1;
  min-width: 200rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

/* 快捷标签 */
.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.quick-tag {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  border: 1rpx solid var(--border-light);
  opacity: 0.7;
}
.quick-tag.selected {
  color: #FF9500;
  border-color: rgba(255,149,0,0.3);
  background: rgba(255,149,0,0.08);
  opacity: 1;
}

/* ===== 描述文本域 ===== */
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  padding: 20rpx 0;
  box-sizing: border-box;
  line-height: 1.6;
}
.textarea-counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-secondary);
  padding: 0 0 16rpx;
  opacity: 0.6;
}

/* ===== 提交按钮 ===== */
.submit-area {
  padding: 20rpx 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.submit-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF9500, #FFB340);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255,149,0,0.3);
}
.submit-btn.disabled {
  opacity: 0.5;
}
.submit-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}
.submit-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  opacity: 0.6;
}

.form-bottom-space {
  height: 80rpx;
}
