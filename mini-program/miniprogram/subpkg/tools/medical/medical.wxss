/* pages/tools/medical/medical.wxss */

/* ===== 页面背景 ===== */
.page-tool {
  height: 100vh;
  overflow: hidden;
  background: transparent !important;
}

/* 渐变背景 */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

/* 状态栏填充 */
.page-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}

/* ===== 自定义导航 ===== */
.tool-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: transparent;
}
.tool-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}
.tool-nav .nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tool-nav .back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 4rpx;
}
/* 品牌区居中 + 鸭子图标 */
.tool-brand-center {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  justify-content: center;
}
.tool-nav .top-duck-icon {
  width: 36rpx;
  height: 36rpx;
}
.tool-brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.nav-placeholder {
  width: 60rpx;
}

.tool-scroll {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 1;
}

/* ===== Hero ===== */
.tool-hero {
  margin: 28rpx 24rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,.04);
}
.tool-hero-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
}
.tool-hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.tool-hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C1C1E;
}
.tool-hero-sub {
  font-size: 26rpx;
  color: #5C5C60;
  line-height: 1.5;
}

/* ===== 通用 section ===== */
.tool-section {
  margin: 32rpx 24rpx 0;
  opacity: 0.8;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,.04);
}
.tool-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
  padding: 28rpx 0 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.tool-section-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  background: #FF9500;
  border-radius: 4rpx;
}

/* ===== 步骤列表 ===== */
.step-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}
.step-item:last-child {
  border-bottom: none;
}
.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FF9500;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.step-text {
  flex: 1;
  font-size: 28rpx;
  color: #1C1C1E;
  line-height: 1.6;
  padding-top: 4rpx;
}

/* ===== 材料列表 ===== */
.material-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
  font-size: 28rpx;
  color: #1C1C1E;
}
.material-item:last-child {
  border-bottom: none;
}
.material-bullet {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF9500;
  flex-shrink: 0;
}

/* ===== FAQ 折叠 ===== */
.faq-item {
  border-bottom: 1rpx solid #F2F2F7;
}
.faq-item:last-child {
  border-bottom: none;
}
.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
}
.faq-arrow {
  font-size: 32rpx;
  color: #8E8E93;
  font-weight: 300;
  transition: transform .2s;
}
.faq-item.open .faq-arrow {
  transform: rotate(90deg);
}
.faq-a {
  font-size: 26rpx;
  color: #5C5C60;
  line-height: 1.6;
  padding-bottom: 28rpx;
}

/* ===== 联系方式按钮组 ===== */
.contact-list {
  margin: 32rpx 24rpx 0;
}
.contact-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  opacity: 0.8;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,.04);
}
.contact-item:active {
  background: #F8F8FA;
}
.contact-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.contact-label {
  font-size: 24rpx;
  color: #8E8E93;
}
.contact-value {
  font-size: 30rpx;
  color: #1C1C1E;
  font-weight: 600;
}
.contact-action {
  font-size: 26rpx;
  color: #FFFFFF;
  background: #FF9500;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.contact-item.info .contact-action {
  background: #C7C7CC;
}

/* ===== 底部 ===== */
.tool-footer {
  text-align: center;
  padding: 40rpx 24rpx;
}
.tool-footer text {
  font-size: 24rpx;
  color: #C7C7CC;
}
.bottom-safe {
  height: calc(40rpx + constant(safe-area-inset-bottom));
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* tap 反馈 */
.tap-shrink:active {
  transform: scale(0.97);
  opacity: .85;
}
