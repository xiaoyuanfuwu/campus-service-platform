<!-- pages/tools/tools.wxml — 实用功能聚合页 -->
<view class="page-tools">
  <view class="page-bg {{pageBgClass}}" style="{{pageBgStyle}}"></view>
  <view class="page-status-bg" style="height:{{statusBarHeight}}px;"></view>

  <!-- 自定义导航栏 -->
  <view class="tools-nav" style="padding-top:{{statusBarHeight}}px;">
    <view class="tools-nav-inner">
      <view class="nav-back tap-shrink" bindtap="goBack">
        <view class="back-arrow"></view>
      </view>
      <view class="tools-brand-center">
        <view class="top-duck-icon">
          <view class="td-head"></view>
          <view class="td-eye"></view>
          <view class="td-beak"></view>
          <view class="td-body"></view>
          <view class="td-wing"></view>
          <view class="td-tail"></view>
        </view>
        <text class="tools-brand-name">实用功能</text>
      </view>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <scroll-view class="tools-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="top:{{navBarHeight}}px;">

    <!-- 顶部介绍 -->
    <view class="tools-hero">
      <view class="tools-hero-title">校园实用工具箱</view>
      <view class="tools-hero-sub">校园卡 · 奖助 · 报销 · 证明 一站搞定</view>
    </view>

    <!-- 分组 -->
    <view class="tools-groups">
      <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
        <view class="tools-group">
          <view class="tg-header">
            <view class="tg-header-bar" style="background:{{group.iconBg}};"></view>
            <view class="tg-header-text">
              <text class="tg-title">{{group.title}}</text>
              <text class="tg-desc">{{group.desc}}</text>
            </view>
          </view>

          <view class="tg-list">
            <view
              wx:for="{{group.tools}}"
              wx:for-item="tool"
              wx:key="key"
              class="tg-item tap-shrink"
              data-key="{{tool.key}}"
              bindtap="onToolTap"
            >
              <view class="tg-icon-box" style="background:{{tool.iconBg}};">
                <image class="tg-icon-img" src="{{tool.icon}}" mode="aspectFit" wx:if="{{tool.icon}}"></image>
                <text class="tg-icon-fallback" wx:else=""><view class="svg-ico svg-ico-clipboard"></view></text>
              </view>

              <view class="tg-item-info">
                <view class="tg-item-row">
                  <text class="tg-item-name">{{tool.name}}</text>
                  <view class="tg-tag" wx:if="{{tool.tag}}">{{tool.tag}}</view>
                </view>
                <text class="tg-item-desc">{{tool.desc}}</text>
              </view>

              <text class="tg-item-arrow">›</text>
            </view>
          </view>
        </view>
      </block>

      <!-- 底部说明 -->
      <view class="tools-footer">
        <text>未找到需要的功能？提交反馈我们会优先开发</text>
      </view>
      <view class="bottom-safe"></view>
    </view>
  </scroll-view>
</view>
