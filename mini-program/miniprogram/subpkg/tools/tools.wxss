/* pages/tools/tools.wxss */

/* ===== 页面背景 ===== */
.page-tools {
  height: 100vh;
  overflow: hidden;
  background: transparent !important;
}

/* 渐变背景 */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

/* 状态栏填充 */
.page-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}

/* ===== 自定义导航 ===== */
.tools-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: transparent;
}
.tools-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}
.tools-nav .nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tools-nav .back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 4rpx;
}
/* 品牌区居中 + 鸭子图标 */
.tools-brand-center {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  justify-content: center;
}
.tools-nav .top-duck-icon {
  width: 36rpx;
  height: 36rpx;
}
.tools-brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.nav-placeholder {
  width: 60rpx;
}

/* ===== 滚动容器 ===== */
.tools-scroll {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 1;
}

/* ===== 顶部 hero ===== */
.tools-hero {
  padding: 40rpx 32rpx 24rpx;
}
.tools-hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1C1C1E;
  line-height: 1.3;
}
.tools-hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8E8E93;
}

/* ===== 分组 ===== */
.tools-groups {
  padding: 0 24rpx;
}
.tools-group {
  margin-bottom: 28rpx;
}
.tg-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}
.tg-header-bar {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
}
.tg-header-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.tg-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1C1C1E;
}
.tg-desc {
  font-size: 22rpx;
  color: #8E8E93;
}

/* ===== 列表 ===== */
.tg-list {
  opacity: 0.8;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.04);
}

.tg-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F2F2F7;
}
.tg-item:last-child {
  border-bottom: none;
}
.tg-item:active {
  background: #F8F8FA;
}

.tg-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.tg-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.tg-item-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.tg-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}
.tg-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #FF3B30;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.6;
}
.tg-item-desc {
  font-size: 24rpx;
  color: #8E8E93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tg-item-arrow {
  font-size: 40rpx;
  color: #C7C7CC;
  flex-shrink: 0;
  line-height: 1;
}

/* ===== 底部 ===== */
.tools-footer {
  text-align: center;
  padding: 24rpx 24rpx 0;
}
.tools-footer text {
  font-size: 24rpx;
  color: #C7C7CC;
}
.bottom-safe {
  height: calc(40rpx + constant(safe-area-inset-bottom));
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===========================================================
   工具图标（与首页 cli- 保持一致）
   =========================================================== */

.cli-card {
  width: 34rpx; height: 22rpx;
  border: 4rpx solid #1976D2;
  border-radius: 5rpx;
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
}
.cli-card-line {
  width: 14rpx; height: 3rpx;
  background: #1976D2;
  position: absolute;
  top: 16rpx; left: 50%;
  transform: translateX(-50%);
}
.cli-card-chip {
  width: 8rpx; height: 6rpx;
  background: #1976D2;
  border-radius: 1rpx;
  position: absolute;
  top: 8rpx; left: 6rpx;
}

.cli-money { width: 40rpx; height: 40rpx; position: relative; display: flex; align-items: center; justify-content: center; }
.cli-money-bill {
  width: 30rpx; height: 20rpx;
  border: 4rpx solid #FFB300;
  border-radius: 4rpx;
  position: relative;
}
.cli-money-bill::before {
  content: '¥';
  font-size: 18rpx;
  font-weight: 700;
  color: #FFB300;
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%,-50%);
}

.cli-medal { width: 40rpx; height: 40rpx; position: relative; display: flex; align-items: center; justify-content: center; }
.cli-medal-body {
  width: 22rpx; height: 22rpx;
  border: 4rpx solid #FFB300;
  border-radius: 50%;
  position: relative;
}
.cli-medal-body::before {
  content: '★';
  font-size: 14rpx;
  font-weight: 700;
  color: #FFB300;
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
}
.cli-medal-ribbon {
  width: 14rpx; height: 8rpx;
  background: #FFB300;
  position: absolute;
  bottom: 4rpx; left: 50%;
  transform: translateX(-50%);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
}

.cli-cross { width: 40rpx; height: 40rpx; position: relative; }
.cli-cross-h, .cli-cross-v {
  background: #E53935;
  position: absolute;
}
.cli-cross-h {
  width: 26rpx; height: 6rpx;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}
.cli-cross-v {
  width: 6rpx; height: 26rpx;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 2rpx;
}

.cli-doc {
  width: 26rpx; height: 32rpx;
  border: 4rpx solid #5C6BC0;
  border-radius: 4rpx;
  position: absolute;
  top: 4rpx; left: 50%;
  transform: translateX(-50%);
}
.cli-doc-line {
  height: 3rpx;
  background: #5C6BC0;
  position: absolute;
  left: 50%; transform: translateX(-50%);
}
.cli-doc-l1 { width: 16rpx; top: 16rpx; }
.cli-doc-l2 { width: 12rpx; top: 22rpx; }

.cli-photo { width: 40rpx; height: 40rpx; position: relative; display: flex; align-items: center; justify-content: center; }
.cli-photo-head {
  width: 16rpx; height: 16rpx;
  border: 4rpx solid #00838F;
  border-radius: 50%;
  position: absolute;
  top: 6rpx; left: 50%;
  transform: translateX(-50%);
}
.cli-photo-body {
  width: 26rpx; height: 14rpx;
  border: 4rpx solid #00838F;
  border-top: none;
  border-radius: 0 0 14rpx 14rpx;
  position: absolute;
  bottom: 4rpx; left: 50%;
  transform: translateX(-50%);
}

.cli-briefcase { width: 40rpx; height: 40rpx; position: relative; }
.cli-briefcase-top {
  width: 18rpx; height: 6rpx;
  border: 4rpx solid #455A64;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
  position: absolute;
  top: 4rpx; left: 50%;
  transform: translateX(-50%);
}
.cli-briefcase-body {
  width: 32rpx; height: 22rpx;
  border: 4rpx solid #455A64;
  border-radius: 4rpx;
  position: absolute;
  bottom: 4rpx; left: 50%;
  transform: translateX(-50%);
}

/* 通用：tap-shrink 反馈 */
.tap-shrink:active {
  transform: scale(0.97);
  opacity: .85;
}


.tg-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.tg-icon-fallback {
  font-size: 40rpx;
  line-height: 1;
}
