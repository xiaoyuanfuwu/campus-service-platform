/* pages/login/login.wxss */

/* 彻底禁止页面滚动 */
page { height: 100vh; overflow: hidden; }

.login-page {
  height: 100vh;
  background: transparent;
  display: flex; flex-direction: column; align-items: center;
  overflow: hidden;
}

/* 返回按钮 — 圆框 */
.back-btn {
  position: absolute; top: 100rpx; left: 32rpx;
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: var(--back-btn-bg);
  border: 2rpx solid var(--avatar-bg);
  display: flex; align-items: center; justify-content: center;
  z-index: 10;
}
.nav-back-icon {
  width: 20rpx; height: 20rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-right: 4rpx;
}

/* 顶部装饰 */
.login-header { width: 100%; height: 220rpx; position: relative; overflow: hidden; flex-shrink: 0; }
.header-circle { position: absolute; border-radius: 50%; background: var(--primary-bg); }
.circle-1 { width: 200rpx; height: 200rpx; top: -60rpx; right: -40rpx; }
.circle-2 { width: 140rpx; height: 140rpx; top: 80rpx; left: -30rpx; background: var(--primary-bg-light); }
.circle-3 { width: 80rpx; height: 80rpx; top: 40rpx; right: 120rpx; background: var(--primary-bg-mid); }

/* 主体 */
.login-body {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: center; width: 100%; padding: 0 20rpx; box-sizing: border-box;
  margin-top: -40rpx;
}

/* Logo */
.logo-section { display: flex; flex-direction: column; align-items: center; margin-bottom: 0; }

/* 鸭子简笔画 */
.duck-icon { position: relative; width: 120rpx; height: 120rpx; transform: scaleX(-1); }
.duck-head {
  position: absolute; top: 12rpx; left: 18rpx;
  width: 48rpx; height: 42rpx;
  border-radius: 50%;
  border: 4rpx solid var(--duck-color);
}
.duck-eye {
  position: absolute; top: 26rpx; right: 58rpx;
  width: 8rpx; height: 8rpx;
  border-radius: 50%; background: var(--duck-color);
}
.duck-beak {
  position: absolute; top: 32rpx; left: 4rpx;
  width: 28rpx; height: 12rpx;
  border-radius: 0 12rpx 12rpx 0;
  background: var(--warning);
}
.duck-body {
  position: absolute; bottom: 8rpx; left: 24rpx;
  width: 72rpx; height: 52rpx;
  border-radius: 50% 50% 40% 40%;
  border: 4rpx solid var(--duck-color);
  background: var(--primary-bg-strong);
}
.duck-wing {
  position: absolute; bottom: 20rpx; left: 60rpx;
  width: 32rpx; height: 22rpx;
  border-radius: 50%;
  border: 4rpx solid var(--duck-color);
  transform: rotate(-20deg);
}
.duck-tail {
  position: absolute; bottom: 32rpx; right: 6rpx;
  width: 18rpx; height: 18rpx;
  border-left: 4rpx solid var(--duck-color);
  border-bottom: 4rpx solid var(--duck-color);
  transform: rotate(45deg);
}

.app-name {
  font-size: 52rpx; font-weight: 700; color: var(--text-primary);
  margin-top: 32rpx; margin-bottom: 20rpx; letter-spacing: 6rpx;
  height: 60rpx;
}
.app-desc { font-size: 28rpx; color: var(--text-secondary); letter-spacing: 6rpx; opacity: .7; }

/* 按钮 */
.btn-section { width: 100%; display: flex; flex-direction: column; align-items: center; margin-top: 300rpx; }
.btn-wrap {
  width: 100%; position: relative; overflow: hidden; border-radius: 999rpx;
}
.login-btn {
  width: 100%; height: 104rpx; border-radius: 999rpx;
  background: var(--primary-gradient);
  color: var(--duck-color); font-size: 34rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  box-shadow: 0 8rpx 28rpx var(--primary-border-mid);
  box-sizing: border-box; padding: 0 36rpx;
  white-space: nowrap;
}

/* 滑动引导光效 */
.btn-shimmer {
  position: absolute; top: 0; left: -80%;
  width: 60%; height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0) 30%,
    rgba(255, 255, 255, 0.35) 50%,
    rgba(255, 255, 255, 0) 70%,
    transparent 100%
  );
  transform: skewX(-20deg);
  animation: btnShine 3.5s ease-in-out 1.5s infinite;
  pointer-events: none;
  border-radius: 999rpx;
}
@keyframes btnShine {
  0%   { left: -80%; }
  45%  { left: 120%; }
  100% { left: 120%; }
}
.login-btn:active { transform: scale(.97); opacity: .92; }
.login-btn::after { border: none; }
.lock-icon { position: relative; width: 32rpx; height: 36rpx; }
.li-lock-body {
  position: absolute; bottom: 0; left: 4rpx;
  width: 24rpx; height: 20rpx; border: 3rpx solid var(--duck-color); border-radius: 4rpx;
}
.li-lock-shackle {
  position: absolute; top: 0; left: 8rpx;
  width: 16rpx; height: 14rpx; border: 3rpx solid var(--duck-color);
  border-bottom: none; border-radius: 8rpx 8rpx 0 0;
}
.skip-row { margin-top: 36rpx; padding: 16rpx 32rpx; }
.skip-text { font-size: var(--font-sm); color: var(--text-hint); }

/* 协议勾选 — 登录按钮下方，字体小一号 */
.agree-row {
  display: flex; align-items: flex-start; justify-content: center;
  gap: 8rpx; margin-top: 28rpx; padding: 0 20rpx;
}
.agree-check {
  flex-shrink: 0; margin-top: 2rpx;
}
.check-box {
  width: 28rpx; height: 28rpx;
  border: 2rpx solid var(--text-hint);
  border-radius: 6rpx;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s;
}
.check-box.checked {
  background: var(--primary);
  border-color: var(--primary);
}
.check-tick {
  width: 12rpx; height: 7rpx;
  border-left: 2rpx solid #FFFFFF;
  border-bottom: 2rpx solid #FFFFFF;
  transform: rotate(-45deg);
  margin-top: -2rpx;
}
.agree-text-wrap {
  display: flex; flex-wrap: wrap; align-items: center; line-height: 1.5;
}
.agree-text { font-size: 20rpx; color: var(--text-hint); }
.agree-link { font-size: 20rpx; color: var(--primary); }

/* 未勾选协议弹窗 */
.agree-modal-mask {
  position: fixed; inset: 0; z-index: 400;
  background: var(--modal-overlay);
  display: flex; align-items: center; justify-content: center;
}
.agree-modal {
  width: 560rpx; background: var(--bg-card);
  border-radius: var(--radius-lg); padding: 48rpx 40rpx 36rpx;
  border: 1rpx solid var(--border-light);
  display: flex; flex-direction: column; align-items: center;
}
.am-icon {
  width: 96rpx; height: 96rpx; margin-bottom: 24rpx;
  display: flex; align-items: center; justify-content: center;
}
.am-circle {
  position: relative; width: 96rpx; height: 96rpx;
  border-radius: 50%; background: var(--primary-bg);
  display: flex; align-items: center; justify-content: center;
}
.am-doc {
  width: 40rpx; height: 48rpx;
  border: 3rpx solid var(--primary);
  border-radius: 6rpx;
  background: var(--bg-card);
}
.am-line-1 {
  position: absolute; top: 38rpx; left: 50%; transform: translateX(-50%);
  width: 18rpx; height: 3rpx; background: var(--primary); border-radius: 2rpx;
}
.am-line-2 {
  position: absolute; top: 46rpx; left: 50%; transform: translateX(-50%);
  width: 12rpx; height: 3rpx; background: var(--primary); border-radius: 2rpx;
}
.am-title {
  font-size: 34rpx; font-weight: 700; color: var(--text-primary);
  margin-bottom: 16rpx;
}
.am-desc {
  font-size: 26rpx; color: var(--text-secondary); text-align: center;
  line-height: 1.7; margin-bottom: 20rpx;
}
.am-links {
  display: flex; align-items: center; gap: 4rpx; margin-bottom: 36rpx;
}
.am-link { font-size: 26rpx; color: var(--primary); }
.am-link-sep { font-size: 26rpx; color: var(--text-hint); }
.am-btns {
  width: 100%; display: flex; gap: 20rpx;
}
.am-btn-disagree {
  flex: 1; height: 80rpx; line-height: 80rpx;
  text-align: center; border-radius: 999rpx;
  background: var(--bg-page); color: var(--text-hint);
  font-size: 28rpx;
}
.am-btn-agree {
  flex: 1; height: 80rpx; line-height: 80rpx;
  text-align: center; border-radius: 999rpx;
  background: var(--primary); color: #fff;
  font-size: 28rpx; font-weight: 600;
}

/* 完善资料弹窗 */
.profile-modal-mask { position: fixed; inset: 0; z-index: 300; background: var(--modal-overlay); display: flex; align-items: center; justify-content: center; }
.profile-modal { width: 580rpx; background: var(--bg-card); border-radius: var(--radius-lg); padding: 48rpx 40rpx 40rpx; border: 1rpx solid var(--border-light); display: flex; flex-direction: column; align-items: center; }
.pm-title { font-size: var(--font-xl); font-weight: 700; color: var(--text-primary); margin-bottom: 8rpx; }
.pm-desc { font-size: var(--font-sm); color: var(--text-hint); margin-bottom: 36rpx; }
.pm-avatar-wrap { position: relative; display: inline-flex; margin-bottom: 12rpx; }
.pm-avatar-btn { width: 140rpx; height: 140rpx; padding: 0; margin: 0; background: transparent; border: none; border-radius: 50%; overflow: visible; line-height: 1; display: flex; align-items: center; justify-content: center; }
.pm-avatar-btn::after { border: none; }
.pm-avatar-badge {
  position: absolute; bottom: 0; right: 0;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--primary); display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 12rpx var(--primary-border-mid);
  z-index: 2;
}
.pm-avatar-img { width: 140rpx; height: 140rpx; border-radius: 50%; border: 4rpx solid var(--primary); }
.pm-avatar-placeholder { width: 140rpx; height: 140rpx; border-radius: 50%; background: var(--card-inner-bg-3); border: 4rpx solid var(--border); display: flex; align-items: center; justify-content: center; }
.pm-avatar-hint { font-size: 22rpx; color: var(--text-hint); margin-bottom: 28rpx; }
.pm-name-input { width: 100%; height: 88rpx; background: var(--input-bg); border: 2rpx solid var(--border); border-radius: var(--radius-lg); padding: 0 32rpx; font-size: var(--font-md); color: var(--text-primary); text-align: center; box-sizing: border-box; margin-bottom: 32rpx; }
.pm-placeholder { color: var(--text-placeholder); }
.pm-btns { width: 100%; display: flex; gap: 16rpx; }
.pm-btn-skip { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 999rpx; background: var(--bg-page); color: var(--text-hint); font-size: var(--font-sm); }
.pm-btn-confirm { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 999rpx; background: var(--primary); color: #fff; font-size: var(--font-sm); font-weight: 600; }
.person-icon { position: relative; width: 64rpx; height: 64rpx; }
.pi-head {
  position: absolute; top: 4rpx; left: 50%; transform: translateX(-50%);
  width: 28rpx; height: 28rpx; border-radius: 50%; border: 4rpx solid var(--text-hint);
}
.pi-body {
  position: absolute; bottom: 4rpx; left: 50%; transform: translateX(-50%);
  width: 44rpx; height: 28rpx; border-radius: 22rpx 22rpx 6rpx 6rpx;
  border: 4rpx solid var(--text-hint); border-top: none;
}
.avatar-badge {
  position: absolute; bottom: -16rpx; right: -16rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--primary); display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 12rpx var(--primary-border-mid);
}
.badge-plus-h, .badge-plus-v { position: absolute; background: var(--duck-color); border-radius: 2rpx; }
.badge-plus-h { width: 16rpx; height: 3rpx; }
.badge-plus-v { width: 3rpx; height: 16rpx; }
