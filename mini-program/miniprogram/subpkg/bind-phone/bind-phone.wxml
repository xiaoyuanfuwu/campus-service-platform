<!-- pages/bind-phone/bind-phone.wxml -->
<view class="page-bind-phone">
  <view class="page-bg {{pageBgClass}}" style="{{pageBgStyle}}"></view>
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: 44px;">
    <view class="nav-back" bindtap="goBack"><view class="nav-back-icon"></view></view>
    <text class="nav-title">绑定手机号</text>
    <view class="nav-placeholder"></view>
  </view>
  <view class="content" style="padding-top: {{navBarHeight}}px;">
    <view class="glass-card form-card">
      <view class="form-item">
        <text class="label">手机号</text>
        <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
      </view>
      <view class="form-item code-row">
        <input class="input" type="number" maxlength="6" placeholder="验证码" value="{{code}}" bindinput="onCodeInput" />
        <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode">{{countdown > 0 ? countdown + 's' : '发送验证码'}}</view>
      </view>
    </view>
    <view class="tips">绑定手机号后可使用手机号登录，提升账号安全性</view>
    <view class="btn-primary {{submitting ? 'disabled' : ''}}" bindtap="onBind">{{submitting ? '绑定中...' : '确认绑定'}}</view>
  </view>
</view>
