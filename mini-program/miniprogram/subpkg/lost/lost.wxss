
page { background: #F5F5F7 !important; }
.page-module { background: transparent !important; }
.shared-nav { background: transparent !important; }

.msg-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}
.msg-top-bar {
  position: fixed;
  top: 0;
  z-index: 100;
  background: transparent;
  left: 0; right: 0;
}
.msg-top-bar-spacer {}
.msg-top-bar .top-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}
.msg-top-bar .brand-logo {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.msg-top-bar .nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.msg-top-bar .back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 4rpx;
}
.msg-top-bar .brand-logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}
.msg-top-bar .brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.msg-top-bar .top-duck-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.msg-top-bar .td-head { position: absolute; top: 4rpx; left: 6rpx; width: 22rpx; height: 22rpx; background: #FFC54A; border-radius: 50%; }
.msg-top-bar .td-eye { position: absolute; top: 12rpx; left: 18rpx; width: 4rpx; height: 4rpx; background: #333; border-radius: 50%; }
.msg-top-bar .td-beak { position: absolute; top: 18rpx; left: 24rpx; width: 8rpx; height: 5rpx; background: #FF9500; border-radius: 0 4rpx 4rpx 0; }
.msg-top-bar .td-body { position: absolute; bottom: 0; left: 4rpx; width: 28rpx; height: 18rpx; background: #FFFFFF; border-radius: 14rpx 14rpx 12rpx 12rpx; border: 2rpx solid #FFC54A; box-sizing: border-box; }
.msg-top-bar .td-wing { position: absolute; bottom: 6rpx; left: 14rpx; width: 12rpx; height: 8rpx; background: #FFE0A0; border-radius: 6rpx; }
.msg-top-bar .td-tail { position: absolute; bottom: 8rpx; left: 0; width: 6rpx; height: 6rpx; background: #FFFFFF; border: 2rpx solid #FFC54A; border-radius: 50%; box-sizing: border-box; }



/* 导航栏右侧占位 + 去掉 tab-scroll 顶部空隙 */
.nav-placeholder { width: 60rpx; }
.nav-right { display: flex; align-items: center; gap: 12rpx; }
.tab-scroll { padding-top: 0 !important; }

/* pages/lost/lost.wxss */

/* ===== 图片上传区域 ===== */
.image-upload-area {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

/* 已选图片网格 */
.image-preview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  flex: 1;
}

.image-preview-item {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--card-inner-bg-2);
}

.preview-thumb {
  width: 100%;
  height: 100%;
}

.preview-delete {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0,0,0,.55);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.preview-delete .delete-x {
  position: relative;
  width: 18rpx;
  height: 18rpx;
}

.preview-delete .delete-x::before,
.preview-delete .delete-x::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 3rpx;
  background: #fff;
  border-radius: 2rpx;
}

.preview-delete .delete-x::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.preview-delete .delete-x::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* 添加按钮 */
.image-add-btn {
  width: 156rpx;
  height: 156rpx;
  border-radius: 16rpx;
  border: 3rpx dashed var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--card-inner-bg-1);
  transition: all .2s;
}

.image-add-btn:active {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.image-add-btn .add-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.image-add-btn .add-icon::before,
.image-add-btn .add-icon::after {
  content: '';
  position: absolute;
  background: var(--text-hint);
  border-radius: 3rpx;
}

.image-add-btn .add-icon::before {
  top: 50%;
  left: 0;
  width: 100%;
  height: 4rpx;
  transform: translateY(-50%);
}

.image-add-btn .add-icon::after {
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 100%;
  transform: translateX(-50%);
}

.add-text {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 标签提示文本 */
.label-hint {
  font-size: 22rpx;
  color: var(--text-placeholder);
  margin-left: 8rpx;
  font-weight: 400;
}

/* ===== 卡片图片缩略图 ===== */
.card-image-grid {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
  align-items: center;
}

.card-image-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: var(--card-inner-bg-2);
  flex-shrink: 0;
}

.card-image-more {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: var(--card-inner-bg-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-hint);
  font-weight: 600;
  flex-shrink: 0;
}

/* 页脚下移 60rpx */
.page-footer {
  margin-top: 60rpx;
}
/* ===== 底部 TabBar（PNG 图标，与 express 同款） ===== */
.shared-tabbar {
  position: fixed !important;
  left: 0; right: 0;
  bottom: 60rpx;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  border-top: none !important;
  padding: 0;
  pointer-events: none;
}
.tabbar-card {
  width: 76%;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 56rpx;
  box-shadow: 0 12rpx 32rpx rgba(80, 117, 204, 0.12), 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  pointer-events: auto;
  backdrop-filter: saturate(180%) blur(20rpx);
  -webkit-backdrop-filter: saturate(180%) blur(20rpx);
}
.tabbar-items {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10rpx 8rpx;
}
.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 24rpx;
  border-radius: 36rpx;
  transition: all .25s;
  position: relative;
  min-width: 110rpx;
}
.tabbar-item.active {
  background: rgba(255, 149, 0, 0.12);
}
.tb-label {
  font-size: 20rpx;
  color: #B3B3B3;
  transition: color .25s;
  letter-spacing: 0.5rpx;
}
.tabbar-item.active .tb-label {
  color: #FF9500;
  font-weight: 600;
}
.tb-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tb-icon-img {
  width: 44rpx;
  height: 44rpx;
}

/* 表单标题行 */
.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.form-label-text {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
}
.form-label-hint {
  font-size: 22rpx;
  color: var(--text-placeholder);
  margin-left: 8rpx;
  font-weight: 400;
}

/* ===== 联系方式（express 同款） ===== */
.contact-type-row {
  display: flex;
  gap: 14rpx;
}
.contact-type-chip {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 14rpx;
  border: 2rpx solid var(--border);
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--card-inner-bg-1);
  transition: all .2s;
}
.contact-type-chip.active {
  border-color: var(--primary);
  background: var(--primary-bg);
  color: var(--primary);
  font-weight: 600;
}
.contact-type-chip:active {
  transform: scale(.96);
}

/* 联系方式胶囊输入框 */
.contact-input {
  width: 100%;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border);
  background: var(--card-inner-bg-1);
  font-size: var(--font-md);
  color: var(--text-primary);
  text-align: center;
  box-sizing: border-box;
  margin-top: 0 !important;
}
.contact-input::placeholder {
  color: var(--text-placeholder);
  font-size: var(--font-sm);
}

/* 一键填充胶囊按钮 */
.quick-fill-capsule {
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-radius: 999rpx;
  border: 2rpx solid var(--primary);
  background: var(--primary-bg);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}
.quick-fill-capsule:active {
  opacity: 0.6;
}

/* ===== 报酬标签选择 ===== */
.price-tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0;
}
.price-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.48);
  border: 2rpx solid rgba(0,0,0,0.08);
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  transition: all 0.2s;
}
.price-tag.active {
  background: #FF9500;
  color: #fff;
  border-color: #FF9500;
  box-shadow: 0 4rpx 16rpx rgba(255,149,0,0.3);
}
.price-tag:active {
  transform: scale(.96);
}
.price-tag-custom {
  background: rgba(255,255,255,0.32);
  color: #666;
  font-size: 26rpx;
}
.price-tag-custom.active {
  background: #FF9500;
  color: #fff;
}
.price-custom-row {
  margin-top: 16rpx;
}
.price-custom-row .price-input-wrapper {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.64);
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  border: 2rpx solid rgba(0,0,0,0.06);
  box-sizing: border-box;
}
.price-custom-row .price-unit {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF9500;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.price-custom-row .price-custom-input {
  flex: 1;
  font-size: 30rpx;
  height: 80rpx;
  color: #333;
}
.price-negotiable-row {
  margin-top: 16rpx;
}
.price-negotiable-chip {
  display: inline-block;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--card-inner-bg-1);
  white-space: nowrap;
  transition: all .2s;
}
.price-negotiable-chip.active {
  border-color: #FF9500;
  background: rgba(255,149,0,0.1);
  color: #FF9500;
  font-weight: 600;
}
.price-negotiable-chip:active {
  transform: scale(.96);
}

/* 我的页面（lost / rental 共用样式） */
@import "../_shared/mine-tab.wxss";

/* 弹窗：详情 */
.overlay-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.detail-popup {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.popup-nav {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
  position: relative;
}
.popup-nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.popup-nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.dp-nav-status {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.dp-nav-active { background: rgba(0, 166, 147, 0.12); color: #00A693; }
.dp-nav-done { background: rgba(150, 150, 150, 0.15); color: #999; }

.popup-scroll {
  flex: 1;
  padding: 16rpx 24rpx;
  overflow-y: auto;
}
.dp-card {
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(0,0,0,0.06);
}
.dp-title-row { display: flex; align-items: center; gap: 12rpx; }
.dp-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.dp-type-row { margin-top: 12rpx; }
.dp-location { font-size: 26rpx; color: var(--text-hint); }
.dp-section-title { font-size: 24rpx; color: var(--text-hint); margin-bottom: 8rpx; }
.dp-desc { font-size: 28rpx; color: var(--text-primary); line-height: 1.6; white-space: pre-wrap; }

.dp-image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.dp-grid-cell {
  width: calc((100% - 24rpx) / 3);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
}
.dp-grid-image { width: 100%; height: 100%; }

.dp-bottom-space { height: 32rpx; }

.dp-action-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0,0,0,0.06);
}
.dp-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.dp-btn-close { background: rgba(255, 80, 80, 0.1); color: #FF5050; }
.dp-btn-close:active { opacity: 0.6; }
.dp-btn-primary { background: #00A693; color: #fff; }
.dp-btn-primary:active { opacity: 0.7; }

.publish-btn {
  margin-bottom: 200rpx;
}

.tab-bottom-space { height: 180rpx; }
