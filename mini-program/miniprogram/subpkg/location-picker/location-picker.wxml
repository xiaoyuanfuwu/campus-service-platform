<!-- pages/location-picker/location-picker.wxml -->
<view class="page-detail-info">
  <view class="page-bg {{pageBgClass}}" style="{{pageBgStyle}}"></view>
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: 44px;">
    <view class="nav-back" bindtap="goBack"><view class="nav-back-icon"></view></view>
    <text class="nav-title">选择地点</text>
    <view class="nav-placeholder"></view>
  </view>
  <view class="content" style="padding-top: {{navBarHeight}}px;">
    <view class="search-box">
      <input class="search-input" placeholder="搜索地点..." value="{{keyword}}" bindinput="onInput" focus="{{true}}" />
    </view>
    <scroll-view scroll-y class="loc-list">
      <view wx:for="{{locations}}" wx:key="name" class="loc-item" data-item="{{item}}" bindtap="onSelect">
        <text class="loc-name">{{item.name}}</text>
        <text class="loc-addr" wx:if="{{item.address}}">{{item.address}}</text>
      </view>
      <view wx:if="{{!loading && locations.length === 0}}" class="empty">未找到相关地点</view>
    </scroll-view>
  </view>
</view>
