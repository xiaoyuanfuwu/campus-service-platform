/* pages/location-picker/location-picker.wxss */
.page-detail-info { min-height: 100vh; background: transparent; }
.nav-bar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; background: var(--nav-bg); backdrop-filter: blur(20rpx); -webkit-backdrop-filter: blur(20rpx); border-bottom: 1rpx solid var(--border-light); }
.nav-back { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.nav-back-icon { width: 24rpx; height: 24rpx; border-left: 4rpx solid var(--text-primary); border-bottom: 4rpx solid var(--text-primary); transform: rotate(45deg); margin-left: 8rpx; }
.nav-title { font-size: var(--font-lg); font-weight: 600; flex: 1; text-align: center; color: var(--text-primary); }
.nav-placeholder { width: 72rpx; flex-shrink: 0; }
.content { min-height: 100vh; }
.search-box { padding: 24rpx; }
.search-input { background: var(--bg-card); border: 1rpx solid var(--border); border-radius: 999rpx; padding: 24rpx 32rpx; font-size: var(--font-md); color: var(--text-primary); }
.loc-list { padding: 0 24rpx; height: calc(100vh - 200rpx); }
.loc-item { padding: 28rpx 0; border-bottom: 1rpx solid var(--border-light); }
.loc-name { font-size: var(--font-md); color: var(--text-primary); display: block; }
.loc-addr { font-size: var(--font-xs); color: var(--text-hint); display: block; margin-top: 4rpx; }
.empty { text-align: center; padding: 80rpx; color: var(--text-hint); }
