/* subpkg/_shared/mine-tab.wxss — 我的页面样式（lost / rental 共用） */
/* 在页面的 wxss 中用 @import "../_shared/mine-tab.wxss"; 引入 */

.mine-scroll { padding-top: 0 !important; }
.mine-page {
  padding: 24rpx 24rpx 0;
  min-height: 100%;
}

/* 我的页面标题 */
.mine-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 8rpx 24rpx;
}
.mine-title-icon { font-size: 40rpx; }
.mine-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 用户信息 */
.mine-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  backdrop-filter: blur(10rpx);
}
.mine-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--card-inner-bg-2);
  flex-shrink: 0;
}
.mine-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.mine-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.mine-school {
  font-size: 24rpx;
  color: var(--text-hint);
}
.mine-edit {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #00A693;
  background: rgba(0, 166, 147, 0.1);
  border-radius: 20rpx;
  flex-shrink: 0;
}
.mine-edit:active { opacity: 0.6; }

/* 统计 */
.mine-stats {
  display: flex;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
  backdrop-filter: blur(10rpx);
}
.mine-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
}
.mine-stat:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1rpx;
  background: var(--border);
}
.ms-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.ms-label {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 分段标题 */
.mine-section {
  margin-bottom: 24rpx;
}
.mine-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}
.mine-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.mine-section-more {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 空状态 */
.mine-loading, .mine-empty {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
  font-size: 26rpx;
}

/* 卡片列表 */
.mine-card-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.mine-card {
  background: rgba(255, 255, 255, 0.75);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  backdrop-filter: blur(8rpx);
  transition: transform .15s;
}
.mine-card:active { transform: scale(.98); }

.mc-main { display: flex; flex-direction: column; gap: 10rpx; }
.mc-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.mc-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mc-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}
.mc-badge-active { background: rgba(0, 166, 147, 0.12); color: #00A693; }
.mc-badge-done { background: rgba(150, 150, 150, 0.15); color: #999; }
.mc-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.mc-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}
.mc-time {
  font-size: 22rpx;
  color: var(--text-placeholder);
}
.mc-actions { display: flex; gap: 8rpx; }
.mc-btn {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.06);
  color: var(--text-secondary);
}
.mc-btn:active { opacity: 0.6; }
.mc-btn-danger { background: rgba(255, 80, 80, 0.1); color: #FF5050; }

/* 工具箱入口 */
.menu-group {
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  backdrop-filter: blur(10rpx);
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  transition: background .15s;
}
.menu-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
}
.menu-item:active { background: rgba(0,0,0,0.03); }
.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--card-inner-bg-1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.menu-icon { font-size: 28rpx; }
.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}
.menu-arrow {
  font-size: 28rpx;
  color: var(--text-placeholder);
}


/* ========== Forum 风格：顶部双 Tab 切换 ========== */
.mine-subtap-bar {
  display: flex;
  background: linear-gradient(135deg, #34C759, #30D158);
  border-radius: 20rpx;
  padding: 8rpx;
  margin: 0 0 24rpx;
  gap: 4rpx;
}
.mine-subtap-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 8rpx 12rpx;
  border-radius: 14rpx;
  position: relative;
  transition: all .2s;
}
.mine-subtap-item .mine-subtap-num {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255,255,255,.65);
  line-height: 1;
  margin-bottom: 4rpx;
}
.mine-subtap-item .mine-subtap-label {
  font-size: 24rpx;
  color: rgba(255,255,255,.55);
  line-height: 1;
}
.mine-subtap-indicator {
  display: none;
}
.mine-subtap-item.active {
  background: rgba(255,255,255,.25);
  backdrop-filter: blur(4rpx);
}
.mine-subtap-item.active .mine-subtap-num { color: #fff; }
.mine-subtap-item.active .mine-subtap-label {
  color: rgba(255,255,255,.9);
  font-weight: 600;
}

/* 空状态（forum 风格） */
.mine-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 40rpx;
  gap: 16rpx;
}
.mine-empty-icon { font-size: 72rpx; }
.mine-empty-text {
  font-size: 28rpx;
  color: var(--text-hint);
}

/* 列表（forum 风格） */
.mine-list { padding: 0 24rpx 24rpx; }
.mine-list-card {
  background: rgba(255,255,255,.82);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  backdrop-filter: blur(8rpx);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
  transition: transform .15s;
}
.mine-list-card:active { transform: scale(.97); }

.mine-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.mine-card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.mine-card-badge {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.mine-card-badge-active { background: rgba(52,199,89,.15); color: #34C759; }
.mine-card-badge-done { background: rgba(150,150,150,.15); color: #999; }

.mine-card-content {
  font-size: 26rpx;
  color: var(--text-hint);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 16rpx;
}

.mine-card-user-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.mine-card-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--card-inner-bg-2);
}
.mine-card-nick {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mine-card-time {
  font-size: 22rpx;
  color: var(--text-placeholder);
  flex-shrink: 0;
}
