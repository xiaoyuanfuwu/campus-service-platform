/* subpkg/achievement-detail/achievement-detail.wxss — 沿用 achievement 页背景+topbar 样式 */

/* ===== 页面背景 ===== */
.page-ach-detail {
  height: 100vh;
  overflow: hidden;
  background: transparent !important;
}

/* 渐变背景 */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

/* 状态栏填充 */
.page-status-bg {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 99;
  background: transparent;
}

/* ===== 自定义导航（沿用 achievement 页面样式） ===== */
.shared-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: transparent;
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}
.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid #1C1C1E;
  border-bottom: 3rpx solid #1C1C1E;
  transform: rotate(45deg);
  margin-left: 4rpx;
}
.nav-brand {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  justify-content: center;
}
.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9500;
  letter-spacing: 2rpx;
  white-space: nowrap;
}
.nav-right {
  width: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.nav-progress {
  font-size: 22rpx;
  color: #8E8E93;
  font-weight: 600;
}

/* 鸭子图标（与 achievement 页面完全一致） */
.top-duck-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}
.td-head {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  background: #FFD60A;
  border-radius: 50%;
  top: 0; left: 6rpx;
}
.td-eye {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: #1C1C1E;
  border-radius: 50%;
  top: 8rpx; right: 8rpx;
}
.td-beak {
  position: absolute;
  width: 14rpx;
  height: 8rpx;
  background: #FF9500;
  border-radius: 50%;
  top: 14rpx; right: -2rpx;
}
.td-body {
  position: absolute;
  width: 32rpx;
  height: 20rpx;
  background: #FFD60A;
  border-radius: 50%;
  bottom: 0; left: 4rpx;
}
.td-wing {
  position: absolute;
  width: 16rpx;
  height: 14rpx;
  background: #FF9500;
  border-radius: 50%;
  top: 14rpx; left: 0;
}
.td-tail {
  position: absolute;
  width: 10rpx;
  height: 8rpx;
  background: #FF9500;
  border-radius: 0 50% 50% 0;
  top: 10rpx; left: -4rpx;
}

/* ===== 滚动容器 ===== */
.ad-scroll {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 1;
}

/* 提示 */
.ad-tip {
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  background: rgba(255,255,255,.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,.4);
  border-radius: 20rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.03);
}
.ad-tip-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.ad-tip-text {
  font-size: 20rpx;
  color: #8E8E93;
  line-height: 1.6;
}

/* 成就网格 */
.ad-grid {
  padding: 20rpx 24rpx 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.ad-card {
  background: rgba(255,255,255,.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,.5);
  border-radius: 24rpx;
  padding: 24rpx 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
  transition: transform .15s ease;
}
.ad-card:active {
  transform: scale(.96);
}
.ad-card-leadership { border-top: 4rpx solid #FFB74D; }
.ad-card-certificate { border-top: 4rpx solid #81C784; }
.ad-card-academic { border-top: 4rpx solid #64B5F6; }
.ad-card-competition { border-top: 4rpx solid #F06292; }

.ad-card-locked {
  background: rgba(255,255,255,.5);
  border-color: rgba(255,255,255,.3);
}

/* 状态角标 */
.ad-status-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 16rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 600;
  z-index: 2;
}
.ad-badge-approved {
  background: rgba(76, 175, 80, 0.12);
  color: #4CAF50;
}
.ad-badge-pending {
  background: rgba(255, 152, 0, 0.12);
  color: #FF9800;
}
.ad-badge-rejected {
  background: rgba(244, 67, 54, 0.12);
  color: #F44336;
}
.ad-badge-none {
  background: rgba(158, 158, 158, 0.12);
  color: #9E9E9E;
}

/* 图标容器 */
.ad-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  margin: 8rpx 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: filter .3s ease, opacity .3s ease;
}
.ad-icon-wrap .svg-ico {
  width: 48rpx;
  height: 48rpx;
}
.ad-icon-dim {
  filter: grayscale(1) opacity(0.35);
}

/* ===== SVG 线条图标定义（与 achievement.wxss 共用同一套） ===== */
.svg-ico {
  display: inline-block;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* 名称 */
.ad-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1C1C1E;
  text-align: center;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ad-desc {
  font-size: 17rpx;
  color: #8E8E93;
  text-align: center;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-safe {
  height: 60rpx;
}

/* ===== 上传弹窗 ===== */
.upload-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.upload-modal {
  width: 100%;
  max-width: 600rpx;
  background: #FFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,.15);
}
.upload-header {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F5F5F7;
}
.upload-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 800;
  color: #1C1C1E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.upload-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.upload-close-icon {
  width: 28rpx;
  height: 28rpx;
}

.upload-body {
  padding: 24rpx 28rpx 28rpx;
}

/* 图片预览 */
.upload-preview {
  width: 100%;
  height: 360rpx;
  background: #F5F5F7;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx dashed #D1D1D6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-img {
  width: 100%;
  height: 100%;
}
.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.up-icon {
  width: 64rpx;
  height: 64rpx;
}
.up-text {
  font-size: 20rpx;
  color: #AEAEB2;
}

/* 补充说明 */
.upload-field {
  margin-top: 20rpx;
}
.uf-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #3A3A3C;
  display: block;
  margin-bottom: 10rpx;
}
.uf-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx;
  font-size: 22rpx;
  color: #1C1C1E;
  background: #F5F5F7;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* 提交按钮 */
.upload-submit {
  margin-top: 24rpx;
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #FF9500, #FF6B00);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  transition: opacity .15s ease;
}
.upload-submit:active {
  opacity: 0.8;
}

.tap-shrink {
  transition: transform .12s ease;
}
.tap-shrink:active {
  transform: scale(.97);
}

