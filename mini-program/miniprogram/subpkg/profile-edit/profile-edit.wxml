<!-- pages/profile-edit/profile-edit.wxml -->
<view class="page-edit">
  <view class="page-bg {{pageBgClass}}" style="{{pageBgStyle}}"></view>
  <!-- 状态栏背景 -->
  <view class="profile-status-bg" style="height: {{statusBarHeight}}px;"></view>
  <!-- 顶部栏（带小鸭logo + 返回） -->
  <view class="profile-top-bar" style="padding-top:{{statusBarHeight}}px;">
    <view class="top-bar-inner">
      <view class="nav-back" bindtap="goBack"><view class="nav-back-icon"></view></view>
      <view class="brand-logo">
        <view class="top-duck-icon">
          <view class="td-head"></view>
          <view class="td-eye"></view>
          <view class="td-beak"></view>
          <view class="td-body"></view>
          <view class="td-wing"></view>
          <view class="td-tail"></view>
        </view>
        <view class="brand-name">编辑资料</view>
      </view>
      <view class="nav-placeholder"></view>
    </view>
  </view>
  <view class="form-content" style="padding-top: {{statusBarHeight + 50}}px;">
    <view class="avatar-section glass-card">
      <button class="avatar-btn-choose" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar-lg" src="{{form.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      </button>
      <view class="avatar-actions">
        <view class="avatar-action-btn tap-shrink" bindtap="onChangeAvatar">自定义上传</view>
        <button class="avatar-action-btn tap-shrink" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">微信头像</button>
      </view>
    </view>
    <view class="form-group glass-card">
      <text class="form-label">昵称</text>
      <view class="nickname-wrap">
        <input class="form-input nickname-input" type="nickname" placeholder="请输入昵称" value="{{form.nickName}}" bindinput="onInput" data-field="nickName" />
        <view class="nick-actions">
          <button class="nick-btn tap-shrink" bindtap="onRandomNick">随机</button>
          <button class="wx-nick-btn tap-shrink" bindtap="onGetWxNick">从微信获取</button>
        </view>
      </view>
    </view>
    <view class="form-group glass-card">
      <text class="form-label">性别</text>
      <view class="tag-select gender-select">
        <text class="tag-chip gender-tag {{form.gender === item.value ? 'active' : ''}}" wx:for="{{genderOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="onGenderTap">{{item.label}}</text>
      </view>
    </view>

    <!-- ===== 联系方式（选填） ===== -->
    <view class="form-section-label"><view class="svg-ico svg-ico-mobile"></view> 联系方式</view>
    <view class="form-section-tip">别人可以通过你填写的联系方式联系到你</view>
    <view class="form-group glass-card inline-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="选填" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
    </view>
    <view class="form-group glass-card inline-group">
      <text class="form-label">微信号</text>
      <input class="form-input" placeholder="选填" value="{{form.wechat_id}}" bindinput="onInput" data-field="wechat_id" />
    </view>
    <view class="form-group glass-card inline-group">
      <text class="form-label">QQ号</text>
      <input class="form-input" type="number" placeholder="选填" value="{{form.qq}}" bindinput="onInput" data-field="qq" />
    </view>
    <view class="form-group glass-card inline-group">
      <text class="form-label">邮箱</text>
      <input class="form-input" type="text" placeholder="选填" value="{{form.email}}" bindinput="onInput" data-field="email" />
    </view>

    <!-- ===== 教育信息（选填） ===== -->
    <view class="form-section-label"><view class="svg-ico svg-ico-graduation"></view> 教育信息</view>
    <view class="form-group glass-card inline-group">
      <text class="form-label">院系</text>
      <input class="form-input" placeholder="选填" value="{{form.department}}" bindinput="onInput" data-field="department" />
    </view>
    <view class="form-group glass-card">
      <text class="form-label">年级</text>
      <view class="grade-select">
        <view class="grade-tag-list">
          <text class="tag-chip grade-tag {{form.grade === item + '级' ? 'active' : ''}}" wx:for="{{gradePreset}}" wx:key="*this" data-value="{{item}}" bindtap="onGradeTagTap">{{item}}级</text>
          <text class="tag-chip grade-tag grade-custom-tag {{gradeCustom ? 'active' : ''}}" bindtap="toggleGradeCustom">自定义</text>
        </view>
        <input class="grade-custom-input" placeholder="输入自定义年级" wx:if="{{gradeCustom}}" value="{{form.grade}}" bindinput="onGradeCustomInput" />
      </view>
    </view>

    <!-- ===== 宿舍住址 ===== -->
    <view class="form-section-label"><view class="svg-ico svg-ico-home"></view> 宿舍住址</view>
    <view class="form-group glass-card dorm-card">
      <!-- 当前显示 -->
      <view class="dorm-current">
        <text class="dorm-current-label">当前宿舍：</text>
        <text class="dorm-current-text" wx:if="{{dormFullText}}">{{dormFullText}}</text>
        <text class="dorm-current-text empty" wx:else>未填写</text>
      </view>

      <!-- 选择/修改按钮 -->
      <view class="dorm-expand-btn tap-shrink {{dormExpanded ? 'active' : ''}}" bindtap="toggleDormExpand">
        <text>{{dormExpanded ? '收起选择' : '选择/修改宿舍'}}</text>
      </view>

      <!-- 选择面板（展开才显示） -->
      <view class="dorm-select-panel" wx:if="{{dormExpanded}}">
        <!-- 社区选择（标签形式） -->
        <view class="dorm-row">
          <text class="dorm-row-label">选择社区</text>
          <view class="dorm-tag-list">
            <text class="dorm-tag {{dormCommunity === item ? 'active' : ''}}" wx:for="{{communityOptions}}" wx:key="*this" data-value="{{item}}" bindtap="onCommunityTagTap">{{item}}</text>
          </view>
        </view>

        <!-- 楼号选择（社区选中后才显示） -->
        <view class="dorm-row" wx:if="{{dormCommunity}}">
          <text class="dorm-row-label">选择楼号</text>
          <view class="dorm-tag-list">
            <text class="dorm-tag {{dormBuilding === item ? 'active' : ''}}" wx:for="{{buildingOptions}}" wx:key="*this" data-value="{{item}}" bindtap="onBuildingTagTap">{{item}}</text>
            <text class="dorm-tag dorm-tag-custom {{dormBuildingCustom ? 'active' : ''}}" bindtap="toggleCustomBuilding">自定义</text>
          </view>
          <!-- 自定义输入 -->
          <input class="dorm-custom-input" placeholder="输入其他楼号" wx:if="{{dormBuildingCustom}}" value="{{form.dormBuilding}}" bindinput="onCustomBuildingInput" />
        </view>

        <!-- 门口选择（楼号选中后才显示，自定义模式也显示） -->
        <view class="dorm-row" wx:if="{{dormBuilding || dormBuildingCustom}}">
          <text class="dorm-row-label">选择门口</text>
          <view class="dorm-tag-list">
            <text class="dorm-tag {{dormGate === item ? 'active' : ''}}" wx:for="{{gateOptions}}" wx:key="*this" data-value="{{item}}" bindtap="onGateTagTap">{{item}}</text>
            <text class="dorm-tag dorm-tag-custom {{dormGateCustom ? 'active' : ''}}" bindtap="toggleCustomGate">自定义</text>
          </view>
          <!-- 自定义输入 -->
          <input class="dorm-custom-input" placeholder="输入其他门口" wx:if="{{dormGateCustom}}" value="{{form.dormGate}}" bindinput="onCustomGateInput" />
        </view>

        <!-- 当前选择结果 -->
        <view class="dorm-result" wx:if="{{dormFullText}}">
          <text class="dorm-result-label">已选：</text>
          <text class="dorm-result-text">{{dormFullText}}</text>
          <view class="dorm-save-btn tap-shrink" bindtap="onSaveDorm">保存</view>
        </view>
      </view>
    </view>

    <!-- ===== 关于我 ===== -->
    <view class="form-section-label"><view class="svg-ico svg-ico-chat"></view> 关于我</view>
    <view class="form-group glass-card">
      <text class="form-label">个性签名</text>
      <textarea class="form-textarea" placeholder="介绍一下自己..." value="{{form.bio}}" bindinput="onInput" data-field="bio" maxlength="100" />
    </view>
    <view class="form-group glass-card">
      <text class="form-label">常用标签</text>
      <view class="tag-select">
        <text class="tag-chip {{_tagSelected[item] ? 'active' : ''}}" hover-class="tag-chip-hover" wx:for="{{availableTags}}" wx:key="*this" data-tag="{{item}}" bindtap="onTagTap">{{item}}</text>
      </view>
    </view>

    <view class="save-btn-wrap">
      <view class="save-btn tap-shrink" bindtap="onSave">保存</view>
    </view>
    <!-- 隐藏的微信昵称选择器 -->
    <input class="wx-nick-picker" type="nickname" focus="{{showWxNickPicker}}" bindblur="onWxNickBlur" bindinput="onWxNickInput" />
  </view>

  <!-- 隐私授权弹窗 -->
  <view class="privacy-mask" wx:if="{{showPrivacy}}">
    <view class="privacy-dialog">
      <view class="privacy-title">隐私保护提示</view>
      <view class="privacy-desc">
        为了完善你的个人资料，需要收集你的头像、昵称等信息。请阅读并同意《用户隐私保护指引》后继续使用。
      </view>
      <view class="privacy-btns">
        <view class="privacy-btn privacy-btn-cancel" bindtap="handleDisagreePrivacy">拒绝</view>
        <button class="privacy-btn privacy-btn-agree" id="agree-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreePrivacy">同意</button>
      </view>
    </view>
  </view>
</view>
