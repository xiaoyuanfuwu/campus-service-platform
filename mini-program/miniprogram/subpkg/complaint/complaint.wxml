<!-- pages/complaint/complaint.wxml -->
<view class="page-complaint">
  <view class="page-bg {{pageBgClass}}" style="{{pageBgStyle}}"></view>
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: 44px;">
    <view class="nav-back" bindtap="goBack"><view class="nav-back-icon"></view></view>
    <text class="nav-title">{{isList ? '我的投诉' : '提交投诉'}}</text>
    <view class="nav-placeholder"></view>
  </view>
  <scroll-view scroll-y class="content" style="padding-top: {{navBarHeight}}px;" wx:if="{{isList}}">
    <view wx:if="{{list.length === 0 && !loading}}" class="empty-state">
      <view class="empty-icon"><text><view class="svg-ico svg-ico-clipboard"></view></text></view>
      <text class="empty-text">暂无投诉记录</text>
    </view>
    <view class="complaint-card glass-card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="viewDetail">
      <view class="card-top">
        <text class="card-title">{{item.title}}</text>
        <text class="status-tag {{item.status}}">{{statusMap[item.status] || item.status}}</text>
      </view>
      <text class="card-meta">类型: {{item.category}} | 对象: {{targetTypeMap[item.targetType] || item.targetType}}</text>
      <text class="card-time">{{item._timeText}}</text>
    </view>
    <view class="loading-more" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text>加载中...</text>
    </view>
    <view class="btn-primary" bindtap="goCreate">提交新投诉</view>
  </scroll-view>

  <view class="form-content" style="padding-top: {{navBarHeight}}px;" wx:else>
    <view class="form-group glass-card">
      <text class="form-label">投诉对象 *</text>
      <picker mode="selector" range="{{targetTypes}}" range-key="label" value="{{targetTypeIndex}}" bindchange="onTargetTypeChange">
        <view class="picker">{{targetTypes[targetTypeIndex].label}}</view>
      </picker>
    </view>
    <view class="form-group glass-card">
      <text class="form-label">对象ID（选填）</text>
      <input class="form-input" placeholder="{{targetIdPlaceholder}}" value="{{targetIdValue}}" bindinput="onTargetIdInput" />
    </view>
    <view class="form-group glass-card">
      <text class="form-label">投诉类型 *</text>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker">{{categories[categoryIndex]}}</view>
      </picker>
    </view>
    <view class="form-group glass-card">
      <text class="form-label">标题 *</text>
      <input class="form-input" placeholder="简要描述问题" value="{{title}}" bindinput="onTitleInput" />
    </view>
    <view class="form-group glass-card">
      <text class="form-label">详细描述 *</text>
      <textarea class="form-textarea" placeholder="请详细描述问题经过..." value="{{content}}" bindinput="onContentInput" maxlength="500" />
    </view>
    <view class="form-group glass-card">
      <text class="form-label">严重程度</text>
      <picker mode="selector" range="{{severities}}" value="{{severityIndex}}" bindchange="onSeverityChange">
        <view class="picker">{{severities[severityIndex]}}</view>
      </picker>
    </view>
    <view class="form-group glass-card">
      <text class="form-label">匿名提交</text>
      <switch checked="{{isAnonymous}}" bindchange="onAnonymousChange" color="var(--primary)" />
    </view>
    <view class="btn-primary" bindtap="onSubmit">提交投诉</view>
  </view>
</view>
